new file mode 100644
index 0000000000000000000000000000000000000000..225cf282cefca13585999451d4a6700a6b7fcd07
--- /dev/null
+++ b/tests/test_repository_policy.py
@@ -0,0 +1,81 @@
+import hashlib
+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+import subprocess
+import sys
+
+SPEC = importlib.util.spec_from_file_location('native_repository_policy', Path(__file__).resolve().parents[1] / 'games/totk/scripts/check_repository.py')
+gate = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(gate)
+
+
+class NativeRepositoryPolicyTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.folder = self.root / 'games/totk/build'
+        self.folder.mkdir(parents=True)
+        self.policy = {'rootEntries': ['games'], 'generatedDirectories': ['games/totk/build'],
+                       'legacyDirectories': ['games/totk/build'], 'legacyArtifacts': {}, 'runtimeStateDirectories': {}}
+        mock = patch.object(gate.subprocess, 'run', return_value=subprocess.CompletedProcess([], 0, b'', b''))
+        mock.start()
+        self.addCleanup(mock.stop)
+
+    def check(self):
+        return gate.check(self.root, self.policy)
+
+    def test_fresh_checkout_without_legacy_outputs(self):
+        self.folder.rmdir()
+        self.assertEqual(self.check(), [])
+
+    def test_retired_generated_root_cannot_be_recreated_empty(self):
+        self.policy['legacyDirectories'] = []
+        self.assertTrue(any('recreated' in e for e in self.check()))
+
+    def test_new_file_and_empty_directory_rejected(self):
+        (self.folder / 'new-output').write_bytes(b'new')
+        (self.folder / 'new-cache').mkdir()
+        self.assertEqual(len(self.check()), 2)
+
+    def test_frozen_legacy_content(self):
+        p = self.folder / 'legacy'
+        p.write_bytes(b'old')
+        self.policy['legacyArtifacts']['games/totk/build/legacy'] = {'sha256': hashlib.sha256(b'old').hexdigest()}
+        self.assertEqual(self.check(), [])
+        p.write_bytes(b'changed')
+        self.assertTrue(any('overwritten' in e for e in self.check()))
+        p.unlink()  # Removing an already migrated legacy item never forces its recreation.
+        self.assertEqual(self.check(), [])
+
+    def test_symlinks_cannot_escape_generated_scope(self):
+        (self.folder / 'external').symlink_to(self.root, target_is_directory=True)
+        self.assertTrue(any('link' in e for e in self.check()))
+
+    def test_only_exact_runtime_state_directory_is_mutable(self):
+        self.policy['runtimeStateDirectories']['games/totk/build/slot'] = 'active lock'
+        slot = self.folder / 'slot'
+        slot.mkdir()
+        (slot / 'history').write_text('live')
+        self.assertEqual(self.check(), [])
+        (self.folder / 'other').write_text('not exempt')
+        self.assertEqual(len(self.check()), 1)
+
+    def test_ignored_user_data_inside_source_is_rejected(self):
+        (self.root / 'games/user.sav').write_bytes(b'fixture')
+        self.assertTrue(any('inside native source' in e for e in self.check()))
+
+    def test_build_stops_at_policy_failure_before_reading_game_inputs(self):
+        sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+        import build_app
+        with patch.object(build_app.subprocess, 'run', return_value=subprocess.CompletedProcess([], 1)):
+            with self.assertRaisesRegex(build_app.BuildError, 'repository policy check failed'):
+                build_app.main(['missing-game.xci', '-k', 'missing.keys', '--work', str(self.root / 'unused')])
+        self.assertFalse((self.root / 'unused').exists())
+
+
+if __name__ == '__main__':
+    unittest.main()
