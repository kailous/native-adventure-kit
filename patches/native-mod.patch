+++ b/games/totk/runtime/pouch_control.h
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Only weapon/bow/shield durability. No inventory API or worn-equipment list. */
+#pragma once
+#include "equipment_defaults.h"
+#define PC_CAPACITY 128
+static const uint32_t pc_life_hash[]={0x8b12d062,0x60589200,0xc3416d19},pc_name_hash[]={0x65efd0be,0x791c4a0b,0x273190f4},pc_effect_hash[]={0xdd846288,0xd59aeed5,0x464b410c},pc_bonus_hash[]={0xfda1d214,0xdfd216f2,0xa6a38304};
+typedef struct {uintptr_t life,effects,bonus,names,fuse_names,extra,record,fuse_life;unsigned slots,count;int32_t lives[PC_CAPACITY],bonuses[PC_CAPACITY],extras[PC_CAPACITY],records[PC_CAPACITY],fuses[PC_CAPACITY];uint32_t types[PC_CAPACITY];char ids[PC_CAPACITY][64],fused[PC_CAPACITY][64];unsigned char raw_names[PC_CAPACITY][80],raw_fused[PC_CAPACITY][80];} PCBag;
+typedef struct {uint64_t identity[PC_CAPACITY];int32_t life[PC_CAPACITY],extra[PC_CAPACITY],fuse[PC_CAPACITY];} PCFrozen;
+static PCFrozen pc_frozen[3];static int pc_modes[3];
+/* Stable field hashes, not array ordering, identify GameData entries. */
+static uintptr_t pc_object(uintptr_t manager,unsigned group,uint32_t hash,size_t stride){
+ uintptr_t header=nc_field(manager,group*0x60+8);uint32_t n=0,entries=0;
+ if(!nc_read(nc_field(header,8),&n,4)||!nc_read(nc_field(header,0x24),&entries,4)||!n||n>16384||entries!=n*2)return 0;
+ uintptr_t map=nc_follow(header,0x18),table=nc_follow(header,0x10);if(!map||!table)return 0;
+ for(unsigned offset=0;offset<entries;offset+=256){
+  uint32_t pairs[256][2];unsigned take=entries-offset<256?entries-offset:256;
+  if(!nc_read(nc_field(map,offset*8),pairs,take*8))return 0;
+  for(unsigned i=0;i<take;i++)if(pairs[i][0]==hash)return pairs[i][1]<n?nc_field(table,pairs[i][1]*stride):0;
+ }
+ return 0;
+}
+static uintptr_t pc_array_limit(uintptr_t manager,unsigned group,uint32_t hash,size_t stride,unsigned limit,unsigned *count){
+ uintptr_t object=pc_object(manager,group,hash,stride);uint64_t total=0;
+ if(!object||!nc_read(nc_field(object,group==17?0x70:0x20),&total,8)||!total||total>limit)return 0;
+ uintptr_t data=nc_follow(object,group==17?0x78:0x28);if(!data)return 0;
+ *count=(unsigned)total;return data;
+}
+static uintptr_t pc_array(uintptr_t manager,unsigned group,uint32_t hash,size_t stride,unsigned *count){return pc_array_limit(manager,group,hash,stride,PC_CAPACITY,count);}
+static bool pc_name(uintptr_t data,unsigned index,const unsigned char raw[80],char out[64]){
+ uintptr_t object=nc_field(data,index*80),pointer=0;uint32_t capacity=0;memcpy(&pointer,raw,8);memcpy(&capacity,raw+8,4);
+ if(pointer!=object+12||capacity!=64||!memchr(raw+12,0,64))return false;
+ memcpy(out,raw+12,64);for(unsigned i=0;out[i];i++)if(!((out[i]>='a'&&out[i]<='z')||(out[i]>='A'&&out[i]<='Z')||(out[i]>='0'&&out[i]<='9')||out[i]=='_'))return false;return true;
+}
+static bool pc_ints(uintptr_t manager,unsigned group,uint32_t hash,size_t stride,unsigned slots,uintptr_t *address,void *out){
+ unsigned n=0;*address=pc_array(manager,group,hash,stride,&n);return *address&&n==slots&&nc_read(*address,out,n*4);
+}
+static bool pc_load(uintptr_t manager,unsigned target,PCBag *b){
+ memset(b,0,sizeof *b);if(target>2)return false;
+ b->life=pc_array(manager,3,pc_life_hash[target],64,&b->slots);if(!b->life||!nc_read(b->life,b->lives,b->slots*4))return false;
+ unsigned n=0;b->names=pc_array(manager,17,pc_name_hash[target],144,&n);if(!b->names||n!=b->slots)return false;
+ if(!pc_ints(manager,7,pc_effect_hash[target],80,b->slots,&b->effects,b->types)||!pc_ints(manager,3,pc_bonus_hash[target],64,b->slots,&b->bonus,b->bonuses))return false;
+ if(target!=1){b->fuse_names=pc_array(manager,17,target==0?0x80707cad:0xc95833d9,144,&n);if(!b->fuse_names||n!=b->slots||!pc_ints(manager,3,target==0?0x6796852b:0x7a20968b,64,b->slots,&b->fuse_life,b->fuses))return false;}
+ if(target==0&&(!pc_ints(manager,3,0x12ffda6b,64,b->slots,&b->extra,b->extras)||!pc_ints(manager,3,0xbf321621,64,b->slots,&b->record,b->records)))return false;
+ if(!nc_read(b->names,b->raw_names,b->slots*80)||(b->fuse_names&&!nc_read(b->fuse_names,b->raw_fused,b->slots*80)))return false;
+ for(unsigned i=0;i<b->slots;i++){
+  if(!pc_name(b->names,i,b->raw_names[i],b->ids[i])||(b->fuse_names&&!pc_name(b->fuse_names,i,b->raw_fused[i],b->fused[i])))return false;
+  if(!b->ids[i][0]){if(b->lives[i]!=-1)return false;continue;}
+  if(strncmp(b->ids[i],"Weapon_",7)||b->lives[i]<0||b->lives[i]>100000||(b->bonuses[i]<0&&!(b->bonuses[i]==-1&&b->types[i]==0xb6eede09))||b->bonuses[i]>2100000000)return false;
+  if(b->extra&&(b->extras[i]<0||b->extras[i]>100000||b->records[i]<-1||b->records[i]>100000))return false;
+  if(b->fuse_life&&(b->fuses[i]<-1||b->fuses[i]>100000))return false;b->count++;
+ }
+ return true;
+}
+static int pc_default(const NativeEquipmentDefault *table,size_t n,const char *name){for(size_t i=0;i<n;i++)if(!strcmp(table[i].name,name))return table[i].value;return -1;}
+static uint64_t pc_hash(uint64_t h,const char *text){for(;*text;text++){h^=(unsigned char)*text;h*=1099511628211ULL;}return h;}
+static bool pc_commit(const PCBag *b,const int32_t *life,const int32_t *extra,const int32_t *fuse,bool record){
+ uintptr_t fields[]={b->life,b->extra,b->fuse_life,record?b->record:0};
+ for(unsigned j=0;j<4;j++)if(fields[j]&&!runtime_guest_writable(fields[j],b->slots*4))return false;
+ for(unsigned i=0;i<b->slots;i++)if(b->ids[i][0]){
+  if((life[i]!=b->lives[i]&&!nc_i32(nc_field(b->life,i*4),life[i]))||(b->extra&&extra[i]!=b->extras[i]&&!nc_i32(nc_field(b->extra,i*4),extra[i]))||(b->fuse_life&&fuse[i]!=b->fuses[i]&&!nc_i32(nc_field(b->fuse_life,i*4),fuse[i]))||(record&&b->record&&b->records[i]!=(b->fused[i][0]?extra[i]:-1)&&!nc_i32(nc_field(b->record,i*4),b->fused[i][0]?extra[i]:-1)))return false;
+ }
+ return true;
+}
+static bool pc_apply(const PCBag *b,unsigned mode){
+ int32_t life[PC_CAPACITY]={0},extra[PC_CAPACITY]={0},fuse[PC_CAPACITY]={0};
+ for(unsigned i=0;i<b->slots;i++)if(b->ids[i][0]){
+  life[i]=1;fuse[i]=b->fuses[i];
+  if(mode==2){
+   life[i]=pc_default(NC_DEFAULT_DURABILITY,sizeof NC_DEFAULT_DURABILITY/sizeof *NC_DEFAULT_DURABILITY,b->ids[i]);if(life[i]<1)return false;
+   if(b->types[i]==0xd5cad39b||b->types[i]==0xb2c943ee){if(b->bonuses[i]>100000-life[i])return false;life[i]+=b->bonuses[i];}
+   if(b->extra&&b->fused[i][0]){extra[i]=pc_default(NC_FUSE_DURABILITY,sizeof NC_FUSE_DURABILITY/sizeof *NC_FUSE_DURABILITY,b->ids[i]);if(extra[i]<0)extra[i]=25;}
+   if(b->fuse_life&&b->fused[i][0]){int value=pc_default(NC_DEFAULT_DURABILITY,sizeof NC_DEFAULT_DURABILITY/sizeof *NC_DEFAULT_DURABILITY,b->fused[i]);if(value>0)fuse[i]=value;}
+  }
+ }
+ return pc_commit(b,life,extra,fuse,mode==2);
+}
+static bool pc_freeze(unsigned target,const PCBag *b){
+ PCFrozen next=pc_frozen[target];
+ for(unsigned i=0;i<b->slots;i++){
+  if(!b->ids[i][0]){next.identity[i]=0;continue;}
+  uint64_t id=pc_hash(pc_hash(1469598103934665603ULL,b->ids[i]),b->fused[i]);id^=((uint64_t)b->types[i]<<32)|(uint32_t)b->bonuses[i];
+  if(next.identity[i]!=id){next.identity[i]=id;next.life[i]=b->lives[i];next.extra[i]=b->extras[i];next.fuse[i]=b->fuses[i];}
+  if(b->lives[i]>next.life[i])next.life[i]=b->lives[i];if(b->extras[i]>next.extra[i])next.extra[i]=b->extras[i];if(b->fuses[i]>next.fuse[i])next.fuse[i]=b->fuses[i];
+ }
+ if(!pc_commit(b,next.life,next.extra,next.fuse,false))return false;pc_frozen[target]=next;return true;
+}
