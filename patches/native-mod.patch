--- /dev/null
+++ b/games/totk/runtime/danmaku_overlay.h
@@ -0,0 +1,97 @@
+/* Passive native-window chat layer. Loopback JSON only; no game-object access.
+   Shared protocol: totk-danmaku/1, bounded to 8192 bytes and four display lanes. */
+#import <AppKit/AppKit.h>
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <math.h>
+#include <string.h>
+
+@interface TOTKDanmakuView : NSView { double _laneReady[4]; }
+@property(nonatomic) int socketFD;
+@property(nonatomic,strong) NSMutableArray<NSMutableDictionary *> *messages;
+@property(nonatomic,strong) NSDictionary *settings;
+@property(nonatomic,strong) NSTimer *timer;
+- (instancetype)initWithFrame:(NSRect)frame port:(int)port;
+- (void)ingest:(NSData *)data now:(double)now;
+- (void)advance:(double)now;
+@end
+
+@implementation TOTKDanmakuView
+/* No hit target or focus: the underlying game input view receives all events. */
+- (NSView *)hitTest:(NSPoint)p { (void)p;return nil; }
+- (BOOL)acceptsFirstResponder { return NO; }
+- (BOOL)isFlipped { return YES; }
+- (BOOL)isOpaque { return NO; }
+- (instancetype)initWithFrame:(NSRect)frame { return [self initWithFrame:frame port:7076]; }
+- (instancetype)initWithFrame:(NSRect)frame port:(int)port {
+ if((self=[super initWithFrame:frame])) {
+  _socketFD=-1;_messages=[NSMutableArray new];_settings=@{};
+  self.autoresizingMask=NSViewWidthSizable|NSViewHeightSizable;
+  if(port>=0){
+   _socketFD=socket(AF_INET,SOCK_DGRAM,0);
+   struct sockaddr_in addr={0};addr.sin_family=AF_INET;addr.sin_addr.s_addr=htonl(INADDR_LOOPBACK);addr.sin_port=htons(port);
+   if(_socketFD>=0&&(bind(_socketFD,(struct sockaddr *)&addr,sizeof(addr))<0||fcntl(_socketFD,F_SETFL,O_NONBLOCK)<0)) {close(_socketFD);_socketFD=-1;}
+  }
+  __weak TOTKDanmakuView *weakSelf=self;
+  _timer=[NSTimer timerWithTimeInterval:1.0/60 repeats:YES block:^(NSTimer *timer){(void)timer;TOTKDanmakuView *v=weakSelf;if(!v)return;double now=NSProcessInfo.processInfo.systemUptime;
+   if(v.socketFD>=0)for(int i=0;i<32;i++){unsigned char bytes[8193];ssize_t n=recv(v.socketFD,bytes,sizeof(bytes),0);if(n<=0)break;if(n<=8192)[v ingest:[NSData dataWithBytes:bytes length:n] now:now];}
+   [v advance:now];
+  }];
+  [NSRunLoop.mainRunLoop addTimer:_timer forMode:NSRunLoopCommonModes];
+ }
+ return self;
+}
+- (void)dealloc { [_timer invalidate];if(_socketFD>=0)close(_socketFD); }
+- (NSDictionary *)attributes {
+ CGFloat size=[_settings[@"fontSize"] doubleValue];
+ NSShadow *shadow=[NSShadow new];shadow.shadowColor=NSColor.blackColor;shadow.shadowBlurRadius=3;shadow.shadowOffset=NSMakeSize(1,-1);
+ return @{NSFontAttributeName:[NSFont boldSystemFontOfSize:size],NSForegroundColorAttributeName:NSColor.whiteColor,NSShadowAttributeName:shadow};
+}
+- (void)ingest:(NSData *)data now:(double)now {
+ if(data.length>8192)return;
+ id packet=[NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+ if(![packet isKindOfClass:NSDictionary.class]||![packet[@"protocol"] isEqual:@"totk-danmaku/1"])return;
+ NSDictionary *s=packet[@"settings"];
+ if(![s isKindOfClass:NSDictionary.class])return;
+ if(![@[@"scroll",@"fade"] containsObject:s[@"mode"]]||![@[@"top",@"middle",@"bottom"] containsObject:s[@"position"]])return;
+ for(NSString *key in @[@"enabled",@"nickname",@"fontSize",@"speed",@"duration"])if(![s[key] isKindOfClass:NSNumber.class])return;
+ double size=[s[@"fontSize"] doubleValue],speed=[s[@"speed"] doubleValue],duration=[s[@"duration"] doubleValue];
+ if(!isfinite(size)||size<12||size>48||!isfinite(speed)||speed<40||speed>320||!isfinite(duration)||duration<2||duration>15)return;
+ if(![_settings isEqual:s]){_settings=[s copy];[_messages removeAllObjects];memset(_laneReady,0,sizeof(_laneReady));self.needsDisplay=YES;}
+ if(![s[@"enabled"] boolValue])return;
+ if(![packet[@"kind"] isEqual:@"chat"])return;
+ NSString *body=packet[@"text"],*user=packet[@"user"];
+ if(![body isKindOfClass:NSString.class]||![user isKindOfClass:NSString.class]||body.length==0||body.length>320||user.length>96)return;
+ body=[[body componentsSeparatedByCharactersInSet:NSCharacterSet.newlineCharacterSet] componentsJoinedByString:@" "];
+ NSString *text=[s[@"nickname"] boolValue]&&user.length?[NSString stringWithFormat:@"%@: %@",user,body]:body;
+ CGFloat line=size*1.5;int lanes=MAX(1,MIN(4,(int)(self.bounds.size.height*.28/line)));
+ int lane=-1;for(int i=0;i<lanes;i++)if(_laneReady[i]<=now){lane=i;break;}
+ if(lane<0||_messages.count>=24)return;
+ double width=[text sizeWithAttributes:[self attributes]].width;
+ BOOL scroll=[s[@"mode"] isEqual:@"scroll"];
+ _laneReady[lane]=now+(scroll?(width+32)/speed:duration);
+ [_messages addObject:[@{@"text":text,@"start":@(now),@"lane":@(lane),@"width":@(width)} mutableCopy]];
+ self.needsDisplay=YES;
+}
+- (void)advance:(double)now {
+ if(!_messages.count)return;
+ BOOL scroll=[_settings[@"mode"] isEqual:@"scroll"];
+ for(NSInteger i=(NSInteger)_messages.count-1;i>=0;i--){NSDictionary *m=_messages[i];double age=now-[m[@"start"] doubleValue];double life=scroll?(self.bounds.size.width+[m[@"width"] doubleValue])/[_settings[@"speed"] doubleValue]:[_settings[@"duration"] doubleValue];if(age>=life||age>30)[_messages removeObjectAtIndex:i];}
+ self.needsDisplay=YES;
+}
+- (void)drawRect:(NSRect)dirty {
+ (void)dirty;if(![_settings[@"enabled"] boolValue])return;
+ double now=NSProcessInfo.processInfo.systemUptime;CGFloat size=[_settings[@"fontSize"] doubleValue],line=size*1.5;
+ CGFloat zone=MIN(self.bounds.size.height*.28,line*4);
+ NSString *pos=_settings[@"position"];
+ CGFloat top=[pos isEqual:@"top"]?12:[pos isEqual:@"middle"]?(self.bounds.size.height-zone)/2:self.bounds.size.height-zone-12;
+ BOOL scroll=[_settings[@"mode"] isEqual:@"scroll"];
+ for(NSDictionary *m in _messages){double age=MAX(0,now-[m[@"start"] doubleValue]);CGFloat x=scroll?self.bounds.size.width-age*[_settings[@"speed"] doubleValue]:MAX(12,(self.bounds.size.width-[m[@"width"] doubleValue])/2);
+  CGFloat y=MAX(0,top)+[m[@"lane"] intValue]*line;
+  NSMutableDictionary *attrs=[[self attributes] mutableCopy];
+  if(!scroll){double remain=[_settings[@"duration"] doubleValue]-age;attrs[NSForegroundColorAttributeName]=[NSColor.whiteColor colorWithAlphaComponent:MAX(0,MIN(1,remain))];}
+  [m[@"text"] drawAtPoint:NSMakePoint(x,y) withAttributes:attrs];
+ }
+}
+@end
