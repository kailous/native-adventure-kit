+            c = Path(tmp) / 'budget.c'
+            c.write_text(source)
+            exe = Path(tmp) / 'budget'
+            subprocess.run(['clang', '-Wall', '-Wextra', '-Werror', '-I', str(ROOT / 'games/totk/runtime'), str(c), '-o', str(exe)], check=True, capture_output=True)
+            subprocess.run([str(exe)], check=True)
