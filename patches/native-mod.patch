+/* Native additions to the game's own options UI. Values live in the selected
+ * profile's native-display.cfg, never in an existing game option/save key. */
+#include <errno.h>
+#include <unistd.h>
+#include "display_enum_v143.h"
+static const char *display_options[]={"NativeRenderResolution","NativePictureMode","NativeInterpolation","NativeShowFPS","NativeShowShaders","NativeShowLoad","NativeAspect","NativeSmoothing","NativeControllerLayout"};
+static const char *display_choices[]={"Native720p","Native1080p","Native1440p","Native2160p","NativeMetalFX","NativeRendering","NativeInterpOff","NativeInterp30","NativeInterpHalf","NativeInterpMax","NativeAspectGame","NativeAspectFit","NativeAspectWide","NativeLayoutCustom","NativeLayoutSwitch","NativeLayoutXbox"};
+static unsigned display_resolution=1,display_quality=1,display_fullscreen;
+static unsigned display_aspect,display_smoothing;
+static unsigned display_interpolation,display_hud[]={1,1,1};
+static uint32_t display_option_hash[10],display_option_alias[10],display_choice_hash[16];
+static int display_field(uint32_t hash){for(unsigned i=0;i<10;i++)if(hash==display_option_hash[i]||hash==display_option_alias[i])return (int)i;return -1;}
+static int display_loaded;
+static uint32_t display_hash(const char *s){
+    uint32_t h=0,k;size_t n=strlen(s),i=0;
+    while(i+4<=n){memcpy(&k,s+i,4);k*=0xcc9e2d51u;k=(k<<15)|(k>>17);k*=0x1b873593u;h^=k;h=(h<<13)|(h>>19);h=h*5+0xe6546b64u;i+=4;}
+    k=0;for(size_t j=0;i+j<n;j++)k|=(uint32_t)(unsigned char)s[i+j]<<(8*j);
+    if(i<n){k*=0xcc9e2d51u;k=(k<<15)|(k>>17);k*=0x1b873593u;h^=k;}
+    h^=(uint32_t)n;h^=h>>16;h*=0x85ebca6bu;h^=h>>13;h*=0xc2b2ae35u;return h^(h>>16);
+}
+static void display_path(char *p,size_t n,const char *suffix){const char *dir=getenv("TOTK_PROFILE_DIR");snprintf(p,n,"%s/native-display.cfg%s",dir?dir:"user-data",suffix);}
+static void display_load(void){
+    if(display_loaded)return;display_loaded=1;
+    for(unsigned i=0;i<10;i++){const char *name=i==6?"IsControlStickUpDownReverse":display_options[i<6?i:i-1];char full[128];snprintf(full,sizeof full,"OptionData.%s",name);display_option_hash[i]=display_hash(name);display_option_alias[i]=display_hash(full);}
+    for(unsigned i=0;i<16;i++)display_choice_hash[i]=display_hash(display_choices[i]);
