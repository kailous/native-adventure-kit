+# Mod support: load additional modules from RomFS if patches.json exists
+mod_loader_code = '''
+/* RomFS mod loader: loads extra modules (e.g. subsdk9) specified in mods/patches.json */
+static int mod_count = 0;
+static Module mod_modules[8]; /* up to 8 additional modules */
+
+static void load_romfs_mods(const char *romfs_dir) {
+    char patch_path[4096];
+    snprintf(patch_path, sizeof(patch_path), "%s/mods/patches.json", romfs_dir);
+    FILE *f = fopen(patch_path, "r");
+    if (!f) return; /* No mods configured */
+    
+    fprintf(stderr, "[totk] loading RomFS mods from %s\\n", patch_path);
+    
+    /* Simple JSON parser for our limited format */
+    char json[65536];
+    size_t len = fread(json, 1, sizeof(json)-1, f);
+    fclose(f);
+    json[len] = '\\0';
+    
+    /* Parse module names from ["name1", "name2", ...] */
+    const char *p = strstr(json, "\\"modules\\"");
+    if (!p) { fprintf(stderr, "[totk] mods: no modules array in patches.json\\n"); return; }
+    p = strchr(p, '[');
+    if (!p) return;
+    
+    while (*p && mod_count < 8) {
+        p++;
+        while (*p == ' ' || *p == '\\n' || *p == '\\t') p++;
+        if (*p == ']') break;
+        if (*p != '"') continue;
+        
+        char name[64];
+        const char *end = strchr(++p, '"');
+        if (!end) break;
+        size_t nlen = end - p;
+        if (nlen >= sizeof(name)) { fprintf(stderr, "[totk] mod name too long\\n"); break; }
+        memcpy(name, p, nlen);
+        name[nlen] = '\\0';
+        
+        /* Load module from RomFS */
+        char mod_path[4096];
+        snprintf(mod_path, sizeof(mod_path), "%s/mods/%s.patched.bin", romfs_dir, name);
+        FILE *mf = fopen(mod_path, "rb");
+        if (!mf) {
+            fprintf(stderr, "[totk] mod %s not found at %s\\n", name, mod_path);
+            p = end + 1;
+            continue;
+        }
+        
+        struct stat st;
+        if (fstat(fileno(mf), &st) != 0 || !S_ISREG(st.st_mode)) {
+            fclose(mf);
+            fprintf(stderr, "[totk] mod %s invalid file\\n", name);
+            p = end + 1;
+            continue;
+        }
+        
+        size_t msize = page_up((size_t)st.st_size);
+        uint8_t *mdata = mmap(NULL, msize, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANON, -1, 0);
+        if (mdata == MAP_FAILED) {
+            fclose(mf);
+            fprintf(stderr, "[totk] mod %s mmap failed\\n", name);
+            p = end + 1;
+            continue;
+        }
+        
+        ssize_t r = fread(mdata, 1, (size_t)st.st_size, mf);
+        fclose(mf);
+        if (r != (ssize_t)st.st_size) {
+            munmap(mdata, msize);
+            fprintf(stderr, "[totk] mod %s read failed\\n", name);
+            p = end + 1;
+            continue;
+        }
+        
+        /* Parse MOD0 header and populate Module structure */
+        unsigned mod0_off = *(unsigned *)(mdata + 4);
+        if (memcmp(mdata + mod0_off, "MOD0", 4) != 0) {
+            munmap(mdata, msize);
+            fprintf(stderr, "[totk] mod %s missing MOD0 header\\n", name);
+            p = end + 1;
+            continue;
+        }
+        
+        Module *mm = &mod_modules[mod_count++];
+        mm->name = strdup(name);
+        mm->base = mdata;
+        mm->file_size = (size_t)st.st_size;
+        mm->size = msize;
+        
+        /* Parse dynamic section for key offsets */
+        int dyn_off = *(int *)(mdata + mod0_off + 4);
+        unsigned long long *dyn = (void *)(mdata + mod0_off + dyn_off);
+        for (int i = 0; dyn[i] != 0 && dyn[i+1] != 0; i += 2) {
+            unsigned tag = (unsigned)(dyn[i] & 0xffffffff);
+            unsigned long long val = dyn[i+1];
+            if (tag == 6) mm->symbols = (Symbol *)(mdata + val);
+        }
+        
+        /* Simplified: assume standard layout for now */
+        mm->text_end = 0x100000; /* placeholder */
+        mm->ro_off = 0x200000;
+        mm->data_off = 0x300000;
+        mm->patch_off = 0x400000;
+        mm->key_off = 0x500000;
+        mm->nsym = 0;
+        mm->nreloc = 0;
+        mm->ngate = 0;
+        
+        fprintf(stderr, "[totk] loaded mod %s at %p size=%zu\\n", name, mdata, msize);
+        
+        p = end + 1;
+    }
+    
+    fprintf(stderr, "[totk] loaded %d mod(s)\\n", mod_count);
+}
+'''
