+++ b/games/totk/runtime/keyboard_map.h
@@ -0,0 +1,81 @@
+/* Native keyboard configuration, macOS physical key codes. Missing rows keep defaults.
+ * action = code[,code...] or none; # comments. Invalid input never partially applies. */
+#ifndef TOTK_KEYBOARD_MAP_H
+#define TOTK_KEYBOARD_MAP_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+enum { KEYBOARD_ACTIONS=25, KEYBOARD_ALIASES=4 };
+typedef struct { unsigned count[KEYBOARD_ACTIONS]; unsigned codes[KEYBOARD_ACTIONS][KEYBOARD_ALIASES]; } KeyboardMap;
+static const char *const keyboard_action_names[KEYBOARD_ACTIONS]={"a","b","x","y","lstick","rstick","l","r","zl","zr","plus","minus","left","up","right","down","move_left","move_right","move_up","move_down","look_left","look_right","look_up","look_down","mouse_toggle"};
+static inline void keyboard_map_default(KeyboardMap *m){
+ memset(m,0,sizeof *m);
+ m->count[0]=1;m->codes[0][0]=38;
+ m->count[1]=2;m->codes[1][0]=40;m->codes[1][1]=49;
+ m->count[2]=1;m->codes[2][0]=34;
+ m->count[3]=1;m->codes[3][0]=32;
+ m->count[4]=1;m->codes[4][0]=6;
+ m->count[5]=1;m->codes[5][0]=8;
+ m->count[6]=1;m->codes[6][0]=12;
+ m->count[7]=1;m->codes[7][0]=14;
+ m->count[8]=1;m->codes[8][0]=58;
+ m->count[9]=1;m->codes[9][0]=56;
+ m->count[10]=1;m->codes[10][0]=36;
+ m->count[11]=2;m->codes[11][0]=48;m->codes[11][1]=53;
+ m->count[12]=1;m->codes[12][0]=3;
+ m->count[13]=1;m->codes[13][0]=17;
+ m->count[14]=1;m->codes[14][0]=4;
+ m->count[15]=1;m->codes[15][0]=5;
+ m->count[16]=1;m->codes[16][0]=0;
+ m->count[17]=1;m->codes[17][0]=2;
+ m->count[18]=1;m->codes[18][0]=13;
+ m->count[19]=1;m->codes[19][0]=1;
+ m->count[20]=1;m->codes[20][0]=123;
+ m->count[21]=1;m->codes[21][0]=124;
+ m->count[22]=1;m->codes[22][0]=126;
+ m->count[23]=1;m->codes[23][0]=125;
+ m->count[24]=1;m->codes[24][0]=26;
+}
+static inline int keyboard_map_parse(const char *text,KeyboardMap *map){
+ KeyboardMap next=*map; unsigned seen=0; int line=0;
+ for(const char *p=text; p&&*p;){
+  line++; const char *end=strchr(p,'\n'); if(!end)end=p+strlen(p);
+  const char *stop=memchr(p,'#',(size_t)(end-p)); if(!stop)stop=end;
+  while(p<stop&&isspace((unsigned char)*p))p++;
+  while(stop>p&&isspace((unsigned char)stop[-1]))stop--;
+  if(p<stop){
+   const char *eq=memchr(p,'=',(size_t)(stop-p)); if(!eq)return line;
+   const char *k=eq;while(k>p&&isspace((unsigned char)k[-1]))k--;
+   int a=-1;for(int i=0;i<KEYBOARD_ACTIONS;i++)if(strlen(keyboard_action_names[i])==(size_t)(k-p)&&!strncmp(p,keyboard_action_names[i],(size_t)(k-p)))a=i;
+   if(a<0||(seen&(1u<<a)))return line;seen|=1u<<a;
+   p=eq+1;while(p<stop&&isspace((unsigned char)*p))p++;
+   if(p==stop)return line;
+   next.count[a]=0;
+   if(stop-p==4&&!strncmp(p,"none",4))p=stop;
+   else while(p<stop){
+    if(!isdigit((unsigned char)*p)||next.count[a]>=KEYBOARD_ALIASES)return line;
+    char *tail;unsigned long code=strtoul(p,&tail,10);if(tail>stop||code>=128)return line;
+    for(unsigned j=0;j<next.count[a];j++)if(next.codes[a][j]==code)return line;
+    next.codes[a][next.count[a]++]=(unsigned)code;p=tail;
+    while(p<stop&&isspace((unsigned char)*p))p++;
+    if(p==stop)break;if(*p++!=',')return line;
+    while(p<stop&&isspace((unsigned char)*p))p++;if(p==stop)return line;
+   }
+   if(p!=stop)return line;
+  }
+  p=*end?end+1:end;
+ }
+ /* One physical key has one action; aliases on the same action are allowed. */
+ for(int a=0;a<KEYBOARD_ACTIONS;a++)for(unsigned i=0;i<next.count[a];i++)
+  for(int b=a+1;b<KEYBOARD_ACTIONS;b++)for(unsigned j=0;j<next.count[b];j++)if(next.codes[a][i]==next.codes[b][j])return line?line:1;
+ *map=next;return 0;
+}
+static inline int keyboard_action_key(const KeyboardMap *m,unsigned a,unsigned code){
+ for(unsigned i=0;i<m->count[a];i++)if(m->codes[a][i]==code)return 1;return 0;
+}
+static inline int keyboard_action_held(const KeyboardMap *m,unsigned a,const unsigned char keys[128]){
+ for(unsigned i=0;i<m->count[a];i++)if(keys[m->codes[a][i]])return 1;return 0;
+}
+#endif
