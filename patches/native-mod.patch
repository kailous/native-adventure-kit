index 0000000000000000000000000000000000000000..f1abc92a0c82097ed9c476e351c80ef504086db0
--- /dev/null
+++ b/games/totk/runtime/map_ui.h
@@ -0,0 +1,71 @@
+/* Read-only UI sampling at the confirmed game-frame producer. */
+#pragma once
+#include "player_state.h"
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+typedef struct {
+    bool available, map_open, cursor_available;
+    char layer;
+    float x, z;
+} RuntimeMapUI;
+
+typedef struct {uintptr_t objects,entries;uint32_t count,capacity;} RuntimeUIRegistry;
+static inline bool runtime_ui_registry(uintptr_t main,RuntimeUIRegistry *out){
+    uintptr_t registry=runtime_player_ptr(main+GAME_UI_REGISTRY_SLOT);
+    int count=0;uint32_t capacity=0;
+    if(!registry||!runtime_player_read(registry+8,&count,4)||count<1||count>2048)return false;
+    uintptr_t table=runtime_player_ptr(registry+0x28);
+    if(!table||!runtime_player_read(table+0x24,&capacity,4)||!capacity||capacity>4096)return false;
+    out->objects=runtime_player_ptr(registry+0x10);out->entries=runtime_player_ptr(table+0x18);
+    out->count=(uint32_t)count;out->capacity=capacity;
+    return out->objects&&out->entries;
+}
+static inline uintptr_t runtime_ui_object(const RuntimeUIRegistry *registry,uint32_t key){
+    uint32_t slot=key%registry->capacity;
+    for(unsigned probe=0;probe<64&&probe<registry->capacity;probe++,slot=(slot+1)%registry->capacity){
+        uint32_t entry[2];
+        if(!runtime_player_read(registry->entries+(uintptr_t)slot*8,entry,8)||!entry[0])return 0;
+        if(entry[0]!=key)continue;
+        if(entry[1]>=registry->count)return 0;
+        return runtime_player_ptr(registry->objects+(uintptr_t)entry[1]*8);
+    }
+    return 0;
+}
+static inline RuntimeMapUI runtime_map_sample(uintptr_t main){
+    RuntimeMapUI out={0};RuntimeUIRegistry registry={0};
+    if(!main||!runtime_ui_registry(main,&registry))return out;
+    uintptr_t screen=runtime_ui_object(&registry,GAME_UI_MAP_HASH);
+    uintptr_t menu=runtime_ui_object(&registry,GAME_UI_PAUSE_BG_HASH);
+    unsigned char raw[GAME_UI_MAP_CURSOR+8],parent[0x178];
+    if(!screen||!menu||!runtime_player_read(screen,raw,sizeof raw)||!runtime_player_read(menu,parent,sizeof parent))return out;
+    uintptr_t vt=0,parent_vt=0;memcpy(&vt,raw,8);memcpy(&parent_vt,parent,8);
+    if(vt!=main+GAME_UI_MAP_VTABLE||parent_vt!=main+GAME_UI_PAUSE_BG_VTABLE||
+       runtime_player_ptr(screen)!=vt||runtime_player_ptr(menu)!=parent_vt)return out;
+    if(raw[GAME_UI_MAP_PHASE]>3||parent[GAME_UI_MAP_PHASE]>3)return out;
+    out.available=true;
+    /* UIMapScreen also renders the gameplay minimap. Its lifecycle and draw
+       flags stay active outside the menu. The verified pause-menu parent must
+       be active too; its draw-enabled byte is deliberately zero on the full
+       map, which supplies its own background. Never treat that as closed. */
+    bool menu_open=parent[GAME_UI_MAP_PHASE]==2&&(int8_t)parent[GAME_UI_MAP_TRANSITION]>=0&&
+        parent[GAME_UI_MAP_HIDDEN]==0&&parent[GAME_UI_MAP_DRAW_STATE]!=2&&
+        (parent[GAME_UI_MAP_DRAW_FLAGS]&0x10)!=0;
+    out.map_open=menu_open&&raw[GAME_UI_MAP_PHASE]==2&&(int8_t)raw[GAME_UI_MAP_TRANSITION]>=0&&
+        raw[GAME_UI_MAP_DRAW_ENABLED]!=0&&raw[GAME_UI_MAP_HIDDEN]==0&&
+        raw[GAME_UI_MAP_DRAW_STATE]!=2&&(raw[GAME_UI_MAP_DRAW_FLAGS]&0x10)!=0;
+    if(getenv("TOTK_MAP_UI_TRACE")){
+        static unsigned previous=~0u;
+        unsigned state=raw[GAME_UI_MAP_PHASE]|(parent[GAME_UI_MAP_PHASE]<<4)|
+            (parent[GAME_UI_MAP_DRAW_STATE]<<8)|(out.map_open?0x1000:0);
+        if(state!=previous){previous=state;fprintf(stderr,"[map-ui] mapPhase=%u menuPhase=%u menuDrawState=%u mapOpen=%u\n",
+            raw[GAME_UI_MAP_PHASE],parent[GAME_UI_MAP_PHASE],parent[GAME_UI_MAP_DRAW_STATE],out.map_open);}
+    }
+    if(!out.map_open)return out;
+    uint32_t layer=0;float xy[2];
+    memcpy(&layer,raw+GAME_UI_MAP_LAYER,4);memcpy(xy,raw+GAME_UI_MAP_CURSOR,8);
+    if(layer>2||!isfinite(xy[0])||!isfinite(xy[1])||fabsf(xy[0])>8000||fabsf(xy[1])>8000)return out;
+    out.cursor_available=true;out.layer="ksd"[layer];out.x=xy[0];out.z=-xy[1];
+    return out;
+}
