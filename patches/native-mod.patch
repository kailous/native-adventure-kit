+ runtime_motion_mouse(0);feed(1,0.1,0.2,-0.9,0,0,0);probe_now+=1000000;sstates(&n,buf.s,1,&six);
+ need(buf.s[0].attr==1&&near3(buf.s[0].acc,-0.1,0.2,0.9,1e-6),"mouse mode off: the controller's samples again, remapped");
