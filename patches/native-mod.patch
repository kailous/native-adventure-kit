+static void capture(TOTKBootLoadingView *view,NSURL *output,NSString *name){
+    [view displayIfNeeded];NSBitmapImageRep *bitmap=[view bitmapImageRepForCachingDisplayInRect:view.bounds];assert(bitmap);
+    [view cacheDisplayInRect:view.bounds toBitmapImageRep:bitmap];
+    NSData *data=[bitmap representationUsingType:NSBitmapImageFileTypePNG properties:@{}];assert(data.length);
+    assert([data writeToURL:[output URLByAppendingPathComponent:name] atomically:YES]);
+}
+int main(int argc,char **argv){@autoreleasepool{
+    assert(argc==3||argc==4);
+    [NSApplication sharedApplication];
+    NSURL *assets=!strcmp(argv[1],"-")?boot_loading_asset_directory():[NSURL fileURLWithPath:@(argv[1]) isDirectory:YES];
+    NSString *cwd=NSFileManager.defaultManager.currentDirectoryPath;
+    NSURL *game=assets;for(int i=0;i<3;i++)game=game.URLByDeletingLastPathComponent;
+    assert([NSFileManager.defaultManager changeCurrentDirectoryPath:game.path]);
+    assert([boot_loading_asset_directory().URLByStandardizingPath.path isEqualToString:assets.URLByStandardizingPath.path]);
+    assert([NSFileManager.defaultManager changeCurrentDirectoryPath:cwd]);
+    NSURL *out=[NSURL fileURLWithPath:@(argv[2]) isDirectory:YES];
+    assert([NSFileManager.defaultManager createDirectoryAtURL:out withIntermediateDirectories:YES attributes:nil error:nil]);
+    NSWindow *window=[[NSWindow alloc] initWithContentRect:NSMakeRect(0,0,1920,1080) styleMask:NSWindowStyleMaskBorderless backing:NSBackingStoreBuffered defer:YES];
+    window.releasedWhenClosed=NO;
+    TOTKBootLoadingView *view=[[TOTKBootLoadingView alloc] initWithFrame:NSMakeRect(0,0,1920,1080) assetDirectory:assets];window.contentView=view;
+    assert(view.assetsReady);assert(!view.determinate&&[view.percentageText isEqualToString:@"…"]);
+    [view showStage:@"数据验证中" done:7 total:10 bytes:NO];assert(view.determinate&&[view.percentageText isEqualToString:@"70%"]);
+    assert([view.detail.string containsString:@"7 / 10"]);
+    [view showStage:@"校验游戏资源" done:400000000 total:1000000000 bytes:YES];assert([view.percentageText isEqualToString:@"40%"]&&[view.detail.string containsString:@"0.4 / 1.0 GB"]);
+    [view showStage:@"校验游戏资源" done:100 total:0 bytes:YES];assert(!view.determinate&&[view.percentageText isEqualToString:@"…"]);
+    [view showStage:@"数据验证中" done:318100 total:652550 bytes:NO];
+    assert(view.fraction>0.48&&view.fraction<0.49);
+    BOOL screenshots=argc==4;
+    if(screenshots)capture(view,out,@"reference-1920.png");
+    [view showStage:@"加载着色器缓存" done:25255 total:33229 bytes:NO];assert([view.percentageText isEqualToString:@"76%"]);
+    if(screenshots)capture(view,out,@"shaders-1920.png");
+    [view showStatus:@"初始化图形" detail:@"正在准备渲染环境，请稍候"];
+    assert(!view.determinate&&view.fraction==0&&[view.percentageText isEqualToString:@"…"]);
+    if(screenshots)capture(view,out,@"initializing-1920.png");
+    [view showWarmDone:7 total:10 shaders:4 shaderTotal:5 pipelines:3 pipelineTotal:5];
+    assert([view.percentageText isEqualToString:@"70%"]&&[view.detail.string containsString:@"4/5"]);
+    [view showWarmDone:0 total:0 shaders:0 shaderTotal:0 pipelines:0 pipelineTotal:0];assert(!view.determinate);
+    [view showStage:@"数据验证中" done:318100 total:652550 bytes:NO];
+    for(NSValue *size in @[[NSValue valueWithSize:NSMakeSize(1280,720)],[NSValue valueWithSize:NSMakeSize(512,288)],[NSValue valueWithSize:NSMakeSize(2560,1080)]]){
+        NSSize bounds=size.sizeValue;[window setContentSize:bounds];view.frame=NSMakeRect(0,0,bounds.width,bounds.height);
+        if(screenshots)capture(view,out,[NSString stringWithFormat:@"reference-%.0fx%.0f.png",bounds.width,bounds.height]);
+    }
+    [view showStage:@"测试" done:20 total:10 bytes:NO];assert([view.percentageText isEqualToString:@"100%"]);
+    [view setHidden:YES];assert(view.hidden);
+    NSFont *body=[view valueForKey:@"body"],*brand=[view valueForKey:@"brandMedium"];
+    NSMutableArray *candidates=[NSMutableArray new];for(NSString *name in NSFontManager.sharedFontManager.availableFonts)if([name.lowercaseString containsString:@"oppo"]||[name.lowercaseString containsString:@"axiforma"])[candidates addObject:name];
+    NSDictionary *result=@{@"status":@"pass",@"scope":@"assets, real progress, units, unknown totals, warmup, completion and responsive geometry",@"assetDirectory":assets.path,@"bundleResourceDirectory":NSBundle.mainBundle.resourceURL.path,@"bodyFont":body.fontName,@"brandFont":brand.fontName,@"availableDesignFonts":candidates,@"screenshots":@(screenshots)};
+    NSData *json=[NSJSONSerialization dataWithJSONObject:result options:0 error:nil];puts([[NSString alloc] initWithData:json encoding:NSUTF8StringEncoding].UTF8String);
+}}
diff --git a/games/totk/scripts/probes/emit_native_call_fixture.py b/games/totk/scripts/probes/emit_native_call_fixture.py
