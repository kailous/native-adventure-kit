diff --git a/games/totk/runtime/input_observer.h b/games/totk/runtime/input_observer.h
new file mode 100644
index 0000000000000000000000000000000000000000..60155649c7fd8b2e56db2db1507e2a569a5a6a98
--- /dev/null
+++ b/games/totk/runtime/input_observer.h
@@ -0,0 +1,42 @@
+/* Bounded, game-only input observation. Host input values, never guest pointers. */
+#ifndef TOTK_INPUT_OBSERVER_H
+#define TOTK_INPUT_OBSERVER_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <pthread.h>
+enum { IO_KEYBOARD, IO_MOUSE, IO_CONTROLLER, IO_AGENT, IO_SYNTHETIC, IO_SOURCES, IO_HISTORY=128 };
+typedef struct { uint64_t seq,ns,buttons,pressed,released;int32_t x,y,rx,ry;unsigned source; } InputEvent;
+typedef struct { pthread_mutex_t lock;InputEvent state[IO_SOURCES],events[IO_HISTORY];uint64_t sequence,last_user; } InputObserver;
+#define INPUT_OBSERVER_INIT {.lock=PTHREAD_MUTEX_INITIALIZER}
+static const char *const io_names[]={"keyboard","mouse","controller","agent","synthetic-keyboard"};
+static inline void io_update(InputObserver *o,unsigned source,uint64_t buttons,int32_t x,int32_t y,int32_t rx,int32_t ry,uint64_t now){
+ if(source>=IO_SOURCES)return;
+ pthread_mutex_lock(&o->lock);InputEvent *old=&o->state[source];
+ if(old->buttons!=buttons||old->x!=x||old->y!=y||old->rx!=rx||old->ry!=ry){
+  InputEvent e={.seq=++o->sequence,.ns=now,.buttons=buttons,.pressed=buttons&~old->buttons,.released=old->buttons&~buttons,.x=x,.y=y,.rx=rx,.ry=ry,.source=source};
+  o->events[(e.seq-1)%IO_HISTORY]=e;*old=e;
+ }
+ pthread_mutex_unlock(&o->lock);
+}
+static inline void io_user(InputObserver *o,uint64_t now){pthread_mutex_lock(&o->lock);o->last_user=now;pthread_mutex_unlock(&o->lock);}
+static inline size_t io_json(InputObserver *o,char *buf,size_t cap,uint64_t now){
+ InputEvent states[IO_SOURCES],events[IO_HISTORY];uint64_t seq,last;
+ pthread_mutex_lock(&o->lock);memcpy(states,o->state,sizeof states);memcpy(events,o->events,sizeof events);seq=o->sequence;last=o->last_user;pthread_mutex_unlock(&o->lock);
+ for(unsigned i=0;i<IO_SOURCES;i++)if(states[i].ns>now)now=states[i].ns;
+ if(last>now)now=last;
+ size_t n=0;
+#define IO_PRINT(...) do{int z=snprintf(n<cap?buf+n:NULL,n<cap?cap-n:0,__VA_ARGS__);if(z<0)return 0;n+=(size_t)z;}while(0)
+ IO_PRINT("{\"available\":true,\"clock\":\"host-monotonic\",\"historyCapacity\":128,\"sampledAt\":%.6f,\"sequence\":%llu,\"oldestSequence\":%llu,\"lastUserAt\":%.6f,\"sources\":[",now/1e9,(unsigned long long)seq,(unsigned long long)(seq>IO_HISTORY?seq-IO_HISTORY+1:seq?1:0),last/1e9);
+ for(unsigned i=0;i<IO_SOURCES;i++){InputEvent *e=&states[i];IO_PRINT("%s{\"source\":\"%s\",\"buttons\":%llu,\"axes\":[%d,%d,%d,%d],\"changedAt\":%.6f}",i?",":"",io_names[i],(unsigned long long)e->buttons,e->x,e->y,e->rx,e->ry,e->ns/1e9);}
+ IO_PRINT("],\"events\":[");uint64_t first=seq>IO_HISTORY?seq-IO_HISTORY+1:1;
+ for(uint64_t k=first;k<=seq;k++){InputEvent *e=&events[(k-1)%IO_HISTORY];IO_PRINT("%s{\"sequence\":%llu,\"at\":%.6f,\"source\":\"%s\",\"buttons\":%llu,\"pressed\":%llu,\"released\":%llu,\"axes\":[%d,%d,%d,%d]}",k==first?"":",",(unsigned long long)k,e->ns/1e9,io_names[e->source],(unsigned long long)e->buttons,(unsigned long long)e->pressed,(unsigned long long)e->released,e->x,e->y,e->rx,e->ry);}
+ IO_PRINT("]}");
+#undef IO_PRINT
+ return n<cap?n:0;
+}
+/* Runtime exports, implemented in input.c; host probes supply explicit doubles. */
+extern void runtime_observe_input(unsigned,uint64_t,int32_t,int32_t,int32_t,int32_t);
+extern size_t runtime_observe_json(char *,size_t,uint64_t);
+#endif
