+"""Exercise real read-only UI traversal and telemetry JSON with a fake registry."""
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class MapUI(unittest.TestCase):
+    def test_game_frame_snapshot_lifecycle(self):
+        with tempfile.TemporaryDirectory() as directory:
+            binary = Path(directory) / 'telemetry-frame'
+            subprocess.run(['xcrun', 'clang', '-std=c11', '-O1', '-Wall', '-Wextra', '-Werror',
+                            '-I' + str(ROOT / 'games/totk/third_party/d2r_gfx/gfx/nvn/include'),
+                            str(ROOT / 'games/totk/tests/telemetry_test.c'), '-o', str(binary)], check=True)
+            run = subprocess.run([str(binary)], capture_output=True, text=True, timeout=5)
+            self.assertEqual(run.returncode, 0, run.stderr)
+            active, closed, stale = [json.loads(line) for line in run.stdout.splitlines()]
+            self.assertEqual(active['ui']['mapCursor'], dict(x=-1234, z=-678))
+            self.assertEqual(closed['position'][0], 500)
+            self.assertFalse(closed['ui']['mapOpen'])
+            self.assertIsNone(closed['ui']['mapCursor'])
+            self.assertFalse(stale['connected'])
+
+    def test_registry_layers_lifecycle_and_invalid_memory(self):
+        with tempfile.TemporaryDirectory() as directory:
+            binary = Path(directory) / 'map-ui'
+            subprocess.run(['xcrun', 'clang', '-std=c11', '-O1', '-Wall', '-Wextra', '-Werror',
+                            '-Wno-unused-function', '-Wl,-dead_strip',
+                            '-I' + str(ROOT / 'games/totk/third_party/d2r_gfx/gfx/nvn/include'),
+                            str(ROOT / 'tests/map_ui_probe.c'), '-o', str(binary)], check=True)
+            run = subprocess.run([str(binary)], capture_output=True, text=True, timeout=5)
+            self.assertEqual(run.returncode, 0, run.stderr)
+            packets = [json.loads(line) for line in run.stdout.splitlines()]
+            self.assertEqual(len(packets), 11)
+            for packet, layer in zip(packets[:3], 'ksd'):
+                self.assertEqual(packet['position'], [123, 246.5, 456])
+                self.assertEqual(packet['ui'], dict(available=True, mode='map', mapOpen=True,
+                                                  mapLayer=layer, mapCursor=dict(x=-1234.5, z=-678.25)))
+            self.assertFalse(packets[3]['ui']['mapOpen'])
+            self.assertIsNone(packets[3]['ui']['mapCursor'])
+            for closed in packets[4:9]:
+                self.assertFalse(closed['ui']['mapOpen'])
+                self.assertIsNone(closed['ui']['mapCursor'])
+                self.assertEqual(closed['position'], [123, 246.5, 456])
+            self.assertTrue(packets[9]['ui']['mapOpen'])
+            self.assertIsNone(packets[9]['ui']['mapCursor'])
+            self.assertFalse(packets[10]['ui']['available'])
