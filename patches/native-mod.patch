+/* Versioned control layouts. 1.4.3 read fields were cross-checked against
+   Player component identity, typed field hashes and a copied save. Spawn has
+   a separate ABI gate: a matching entry prologue is not ABI evidence. */
+#pragma once
+#define CONTROL_LAYOUT_SUPPORTED 1
+#define CONTROL_SPAWN_ABI_SUPPORTED 1
+#define CONTROL_PRE_ACTOR_ACTOR 0x20u
+#define CONTROL_CAMERA_SUPPORTED 1
+#define CONTROL_CAMERA_METHOD 0x569bbcu
+#define CONTROL_READ_SUPPORTED 1
+#define CONTROL_STAMINA_VALUE 0x13ecu
+#define CONTROL_STAMINA_INTERNAL 0x1404u
+#define CONTROL_PROBE_AVAILABLE 1
+#define CONTROL_WEATHER_SUPPORTED 1
+#define CONTROL_WEATHER_SLOT 0x3a83968u
+#define CONTROL_WEATHER_ENTRY 0x21d0798u
+#define CONTROL_COMPONENT_SLOT 0x3a64648u
+#define CONTROL_DATA_SLOT 0x3ad66b0u
+#define CONTROL_ACTOR_MGR_SLOT 0x3ad7450u
+#define CONTROL_SPAWN_ENTRY 0x599670u
+/* The intermediate scene module gained one pointer before the root link. */
+#define CONTROL_ROOT_OFFSET 0x228u
