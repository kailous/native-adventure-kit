diff --git a/games/totk/runtime/spawn_control.h b/games/totk/runtime/spawn_control.h
new file mode 100644
index 0000000000000000000000000000000000000000..343ccac82926d4486b7c2f5f7c1afaa770d056fd
--- /dev/null
+++ b/games/totk/runtime/spawn_control.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Minimal C ABI for Lotuskit 59dcfcc engineActor.hpp/bbBlackboard.hpp.
+   Sizes/offsets independently compiled with the pinned Switch SDK; see outer
+   build/native-alignment/abi.json. Called only by the game frame dispatcher. */
+#pragma once
+#include "control_version.h"
+#include "spawn_catalog.h"
+typedef struct {const char *text;} NSSafeString;
+typedef struct {uint32_t type,pad;char *key;int32_t capacity;char text[128];uint32_t align;unsigned char value[48];} NSParam;
+typedef struct {int32_t size,pad;NSParam *params;int32_t count,pad2;NSParam buffer[32];} NSBlackboard;
+typedef struct {float position[3],rotation[9],scale[3];uint32_t pad;NSSafeString empty;unsigned char unknown[16];NSBlackboard *blackboard;void *extra,*parent,*dependent,*creator,*rtti,*heap;uint8_t flags,padding[7];} NSCreateArg;
+_Static_assert(sizeof(NSSafeString)==8,"SafeString ABI");
+_Static_assert(sizeof(NSParam)==0xc8&&offsetof(NSParam,value)==0x98,"Param ABI");
+_Static_assert(sizeof(NSBlackboard)==0x1918&&offsetof(NSBlackboard,buffer)==0x18,"InitInfo ABI");
+_Static_assert(sizeof(NSCreateArg)==0x98&&offsetof(NSCreateArg,blackboard)==0x58&&offsetof(NSCreateArg,flags)==0x90,"CreateArg ABI");
+typedef bool (*NSCreate)(void *,const NSSafeString *,const NSCreateArg *,void *,uint32_t,void *,void *,void *,bool,uint32_t *,uintptr_t *);
+static uintptr_t ns_pre_actor;static uint64_t ns_tick;static int ns_id=-1,ns_result=-1;static bool ns_accepted,ns_created;static float ns_position[3];
+#ifdef NATIVE_CONTROL_TEST
+static NSCreate ns_test_create;
+#endif
+static NSCreate ns_entry(uintptr_t main){
+#ifdef NATIVE_CONTROL_TEST
+ if(ns_test_create)return ns_test_create;
+#endif
+ const uint32_t expected[]={0xa9ba7bfd,0xa9016ffc,0x910003fd,0xa90267fa};uint32_t actual[4];
+ if(!CONTROL_SPAWN_ABI_SUPPORTED||!nc_read(nc_field(main,CONTROL_SPAWN_ENTRY),actual,sizeof actual)||memcmp(actual,expected,sizeof actual))return NULL;
+ return (NSCreate)nc_field(main,CONTROL_SPAWN_ENTRY);
+}
+static bool ns_available(uintptr_t main,bool has_hp){if(!CONTROL_SPAWN_ABI_SUPPORTED)return false;uintptr_t manager=nc_follow(main,CONTROL_ACTOR_MGR_SLOT);uint64_t slot=0;return has_hp&&ns_entry(main)&&runtime_guest_writable(manager,8)&&nc_read(nc_ptr(manager),&slot,8);}
+static void ns_observe(bool ready,uint64_t now){
+#if CONTROL_SPAWN_ABI_SUPPORTED
+ if(!ready){ns_pre_actor=0;ns_id=-1;ns_result=-1;ns_accepted=ns_created=false;return;}
+ if(!ns_pre_actor||ns_created)return;
+ if(now<ns_tick||now-ns_tick>10000000000ULL){ns_pre_actor=0;return;}
+ uintptr_t actor=nc_follow(ns_pre_actor,CONTROL_PRE_ACTOR_ACTOR),name=nc_follow(actor,GAME_ACTOR_NAME);char text[128];float position[3];
+ if(ns_id<0||(unsigned)ns_id>=NC_SPAWN_COUNT)return;
+ size_t len=strlen(NC_SPAWN_NAMES[ns_id])+1;
+ if(len>sizeof text||!nc_read(name,text,len)||memcmp(text,NC_SPAWN_NAMES[ns_id],len)||!nc_read(nc_field(actor,GAME_ACTOR_POS),position,sizeof position))return;
+ for(unsigned i=0;i<3;i++)if(!isfinite(position[i])||fabsf(position[i])>20000)return;
+ memcpy(ns_position,position,sizeof position);ns_created=true;ns_pre_actor=0;
+#else
+ (void)ready;(void)now;
+#endif
+}
+static int ns_spawn(uintptr_t main,bool ready,unsigned target,unsigned mode,double value,uint64_t now){
+ if(target||mode||!isfinite(value)||value<0||value>=NC_SPAWN_COUNT||floor(value)!=value)return 2;
+ RuntimePlayerState player;if(!ns_available(main,ready)||!runtime_player_sample(main,&player))return 1;
+ if(ns_tick&&now>=ns_tick&&now-ns_tick<1000000000ULL)return 7;
+ float fx=player.rotation[2],fz=player.rotation[8],length=hypotf(fx,fz);
+ if(!isfinite(length)||length<.5f||length>1.1f)return 1;
+ NSBlackboard info={.size=32};info.params=info.buffer;
+ for(unsigned i=0;i<32;i++){info.buffer[i].key=info.buffer[i].text;info.buffer[i].capacity=128;}
+ NSCreateArg arg={.rotation={1,0,0,0,1,0,0,0,1},.scale={1,1,1},.empty={""},.blackboard=&info,.flags=7};
+ arg.position[0]=player.position[0]+2.5f*fx/length;arg.position[1]=player.position[1]+1.25f;arg.position[2]=player.position[2]+2.5f*fz/length;
+ NSSafeString name={NC_SPAWN_NAMES[(int)value]};uint32_t result=0;
+ ns_pre_actor=0;ns_created=false;ns_id=(int)value;memcpy(ns_position,arg.position,sizeof ns_position);
+ NSCreate create=ns_entry(main);if(!create)return 1;
+ ns_accepted=create((void *)nc_follow(main,CONTROL_ACTOR_MGR_SLOT),&name,&arg,NULL,1,NULL,NULL,NULL,false,&result,&ns_pre_actor);
+ ns_result=result<=8?(int)result:-1;ns_tick=now;return ns_accepted?0:8;
+}
diff --git a/games/totk/runtime/telemetry.c b/games/totk/runtime/telemetry.c
new file mode 100644
index 0000000000000000000000000000000000000000..87a75d8d01a41bab96fc234918c861f2fe84f4a3
--- /dev/null
+++ b/games/totk/runtime/telemetry.c
@@ -0,0 +1,173 @@
+/* Game-frame player snapshots. Camera discovery alone uses bounded read-only
+   copies on the worker; all mutations remain on the game frame thread. */
+#include "telemetry.h"
+#include "input_observer.h"
+#include "player_state.h"
+#include "native_control.h"
+#include "control_version.h"
+#include "camera_probe.h"
+#include <stdio.h>
+#include <stdbool.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <fcntl.h>
+#include <time.h>
+
+#ifndef TEL_PORT
+#define TEL_PORT 7074
+#endif
+#define TEL_INTERVAL_NS 100000000ULL
+#define TEL_STALE_NS 500000000ULL
+
+static uintptr_t main_base;
+static pthread_t tel_thread;
+_Atomic int telemetry_active;
+static int tel_socket=-1;
+static char tel_session[64];
+static pthread_mutex_t snapshot_lock=PTHREAD_MUTEX_INITIALIZER;
+typedef struct {
+ float position[3],rotation[9];
+ uint64_t tick;
+ bool available;
+} Snapshot;
+static Snapshot latest;
+
+/* Called only at the game's actual frame-end fence. Sampling is bounded to
+   10 Hz and publication never blocks the game thread on the network worker. */
+void telemetry_frame_tick(uint64_t frame) {
+ (void)frame;
+ static uint64_t last_sample;
+ static _Thread_local bool in_tick;
+ if(!atomic_load_explicit(&telemetry_active,memory_order_relaxed) || in_tick) return;
+ uint64_t now=runtime_now_ns();
+ runtime_control_frame(now);
+ if(last_sample && now-last_sample<TEL_INTERVAL_NS) return;
+ in_tick=true;
+ RuntimePlayerState player;
+ Snapshot snap={.tick=now};
+ snap.available=runtime_player_sample(main_base,&player);
+ if(snap.available) {
+  memcpy(snap.position,player.position,sizeof snap.position);
+  memcpy(snap.rotation,player.rotation,sizeof snap.rotation);
+ }
+ if(pthread_mutex_trylock(&snapshot_lock)==0) {
+  latest=snap;
+  pthread_mutex_unlock(&snapshot_lock);
+  last_sample=now;
+ }
+ in_tick=false;
+}
+
+static Snapshot current_snapshot(uint64_t now) {
+ pthread_mutex_lock(&snapshot_lock);
+ Snapshot snap=latest;
+ pthread_mutex_unlock(&snapshot_lock);
+ if(!snap.tick || now<snap.tick || now-snap.tick>TEL_STALE_NS) {
+  memset(&snap,0,sizeof snap);
+  snap.tick=now;
+ }
+ return snap;
+}
+
+static int build_packet(const Snapshot *snap, uint64_t sequence,
+                        char *buf, size_t cap) {
+ if(!snap->available) return snprintf(buf,cap,
+  "{\"protocol\":\"totk-telemetry/1\",\"gameVersion\":\"%s\","
+  "\"session\":\"%s\",\"sequence\":%llu,\"connected\":false,"
+  "\"timestamp\":%.6f,\"clock\":\"host-monotonic\","
+  "\"position\":null,\"rotation\":null,\"player\":{\"available\":false},\"runtime\":\"native\",\"adapterSupported\":%s}",
+  TOTK_GAME_VERSION,tel_session,(unsigned long long)sequence,(double)snap->tick/1e9,
+  "true"
+ );
+ NativeCameraSample camera=ncam_capture(snap->position);char camera_json[512];
+ if(camera.available)snprintf(camera_json,sizeof camera_json,"{\"available\":true,\"x\":%.7f,\"z\":%.7f,\"basisVerified\":true,\"source\":\"game-camera-readonly\"}",camera.x,camera.z);
+ else snprintf(camera_json,sizeof camera_json,"{\"available\":false,\"discovery\":\"%s\",\"vtable\":%d,\"scan\":%d}",!CONTROL_CAMERA_SUPPORTED?"unsupported":ncam_vtable?"object":"vtable",ncam_vtable?1:0,ncam_ro_complete?1:0);
+ const float *p=snap->position;
+ const float *r=snap->rotation;
+
+ /* Forward vector = rotation matrix column 2 (local +Z → world). */
+ float fx=r[2], fy=r[5], fz=r[8];
+ double yaw=atan2((double)fx,(double)(-fz))*180.0/3.14159265358979323846;
+ if(yaw<0) yaw+=360.0;
+
+ double ts=(double)snap->tick/1000000000.0;
+
+ return snprintf(buf,cap,
+  "{\"protocol\":\"totk-telemetry/1\","
+  "\"gameVersion\":\"%s\","
+  "\"session\":\"%s\","
+  "\"sequence\":%llu,"
+  "\"connected\":true,"
+  "\"timestamp\":%.6f,"
+  "\"clock\":\"host-monotonic\","
+  "\"position\":[%.6f,%.6f,%.6f],"
+  "\"rotation\":[%.7f,%.7f,%.7f,%.7f,%.7f,%.7f,%.7f,%.7f,%.7f],"
+  "\"player\":{\"available\":true,"
+   "\"position\":{\"x\":%.6f,\"y\":%.6f,\"z\":%.6f},"
+   "\"yawAvailable\":false,"
+   "\"yaw\":null,"
+   "\"yawCandidate\":%.4f,"
+   "\"forward\":{\"x\":%.7f,\"y\":%.7f,\"z\":%.7f}"
+  "},"
+  "\"ui\":{\"available\":false,\"mode\":\"unknown\",\"mapOpen\":null,\"mapLayer\":null,\"mapCursor\":null},"
+  "\"camera\":%s"
+  "}",
+  TOTK_GAME_VERSION,tel_session,
+  (unsigned long long)sequence,
+  ts,
+  p[0],p[1],p[2],
+  r[0],r[1],r[2],r[3],r[4],r[5],r[6],r[7],r[8],
+  p[0],p[1],p[2],
+  yaw,fx,fy,fz,camera_json);
+}
+
+/* The socket is nonblocking; late ticks are dropped instead of queued. */
+static void *tel_worker(void *arg) {
+ (void)arg;
+ struct sockaddr_in dst={.sin_family=AF_INET,.sin_port=htons(TEL_PORT)};
+ dst.sin_addr.s_addr=htonl(INADDR_LOOPBACK);
+ uint64_t sequence=0;
+ while(atomic_load_explicit(&telemetry_active,memory_order_acquire)) {
+  runtime_control_network();
+  Snapshot snap=current_snapshot(runtime_now_ns());
+  char buf[49152],inputs[46000];
+  int len=build_packet(&snap,sequence++,buf,sizeof buf);
+  size_t in=runtime_observe_json(inputs,sizeof inputs,runtime_now_ns());
+  if(in&&len>0&&(size_t)len+in+12<sizeof buf){len--;len+=snprintf(buf+len,sizeof buf-(size_t)len,",\"inputs\":%s}",inputs);}
+  if(len>0 && (size_t)len<sizeof buf)
+   sendto(tel_socket,buf,(size_t)len,0,(struct sockaddr *)&dst,sizeof dst);
+  struct timespec delay={.tv_sec=0,.tv_nsec=TEL_INTERVAL_NS};
+  nanosleep(&delay,NULL);
+ }
+ return NULL;
+}
+
+void telemetry_init(void) {
+ main_base=(uintptr_t)runtime_module_base("main");
+ runtime_control_init(main_base);
+ ncam_module=runtime_module_info("main");
+ if(!main_base) return;
+ snprintf(tel_session,sizeof tel_session,"mac-native-%ld-%llx",(long)getpid(),
+          (unsigned long long)runtime_now_ns());
+ fprintf(stderr,"[totk-telemetry] init: version=%s, version-selected adapter\n",TOTK_GAME_VERSION);
+}
+
+void telemetry_start(void) {
+ if(!main_base || atomic_load(&telemetry_active)) return;
+ tel_socket=socket(AF_INET,SOCK_DGRAM,0);
+ if(tel_socket<0) { perror("[totk-telemetry] socket"); return; }
+ if(fcntl(tel_socket,F_SETFL,O_NONBLOCK)<0) {
+  perror("[totk-telemetry] nonblocking socket");close(tel_socket);tel_socket=-1;return;
+ }
+ runtime_control_start();
+ atomic_store_explicit(&telemetry_active,1,memory_order_release);
+ int error=pthread_create(&tel_thread,NULL,tel_worker,NULL);
+ if(error) {
+  atomic_store(&telemetry_active,0);close(tel_socket);tel_socket=-1;
+  fprintf(stderr,"[totk-telemetry] pthread_create: %s\n",strerror(error));return;
+ }
+ pthread_detach(tel_thread);
+ fprintf(stderr,"[totk-telemetry] started: frame snapshots → UDP 127.0.0.1:%d, 10 Hz\n",TEL_PORT);
+}
diff --git a/games/totk/runtime/telemetry.h b/games/totk/runtime/telemetry.h
new file mode 100644
index 0000000000000000000000000000000000000000..b9921081fcb2cf3c53cea4b5ee897325b0e4e4bc
--- /dev/null
+++ b/games/totk/runtime/telemetry.h
@@ -0,0 +1,8 @@
+/* Read-only game-frame sampling with a separate loopback UDP sender. */
+#pragma once
+#include "runtime.h"
+#include <stdatomic.h>
+extern _Atomic int telemetry_active;
+void telemetry_init(void);
