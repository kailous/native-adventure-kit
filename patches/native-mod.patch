+/* Host-only integration of the real scene reader, frame sampler and packet encoder.
+   Compile with -Ithird_party/d2r_gfx/gfx/nvn/include. No game or ROM needed. */
+#include <assert.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include "../runtime/virtual_input.c"
+#include "nfp_stubs.h"
+#include "../runtime/native_control.c"
+#include "../runtime/telemetry.c"
+const Module *runtime_module_info(const char *name){(void)name;return NULL;}
+static uintptr_t camera_heap_base;static size_t camera_heap_size;
+void runtime_guest_heap_range(uintptr_t *base,size_t *size){*base=camera_heap_base;*size=camera_heap_size;}
+static uint64_t mock_now=12500000000ULL;
+uint8_t *runtime_module_base(const char *name) { (void)name; return (uint8_t *)main_base; }
+uint64_t runtime_now_ns(void) { return mock_now; }
+static void pointer(void *base,size_t offset,void *value) {
+ memcpy((uint8_t *)base+offset,&value,sizeof value);
+}
+static void integer(void *base,size_t offset,int value) { memcpy((uint8_t *)base+offset,&value,4); }
+#include "camera_features.h"
+int main(void) {
+ size_t page=(size_t)getpagesize();
+ uint8_t *mapping=mmap(NULL,2*page,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANON,-1,0);
+ assert(mapping!=MAP_FAILED);
+ unsigned char out[8];
+ assert(runtime_player_read((uintptr_t)mapping,out,sizeof out));
+ assert(!runtime_player_read(0,out,8));
+ assert(!runtime_player_read(UINTPTR_MAX-3,out,8));
+ assert(mprotect(mapping+page,page,PROT_NONE)==0);
+ assert(!runtime_player_read((uintptr_t)mapping+page,out,8));
+ assert(!runtime_player_read((uintptr_t)mapping+page-4,out,8));
+ assert(munmap(mapping,2*page)==0);
+
+ size_t image_size=GAME_ADDR(0x4663f08)+8u;
+ uint8_t *image=calloc(1,image_size);assert(image);
+ main_base=(uintptr_t)image;
+ telemetry_init();assert(strncmp(tel_session,"mac-native-",11)==0);
+ atomic_store(&telemetry_active,1);
+ telemetry_frame_tick(1);assert(!current_snapshot(mock_now).available);
+ uint8_t module[0x200]={0},scene[0x60]={0},components[14*8]={0},resident[0x30]={0};
+ uint8_t links[0x70]={0},data[0x60]={0},actor[0x500]={0};
+ pointer(image,GAME_ADDR(0x4663f08),module);pointer(module,0x1e8,scene);
+ integer(scene,0x50,14);pointer(scene,0x58,components);pointer(components,13*8,resident);
+ integer(resident,0x20,1);pointer(resident,0x28,links);pointer(links,8,data);pointer(data,0x40,actor);
+ pointer(actor,GAME_ACTOR_NAME,"Player");
+ float pos[3]={123.5f,456.0f,-789.0f},rot[9]={1,0,0,0,1,0,0,0,1};
+ memcpy(actor+GAME_ACTOR_POS,pos,sizeof pos);memcpy(actor+GAME_ACTOR_ROT,rot,sizeof rot);
+ RuntimePlayerState player;assert(runtime_player_sample(main_base,&player));
+ assert(memcmp(player.position,pos,sizeof pos)==0); /* No HP chain required. */
+ pointer(actor,GAME_ACTOR_NAME,"PlayerFake");assert(!runtime_player_sample(main_base,&player));
+ pointer(actor,GAME_ACTOR_NAME,"Player");
+ pointer(data,0x40,(void *)0x1234);assert(!runtime_player_sample(main_base,&player));pointer(data,0x40,actor);
+ integer(resident,0x20,65);assert(!runtime_player_sample(main_base,&player));integer(resident,0x20,1);
+ mock_now+=TEL_INTERVAL_NS;telemetry_frame_tick(2);
+ Snapshot snap=current_snapshot(mock_now);assert(snap.available);
+ camera_tests(image,pos);
+ Snapshot valid=snap;
+ char packet[2048];int len=build_packet(&snap,42,packet,sizeof packet);
+ assert(len>0 && (size_t)len<sizeof packet);assert(strstr(packet,"\"timestamp\":12.600000"));
+ puts(packet);
+ /* Changes are invisible until the next permitted frame sample. */
+ pos[0]=500;memcpy(actor+GAME_ACTOR_POS,pos,sizeof pos);
+ telemetry_frame_tick(3);assert(current_snapshot(mock_now).position[0]==123.5f);
+ mock_now+=TEL_INTERVAL_NS;
+ pthread_mutex_lock(&snapshot_lock);telemetry_frame_tick(4);pthread_mutex_unlock(&snapshot_lock);
+ assert(current_snapshot(mock_now).position[0]==123.5f); /* Game thread did not block. */
+ telemetry_frame_tick(5);assert(current_snapshot(mock_now).position[0]==500);
+ /* A halted frame producer invalidates the snapshot instead of refreshing old data. */
+ snap=current_snapshot(mock_now+TEL_STALE_NS+1);assert(!snap.available);
+ build_packet(&snap,43,packet,sizeof packet);puts(packet);
+ *(float *)(actor+GAME_ACTOR_POS)=NAN;mock_now+=TEL_INTERVAL_NS;telemetry_frame_tick(6);
+ assert(!current_snapshot(mock_now).available);
+ memcpy(actor+GAME_ACTOR_POS,pos,sizeof pos);memset(actor+GAME_ACTOR_ROT,0,sizeof rot);
+ assert(!runtime_player_sample(main_base,&player));
+ memcpy(actor+GAME_ACTOR_ROT,rot,sizeof rot);
+ *(float *)(actor+GAME_ACTOR_ROT)=-1;assert(!runtime_player_sample(main_base,&player));
+ memcpy(actor+GAME_ACTOR_ROT,rot,sizeof rot);mock_now+=TEL_INTERVAL_NS;telemetry_frame_tick(7);
+ assert(current_snapshot(mock_now).available); /* Scene becomes valid again. */
+ pointer(image,GAME_ADDR(0x4663f08),NULL);mock_now+=TEL_INTERVAL_NS;telemetry_frame_tick(8);
+ assert(!current_snapshot(mock_now).available);
+ atomic_store(&telemetry_active,0);free(image);
+ if(getenv("TOTK_TEST_SEND")) {
+  /* Network worker must remain safe even when guest memory is unavailable. */
+  main_base=1;valid.tick=mock_now;latest=valid;
+  tel_socket=socket(AF_INET,SOCK_DGRAM,0);assert(tel_socket>=0);
+  assert(fcntl(tel_socket,F_SETFL,O_NONBLOCK)==0);
+  atomic_store(&telemetry_active,1);
+  assert(pthread_create(&tel_thread,NULL,tel_worker,NULL)==0);
+  usleep(220000);
+  pthread_mutex_lock(&snapshot_lock);latest=(Snapshot){.tick=mock_now};pthread_mutex_unlock(&snapshot_lock);
+  usleep(220000);atomic_store(&telemetry_active,0);
+  assert(pthread_join(tel_thread,NULL)==0);close(tel_socket);
+ }
+ return 0;
+}
