+"""Measured present intervals must preserve real time; the previous floor is a negative control."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+RUNTIME = ROOT/'games/totk/runtime'
+
+class FrameStepRegression(unittest.TestCase):
+    def test_present_patterns_and_old_floor_negative_control(self):
+        source = (RUNTIME/'game_patches_v143.c').read_text()
+        with tempfile.TemporaryDirectory() as folder:
+            folder = Path(folder)
+            old = folder/'old.c'
+            line = '    if(dt>1.0/15.0)dt=1.0/15.0;'
+            self.assertEqual(source.count(line), 1)
+            old.write_text(source.replace(line, '    if(dt<1.0/120.0)dt=1.0/120.0;\n'+line))
+            for negative in (False, True):
+                binary = folder/('old' if negative else 'current')
+                args = ['xcrun','clang','-std=c11','-O1','-Wall','-Wextra','-Werror',
+                        '-Wl,-dead_strip','-I'+str(RUNTIME)]
+                if negative:
+                    args += ['-DGAME_PATCHES_SOURCE="'+str(old)+'"']
+                subprocess.run(args+[str(ROOT/'tests/test_frame_step.c'),'-o',str(binary)],check=True)
+                result = subprocess.run([str(binary)],capture_output=True,text=True)
+                if negative:
+                    self.assertNotEqual(result.returncode,0)
+                    self.assertIn('frame-time mismatch',result.stderr)
+                else:
+                    self.assertEqual(result.returncode,0,result.stderr)
