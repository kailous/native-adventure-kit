diff --git a/games/totk/runtime/telemetry.c b/games/totk/runtime/telemetry.c
new file mode 100644
index 0000000000000000000000000000000000000000..19c54efc1d3632cc498b2fb3df90bdf7a33a674c
--- /dev/null
+++ b/games/totk/runtime/telemetry.c
@@ -0,0 +1,204 @@
+/* Game-frame player snapshots. Camera discovery alone uses bounded read-only
+   copies on the worker; all mutations remain on the game frame thread. */
+#include "telemetry.h"
+#include "input_observer.h"
+#include "player_state.h"
+#include "map_ui.h"
+#include "native_control.h"
+#include "control_version.h"
+#include "camera_probe.h"
+#include <stdio.h>
+#include <stdbool.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <fcntl.h>
+#include <time.h>
+#include <errno.h>
+#include "phone_motion.h"
+
+#ifndef TEL_PORT
+#define TEL_PORT 7074
+#endif
+#define TEL_INTERVAL_NS 100000000ULL
+#define TEL_STALE_NS 500000000ULL
+
+static uintptr_t main_base;
+static pthread_t tel_thread;
+_Atomic int telemetry_active;
+static int tel_socket=-1;
+static char tel_session[64];
+static pthread_mutex_t snapshot_lock=PTHREAD_MUTEX_INITIALIZER;
+typedef struct {
+ float position[3],rotation[9];
+ uint64_t tick;
+ bool available;
+ RuntimeMapUI ui;
+} Snapshot;
+static Snapshot latest;
+
+/* Called only at the game's actual frame-end fence. Sampling is bounded to
+   10 Hz and publication never blocks the game thread on the network worker. */
+void telemetry_frame_tick(uint64_t frame) {
+ (void)frame;
+ static uint64_t last_sample;
+ static _Thread_local bool in_tick;
+ if(!atomic_load_explicit(&telemetry_active,memory_order_relaxed) || in_tick) return;
+ uint64_t now=runtime_now_ns();
+ runtime_control_frame(now);
+ runtime_phone_motion_tick(now);
+ if(last_sample && now-last_sample<TEL_INTERVAL_NS) return;
+ in_tick=true;
+ RuntimePlayerState player;
+ Snapshot snap={.tick=now};
+ snap.available=runtime_player_sample(main_base,&player);
+ snap.ui=runtime_map_sample(main_base);
+ if(snap.available) {
+  memcpy(snap.position,player.position,sizeof snap.position);
+  memcpy(snap.rotation,player.rotation,sizeof snap.rotation);
+ }
+ if(pthread_mutex_trylock(&snapshot_lock)==0) {
+  latest=snap;
+  pthread_mutex_unlock(&snapshot_lock);
+  last_sample=now;
+ }
+ in_tick=false;
+}
+
+static Snapshot current_snapshot(uint64_t now) {
+ pthread_mutex_lock(&snapshot_lock);
+ Snapshot snap=latest;
+ pthread_mutex_unlock(&snapshot_lock);
+ if(!snap.tick || now<snap.tick || now-snap.tick>TEL_STALE_NS) {
+  memset(&snap,0,sizeof snap);
+  snap.tick=now;
+ }
+ return snap;
+}
+
+static int build_packet(const Snapshot *snap, uint64_t sequence,
+                        char *buf, size_t cap) {
+ if(!snap->available) return snprintf(buf,cap,
