+#ifndef TOTK_GPU_BUDGET_POLICY_H
+#define TOTK_GPU_BUDGET_POLICY_H
+#include <stdint.h>
+/* Retain the backend's 40%-of-RAM rule, with an 8 GiB ceiling well below the
+   historical ~15 GiB driver failures. Never return zero (disables protection). */
+static inline uint64_t totk_gpu_budget_mb(uint64_t physical_bytes) {
+    if (!physical_bytes) return 5000; /* conservative fallback if querying fails */
+    uint64_t mb = (physical_bytes / 5 * 2) >> 20;
+    return mb > 8192 ? 8192 : mb ? mb : 1;
+}
+#endif
