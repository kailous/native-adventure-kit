+/* One virtual NFC reader. ABI layouts/state values checked against libnx nfc.h.
+ * Host UI queues public model/UID data; only NFP calls touch guest buffers. */
+#include <stdlib.h>
+#include <stdint.h>
+#define NFP_DEVICE_NOT_FOUND 0x8073u
+#define NFP_INVALID_STATE 0x1773u
+static pthread_mutex_t nfp_lock=PTHREAD_MUTEX_INITIALIZER;
+static int nfp_state,nfp_device,nfp_pending;
+static unsigned nfp_mount_target;
+static uint8_t nfp_model[0x40],nfp_uid[7];
+static void *nfp_activate,*nfp_deactivate;
+static const uint64_t nfp_handle=0x544f544b00000001ULL;
+static int nfp_valid(const void *h){uint64_t v=0;if(h)memcpy(&v,h,8);return v==nfp_handle;}
+static int nfp_hex(const char *s,size_t n,uint8_t *out){
+    if(!s||strlen(s)!=n*2)return 0;
+    for(size_t i=0;i<n;i++){unsigned v=0;for(unsigned j=0;j<2;j++){unsigned char c=s[2*i+j];unsigned x=c>='0'&&c<='9'?c-'0':c>='a'&&c<='f'?c-'a'+10:c>='A'&&c<='F'?c-'A'+10:255;if(x>15)return 0;v=v*16+x;}out[i]=(uint8_t)v;}return 1;
+}
+int runtime_nfp_scan(const char *id,const char *uid){
+    uint8_t raw[8],serial[7];if(!nfp_hex(id,8,raw)||!nfp_hex(uid,7,serial))return 0;
+    pthread_mutex_lock(&nfp_lock);
+    if(nfp_device==2||nfp_device==4||nfp_pending){pthread_mutex_unlock(&nfp_lock);return 0;}
+    memset(nfp_model,0,sizeof nfp_model);memcpy(nfp_model,raw,3);nfp_model[3]=raw[6];memcpy(nfp_model+4,raw+4,2);nfp_model[6]=raw[3];memcpy(nfp_uid,serial,7);nfp_pending=1;
+    if(nfp_state&&nfp_device==1){nfp_device=2;nfp_pending=0;if(nfp_activate)hle_try_signal_system_event(nfp_activate);}
+    pthread_mutex_unlock(&nfp_lock);fprintf(stderr,"[totk-nfp] virtual tag queued: %s\n",id);return 1;
+}
+static unsigned nfp_initialize(void){pthread_mutex_lock(&nfp_lock);nfp_state=1;nfp_device=0;nfp_mount_target=0;pthread_mutex_unlock(&nfp_lock);return 0;}
+static unsigned nfp_finalize(void){pthread_mutex_lock(&nfp_lock);nfp_state=0;nfp_device=0;nfp_pending=0;nfp_mount_target=0;nfp_activate=nfp_deactivate=NULL;pthread_mutex_unlock(&nfp_lock);return 0;}
+static int nfp_get_state(void){pthread_mutex_lock(&nfp_lock);int s=nfp_state;pthread_mutex_unlock(&nfp_lock);return s;}
+static unsigned nfp_list(void *handles,int *count,int max){if(!count||max<0||(!handles&&max))return NFP_INVALID_STATE;pthread_mutex_lock(&nfp_lock);int ready=nfp_state;pthread_mutex_unlock(&nfp_lock);*count=ready&&max?1:0;if(*count)memcpy(handles,&nfp_handle,8);return ready?0:NFP_INVALID_STATE;}
+static unsigned nfp_attach_availability(void *event){if(!event)return NFP_INVALID_STATE;hle_bind_system_event(event,1);return 0;}
+/* SDK 1.4.3 AttachActivateEvent/AttachDeactivateEvent attach with EventClearMode=1 (auto-clear), not libnx Event wrapper defaults. */
+static unsigned nfp_attach_activate(void *event,const void *h){if(!event||!nfp_valid(h))return NFP_DEVICE_NOT_FOUND;hle_bind_system_event(event,1);pthread_mutex_lock(&nfp_lock);nfp_activate=event;if(nfp_device==2)hle_try_signal_system_event(event);pthread_mutex_unlock(&nfp_lock);return 0;}
+static unsigned nfp_attach_deactivate(void *event,const void *h){if(!event||!nfp_valid(h))return NFP_DEVICE_NOT_FOUND;hle_bind_system_event(event,1);pthread_mutex_lock(&nfp_lock);nfp_deactivate=event;pthread_mutex_unlock(&nfp_lock);return 0;}
+static int nfp_device_state(const void *h){pthread_mutex_lock(&nfp_lock);int s=nfp_state&&nfp_valid(h)?nfp_device:5;pthread_mutex_unlock(&nfp_lock);return s;}
+static unsigned nfp_start(const void *h){pthread_mutex_lock(&nfp_lock);unsigned r=0;if(!nfp_state||!nfp_valid(h))r=NFP_DEVICE_NOT_FOUND;else if(nfp_device!=0&&nfp_device!=3)r=NFP_INVALID_STATE;else{nfp_device=nfp_pending?2:1;nfp_pending=0;if(nfp_device==2&&nfp_activate)hle_try_signal_system_event(nfp_activate);}pthread_mutex_unlock(&nfp_lock);fprintf(stderr,"[totk-nfp] start detection: %#x\n",r);return r;}
+static unsigned nfp_stop(const void *h){pthread_mutex_lock(&nfp_lock);unsigned r=nfp_state&&nfp_valid(h)?0:NFP_DEVICE_NOT_FOUND;if(!r){if((nfp_device==2||nfp_device==4)&&nfp_deactivate)hle_try_signal_system_event(nfp_deactivate);nfp_device=0;nfp_mount_target=0;}pthread_mutex_unlock(&nfp_lock);return r;}
+static unsigned nfp_mount(const void *h,unsigned type,unsigned target){pthread_mutex_lock(&nfp_lock);unsigned r=nfp_valid(h)&&nfp_device==2&&type==0&&(target&3)&&!(target&~3u)?0:NFP_INVALID_STATE;if(!r){if(nfp_device==2)nfp_mount_target=0;nfp_device=4;nfp_mount_target|=target;}pthread_mutex_unlock(&nfp_lock);fprintf(stderr,"[totk-nfp] mount type=%u target=%u: %#x\n",type,target,r);return r;}
+static unsigned nfp_unmount(const void *h){pthread_mutex_lock(&nfp_lock);unsigned r=nfp_valid(h)&&nfp_device==4?0:NFP_INVALID_STATE;if(!r){nfp_device=2;nfp_mount_target=0;}pthread_mutex_unlock(&nfp_lock);return r;}
+static unsigned nfp_npad(void *out,const void *h){if(!out||!nfp_valid(h))return NFP_DEVICE_NOT_FOUND;uint32_t id=0;memcpy(out,&id,4);return 0;}
+static unsigned nfp_tag(void *out,const void *h){pthread_mutex_lock(&nfp_lock);unsigned r=out&&nfp_valid(h)&&(nfp_device==2||nfp_device==4)?0:NFP_INVALID_STATE;if(!r){uint8_t b[0x58]={0};memcpy(b,nfp_uid,7);b[10]=7;uint32_t protocol=1,kind=2;memcpy(b+0x20,&protocol,4);memcpy(b+0x24,&kind,4);memcpy(out,b,sizeof b);}pthread_mutex_unlock(&nfp_lock);return r;}
+static unsigned nfp_model_info(void *out,const void *h){pthread_mutex_lock(&nfp_lock);unsigned r=out&&nfp_valid(h)&&nfp_device==4&&(nfp_mount_target&1)?0:NFP_INVALID_STATE;if(!r)memcpy(out,nfp_model,sizeof nfp_model);pthread_mutex_unlock(&nfp_lock);fprintf(stderr,"[totk-nfp] model info: %#x\n",r);return r;}
+
+void runtime_nfp_status_json(char *out,size_t size){pthread_mutex_lock(&nfp_lock);snprintf(out,size,"{\"available\":true,\"initialized\":%s,\"deviceState\":%d,\"queued\":%s}",nfp_state?"true":"false",nfp_device,nfp_pending?"true":"false");pthread_mutex_unlock(&nfp_lock);}
diff --git a/games/totk/runtime/phone_motion.h b/games/totk/runtime/phone_motion.h
new file mode 100644
index 0000000000000000000000000000000000000000..db0a31b3f85e1ab316cd7dee44a42b4c2640aa85
--- /dev/null
+++ b/games/totk/runtime/phone_motion.h
@@ -0,0 +1,95 @@
+/* Bounded loopback phone IMU transport. The verified game frame fence owns
+   polling, arbitration and feeding the existing six-axis fusion. No guest
+   memory, game calls, controller buttons or persistent settings are touched. */
+#pragma once
+#include "runtime.h"
+#include "game_version.h"
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+
+#ifndef PHONE_MOTION_PORT
+#define PHONE_MOTION_PORT 7077
+#endif
+#define PM_EXPIRY_NS 200000000ULL
+typedef struct {
+    char magic[4]; uint8_t version, op; uint16_t reserved;
+    uint64_t session, sequence, sent_ns;
+    float acc[3], gyro[3]; /* gravity included, G; angular velocity, rad/s */
+} PMRequest;
+_Static_assert(sizeof(PMRequest)==56 && offsetof(PMRequest,acc)==32,"TPM1 wire ABI");
+typedef struct {
+    uint64_t session, sequence, received_ns;
+    bool sample;
+    double acc[3], gyro[3];
+} PMState;
+static PMState pm_state;
+static int pm_socket=-1;
+
+static bool pm_fresh(uint64_t now) {
+    return pm_state.sample && now>=pm_state.received_ns && now-pm_state.received_ns<=PM_EXPIRY_NS;
+}
+static int pm_accept(const void *raw,size_t size,uint64_t now,PMRequest *request) {
+    if(size!=sizeof *request)return 2;
+    memcpy(request,raw,sizeof *request);
+    if(memcmp(request->magic,"TPM1",4)||request->version!=1||request->reserved||request->op>3)return 2;
+    if(request->sent_ns>now || now-request->sent_ns>PM_EXPIRY_NS)return 3;
+    if(!request->op)return request->session?2:0;
+    if(!runtime_gyro_enabled())return 4;
+    if(!request->session||!request->sequence)return 2;
+    if(request->session!=pm_state.session && (request->op!=1 || pm_fresh(now)))return 5;
+    if(request->session==pm_state.session && request->sequence<=pm_state.sequence)return 3;
+    if(request->op==1)for(unsigned i=0;i<3;i++) {
+        if(!isfinite(request->acc[i])||fabsf(request->acc[i])>8 ||
+           !isfinite(request->gyro[i])||fabsf(request->gyro[i])>35)return 2;
+    }
+    bool new_session=request->session!=pm_state.session;
+    pm_state.session=request->session;pm_state.sequence=request->sequence;
+    if(request->op==2){pm_state.sample=false;runtime_motion_phone(0);return 0;}
+    if(request->op==3){runtime_motion_phone_reset();return 0;}
+    pm_state.sample=true;pm_state.received_ns=request->sent_ns;
+    for(unsigned i=0;i<3;i++){pm_state.acc[i]=request->acc[i];pm_state.gyro[i]=request->gyro[i];}
+    runtime_motion_phone(1);
+    if(new_session)runtime_motion_phone_reset();
+    return 0;
+}
+static void runtime_phone_motion_tick(uint64_t now) {
+    if(pm_socket<0)return;
+    for(unsigned budget=0;budget<16;budget++) {
+        unsigned char raw[sizeof(PMRequest)+1];
+        struct sockaddr_in peer={0};socklen_t length=sizeof peer;
+        ssize_t size=recvfrom(pm_socket,raw,sizeof raw,0,(struct sockaddr *)&peer,&length);
+        if(size<0)break;
+        if(length!=sizeof peer||peer.sin_family!=AF_INET||peer.sin_addr.s_addr!=htonl(INADDR_LOOPBACK))continue;
+        PMRequest request={0};now=runtime_now_ns();
+        int code=pm_accept(raw,(size_t)size,now,&request);
+        /* Only a decoded, versioned request gets a response. A separate
+           status query detects older games without commandeering an IMU. */
+        if(size!=(ssize_t)sizeof request||memcmp(request.magic,"TPM1",4)||request.version!=1)continue;
+        char reply[320];
+        int n=snprintf(reply,sizeof reply,"{\"protocol\":\"totk-phone-motion/1\",\"gameVersion\":\"%s\",\"sequence\":%llu,\"code\":%d,\"gyroEnabled\":%s,\"active\":%s,\"selected\":%s}",
+            TOTK_GAME_VERSION,(unsigned long long)request.sequence,code,runtime_gyro_enabled()?"true":"false",
+            pm_fresh(now)?"true":"false",pm_fresh(now)&&runtime_motion_phone_selected()?"true":"false");
+        if(n>0&&(size_t)n<sizeof reply)sendto(pm_socket,reply,(size_t)n,0,(struct sockaddr *)&peer,sizeof peer);
+    }
+    now=runtime_now_ns();
+    if(!pm_fresh(now)){runtime_motion_phone(0);return;}
+    runtime_motion_feed_phone(pm_state.acc,pm_state.gyro,now);
+}
+static void runtime_phone_motion_start(void) {
+    if(pm_socket>=0)return;
+    int fd=socket(AF_INET,SOCK_DGRAM,0);if(fd<0)return;
+    struct sockaddr_in address={.sin_family=AF_INET,.sin_port=htons(PHONE_MOTION_PORT),.sin_addr.s_addr=htonl(INADDR_LOOPBACK)};
+    int size=16384;
+    if(setsockopt(fd,SOL_SOCKET,SO_RCVBUF,&size,sizeof size)<0 || fcntl(fd,F_SETFL,O_NONBLOCK)<0 ||
+       bind(fd,(struct sockaddr *)&address,sizeof address)<0){perror("[phone-motion] loopback socket");close(fd);return;}
+    pm_socket=fd;
+    fprintf(stderr,"[phone-motion] TPM1 on 127.0.0.1:%d, expires after 200 ms; mouse > phone > controller\n",PHONE_MOTION_PORT);
+}
diff --git a/games/totk/runtime/player_state.h b/games/totk/runtime/player_state.h
new file mode 100644
index 0000000000000000000000000000000000000000..6112dcb9811480f995e4ad0634e9d11ef432dc8f
--- /dev/null
+++ b/games/totk/runtime/player_state.h
@@ -0,0 +1,69 @@
+/* Shared, read-only player lookup. No hooks, writes, cached Actor pointers or HP dependency. */
+#pragma once
+#include "game_version.h"
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <math.h>
+#include "mach_vm_compat.h"
+
+typedef struct { float position[3], rotation[9]; } RuntimePlayerState;
+static inline int runtime_player_read(uintptr_t address, void *out, size_t size) {
+    if (!address || !size || address > UINTPTR_MAX - size) return 0;
+    mach_vm_size_t got = 0;
+    return mach_vm_read_overwrite(mach_task_self(), address, size, (uintptr_t)out, &got) == KERN_SUCCESS && got == size;
+}
+static inline uintptr_t runtime_player_ptr(uintptr_t address) {
+    uintptr_t p = 0; return runtime_player_read(address, &p, sizeof p) ? p : 0;
+}
+static inline int runtime_player_valid_xyz(const float xyz[3]) {
+    return isfinite(xyz[0]) && isfinite(xyz[1]) && isfinite(xyz[2]) &&
+           fabsf(xyz[0]) <= 5500 && xyz[1] >= -1500 && xyz[1] <= 3500 && fabsf(xyz[2]) <= 5000;
+}
+static inline uintptr_t runtime_player_actor(uintptr_t main) {
+    if (!main) return 0;
+    uintptr_t module = runtime_player_ptr(main + GAME_ADDR(0x4663f08));
+    uintptr_t scene = module ? runtime_player_ptr(module + 0x1e8) : 0;
+    int count = 0;
+    if (!scene || !runtime_player_read(scene + 0x50, &count, 4) || count < 14 || count > 256) return 0;
+    uintptr_t components = runtime_player_ptr(scene + 0x58);
+    uintptr_t resident = components ? runtime_player_ptr(components + 13 * 8) : 0;
+    if (!resident || !runtime_player_read(resident + 0x20, &count, 4) || count < 1 || count > 64) return 0;
+    uintptr_t links = runtime_player_ptr(resident + 0x28);
+    for (int i = 0; links && i < count; ++i) {
+        uintptr_t data = runtime_player_ptr(links + (uintptr_t)i * 0x70 + 8);
+        uintptr_t actor = data ? runtime_player_ptr(data + 0x40) : 0;
+        uintptr_t name = actor ? runtime_player_ptr(actor + GAME_ACTOR_NAME) : 0;
+        char text[7]; float xyz[3];
+        if (name && runtime_player_read(name, text, sizeof text) && !memcmp(text, "Player", 7) &&
+            runtime_player_read(actor + GAME_ACTOR_POS, xyz, sizeof xyz) && runtime_player_valid_xyz(xyz)) return actor;
+    }
+    return 0;
+}
+static inline int runtime_player_sample(uintptr_t main, RuntimePlayerState *out) {
+    memset(out, 0, sizeof *out);
+    uintptr_t actor = runtime_player_actor(main);
+    if (!actor) return 0;
+    /* Position and rotation are adjacent in the versioned Actor layout. Copy
+       both in one kernel read; game-frame scheduling further reduces tearing. */
+    _Static_assert(GAME_ACTOR_ROT == GAME_ACTOR_POS + 12, "contiguous player transform");
+    RuntimePlayerState sample;
+    if (!runtime_player_read(actor + GAME_ACTOR_POS, &sample, sizeof sample) ||
+        !runtime_player_valid_xyz(sample.position)) return 0;
+    for (int i = 0; i < 9; ++i)
+        if (!isfinite(sample.rotation[i]) || fabsf(sample.rotation[i]) > 1.1f) return 0;
+    for (int row = 0; row < 3; ++row) {
+        float norm = 0;
+        for (int j = 0; j < 3; ++j) norm += sample.rotation[row*3+j] * sample.rotation[row*3+j];
+        if (fabsf(norm - 1) > .05f) return 0;
+        for (int other = row + 1; other < 3; ++other) {
+            float dot = 0;
+            for (int j = 0; j < 3; ++j) dot += sample.rotation[row*3+j] * sample.rotation[other*3+j];
+            if (fabsf(dot) > .05f) return 0;
+        }
+    }
+    const float *r = sample.rotation;
+    float determinant = r[0]*(r[4]*r[8]-r[5]*r[7]) - r[1]*(r[3]*r[8]-r[5]*r[6]) + r[2]*(r[3]*r[7]-r[4]*r[6]);
+    if (fabsf(determinant - 1) > .1f) return 0;
+    *out = sample; return 1;
+}
diff --git a/games/totk/runtime/pouch_control.h b/games/totk/runtime/pouch_control.h
new file mode 100644
index 0000000000000000000000000000000000000000..52d50b47529f83b09e417dd5bd12e3e3054c6d4b
--- /dev/null
+++ b/games/totk/runtime/pouch_control.h
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Only weapon/bow/shield durability. No inventory API or worn-equipment list. */
+#pragma once
+#include "equipment_defaults.h"
+#define PC_CAPACITY 128
+static const uint32_t pc_life_hash[]={0x8b12d062,0x60589200,0xc3416d19},pc_name_hash[]={0x65efd0be,0x791c4a0b,0x273190f4},pc_effect_hash[]={0xdd846288,0xd59aeed5,0x464b410c},pc_bonus_hash[]={0xfda1d214,0xdfd216f2,0xa6a38304};
+typedef struct {uintptr_t life,effects,bonus,names,fuse_names,extra,record,fuse_life;unsigned slots,count;int32_t lives[PC_CAPACITY],bonuses[PC_CAPACITY],extras[PC_CAPACITY],records[PC_CAPACITY],fuses[PC_CAPACITY];uint32_t types[PC_CAPACITY];char ids[PC_CAPACITY][64],fused[PC_CAPACITY][64];unsigned char raw_names[PC_CAPACITY][80],raw_fused[PC_CAPACITY][80];} PCBag;
+typedef struct {uint64_t identity[PC_CAPACITY];int32_t life[PC_CAPACITY],extra[PC_CAPACITY],fuse[PC_CAPACITY];} PCFrozen;
+static PCFrozen pc_frozen[3];static int pc_modes[3];
+/* Stable field hashes, not array ordering, identify GameData entries. */
+static uintptr_t pc_object(uintptr_t manager,unsigned group,uint32_t hash,size_t stride){
+ uintptr_t header=nc_field(manager,group*0x60+8);uint32_t n=0,entries=0;
+ if(!nc_read(nc_field(header,8),&n,4)||!nc_read(nc_field(header,0x24),&entries,4)||!n||n>16384||entries!=n*2)return 0;
+ uintptr_t map=nc_follow(header,0x18),table=nc_follow(header,0x10);if(!map||!table)return 0;
+ for(unsigned offset=0;offset<entries;offset+=256){
+  uint32_t pairs[256][2];unsigned take=entries-offset<256?entries-offset:256;
+  if(!nc_read(nc_field(map,offset*8),pairs,take*8))return 0;
+  for(unsigned i=0;i<take;i++)if(pairs[i][0]==hash)return pairs[i][1]<n?nc_field(table,pairs[i][1]*stride):0;
+ }
+ return 0;
+}
+static uintptr_t pc_array_limit(uintptr_t manager,unsigned group,uint32_t hash,size_t stride,unsigned limit,unsigned *count){
+ uintptr_t object=pc_object(manager,group,hash,stride);uint64_t total=0;
+ if(!object||!nc_read(nc_field(object,group==17?0x70:0x20),&total,8)||!total||total>limit)return 0;
+ uintptr_t data=nc_follow(object,group==17?0x78:0x28);if(!data)return 0;
+ *count=(unsigned)total;return data;
+}
+static uintptr_t pc_array(uintptr_t manager,unsigned group,uint32_t hash,size_t stride,unsigned *count){return pc_array_limit(manager,group,hash,stride,PC_CAPACITY,count);}
+static bool pc_name(uintptr_t data,unsigned index,const unsigned char raw[80],char out[64]){
+ uintptr_t object=nc_field(data,index*80),pointer=0;uint32_t capacity=0;memcpy(&pointer,raw,8);memcpy(&capacity,raw+8,4);
+ if(pointer!=object+12||capacity!=64||!memchr(raw+12,0,64))return false;
+ memcpy(out,raw+12,64);for(unsigned i=0;out[i];i++)if(!((out[i]>='a'&&out[i]<='z')||(out[i]>='A'&&out[i]<='Z')||(out[i]>='0'&&out[i]<='9')||out[i]=='_'))return false;return true;
+}
+static bool pc_ints(uintptr_t manager,unsigned group,uint32_t hash,size_t stride,unsigned slots,uintptr_t *address,void *out){
+ unsigned n=0;*address=pc_array(manager,group,hash,stride,&n);return *address&&n==slots&&nc_read(*address,out,n*4);
+}
+static bool pc_load(uintptr_t manager,unsigned target,PCBag *b){
+ memset(b,0,sizeof *b);if(target>2)return false;
+ b->life=pc_array(manager,3,pc_life_hash[target],64,&b->slots);if(!b->life||!nc_read(b->life,b->lives,b->slots*4))return false;
+ unsigned n=0;b->names=pc_array(manager,17,pc_name_hash[target],144,&n);if(!b->names||n!=b->slots)return false;
+ if(!pc_ints(manager,7,pc_effect_hash[target],80,b->slots,&b->effects,b->types)||!pc_ints(manager,3,pc_bonus_hash[target],64,b->slots,&b->bonus,b->bonuses))return false;
+ if(target!=1){b->fuse_names=pc_array(manager,17,target==0?0x80707cad:0xc95833d9,144,&n);if(!b->fuse_names||n!=b->slots||!pc_ints(manager,3,target==0?0x6796852b:0x7a20968b,64,b->slots,&b->fuse_life,b->fuses))return false;}
+ if(target==0&&(!pc_ints(manager,3,0x12ffda6b,64,b->slots,&b->extra,b->extras)||!pc_ints(manager,3,0xbf321621,64,b->slots,&b->record,b->records)))return false;
+ if(!nc_read(b->names,b->raw_names,b->slots*80)||(b->fuse_names&&!nc_read(b->fuse_names,b->raw_fused,b->slots*80)))return false;
+ for(unsigned i=0;i<b->slots;i++){
+  if(!pc_name(b->names,i,b->raw_names[i],b->ids[i])||(b->fuse_names&&!pc_name(b->fuse_names,i,b->raw_fused[i],b->fused[i])))return false;
+  if(!b->ids[i][0]){if(b->lives[i]!=-1)return false;continue;}
+  if(strncmp(b->ids[i],"Weapon_",7)||b->lives[i]<0||b->lives[i]>100000||(b->bonuses[i]<0&&!(b->bonuses[i]==-1&&b->types[i]==0xb6eede09))||b->bonuses[i]>2100000000)return false;
+  if(b->extra&&(b->extras[i]<0||b->extras[i]>100000||b->records[i]<-1||b->records[i]>100000))return false;
+  if(b->fuse_life&&(b->fuses[i]<-1||b->fuses[i]>100000))return false;b->count++;
+ }
+ return true;
+}
+static int pc_default(const NativeEquipmentDefault *table,size_t n,const char *name){for(size_t i=0;i<n;i++)if(!strcmp(table[i].name,name))return table[i].value;return -1;}
+static uint64_t pc_hash(uint64_t h,const char *text){for(;*text;text++){h^=(unsigned char)*text;h*=1099511628211ULL;}return h;}
+static bool pc_commit(const PCBag *b,const int32_t *life,const int32_t *extra,const int32_t *fuse,bool record){
+ uintptr_t fields[]={b->life,b->extra,b->fuse_life,record?b->record:0};
+ for(unsigned j=0;j<4;j++)if(fields[j]&&!runtime_guest_writable(fields[j],b->slots*4))return false;
+ for(unsigned i=0;i<b->slots;i++)if(b->ids[i][0]){
+  if((life[i]!=b->lives[i]&&!nc_i32(nc_field(b->life,i*4),life[i]))||(b->extra&&extra[i]!=b->extras[i]&&!nc_i32(nc_field(b->extra,i*4),extra[i]))||(b->fuse_life&&fuse[i]!=b->fuses[i]&&!nc_i32(nc_field(b->fuse_life,i*4),fuse[i]))||(record&&b->record&&b->records[i]!=(b->fused[i][0]?extra[i]:-1)&&!nc_i32(nc_field(b->record,i*4),b->fused[i][0]?extra[i]:-1)))return false;
+ }
+ return true;
+}
+static bool pc_apply(const PCBag *b,unsigned mode){
+ int32_t life[PC_CAPACITY]={0},extra[PC_CAPACITY]={0},fuse[PC_CAPACITY]={0};
+ for(unsigned i=0;i<b->slots;i++)if(b->ids[i][0]){
+  life[i]=1;fuse[i]=b->fuses[i];
+  if(mode==2){
+   life[i]=pc_default(NC_DEFAULT_DURABILITY,sizeof NC_DEFAULT_DURABILITY/sizeof *NC_DEFAULT_DURABILITY,b->ids[i]);if(life[i]<1)return false;
+   if(b->types[i]==0xd5cad39b||b->types[i]==0xb2c943ee){if(b->bonuses[i]>100000-life[i])return false;life[i]+=b->bonuses[i];}
+   if(b->extra&&b->fused[i][0]){extra[i]=pc_default(NC_FUSE_DURABILITY,sizeof NC_FUSE_DURABILITY/sizeof *NC_FUSE_DURABILITY,b->ids[i]);if(extra[i]<0)extra[i]=25;}
+   if(b->fuse_life&&b->fused[i][0]){int value=pc_default(NC_DEFAULT_DURABILITY,sizeof NC_DEFAULT_DURABILITY/sizeof *NC_DEFAULT_DURABILITY,b->fused[i]);if(value>0)fuse[i]=value;}
+  }
+ }
+ return pc_commit(b,life,extra,fuse,mode==2);
+}
+static bool pc_freeze(unsigned target,const PCBag *b){
+ PCFrozen next=pc_frozen[target];
+ for(unsigned i=0;i<b->slots;i++){
+  if(!b->ids[i][0]){next.identity[i]=0;continue;}
+  uint64_t id=pc_hash(pc_hash(1469598103934665603ULL,b->ids[i]),b->fused[i]);id^=((uint64_t)b->types[i]<<32)|(uint32_t)b->bonuses[i];
+  if(next.identity[i]!=id){next.identity[i]=id;next.life[i]=b->lives[i];next.extra[i]=b->extras[i];next.fuse[i]=b->fuses[i];}
+  if(b->lives[i]>next.life[i])next.life[i]=b->lives[i];if(b->extras[i]>next.extra[i])next.extra[i]=b->extras[i];if(b->fuses[i]>next.fuse[i])next.fuse[i]=b->fuses[i];
+ }
+ if(!pc_commit(b,next.life,next.extra,next.fuse,false))return false;pc_frozen[target]=next;return true;
+}
diff --git a/games/totk/runtime/quantity_control.h b/games/totk/runtime/quantity_control.h
new file mode 100644
index 0000000000000000000000000000000000000000..81bdcaa193eaac58b563a8fe2f570469f0324e88
--- /dev/null
+++ b/games/totk/runtime/quantity_control.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Quantity arrays are resolved by field hash and their declared lengths.
+   Empty slots remain -1; no sparse stepping past an array's end. */
+#pragma once
+#define NI_CAPACITY 1024
+typedef struct {uintptr_t data[3];unsigned slots[3];int32_t values[3][NI_CAPACITY];} NIItems;
+static NIItems ni_items;static bool ni_enabled;
+static bool ni_load(NIItems *items){
+ static const uint32_t quantities[]={0xde2d8500,0x2a952a60,0x60d16ab0},names[]={0xd96ebf12,0x7c0f89ad,0xa86f2f10};
+ memset(items,0,sizeof *items);uintptr_t manager=nc_follow(nc_main,CONTROL_DATA_SLOT);
+ for(unsigned category=0;category<3;category++){
+  items->data[category]=pc_array_limit(manager,3,quantities[category],64,NI_CAPACITY,&items->slots[category]);
+  uintptr_t name_object=pc_object(manager,17,names[category],144);uint64_t name_count=0;
+  if(!items->data[category]||!name_object||!nc_read(nc_field(name_object,0x70),&name_count,8)||name_count!=items->slots[category]||!nc_read(items->data[category],items->values[category],items->slots[category]*4))return false;
+  for(unsigned i=0;i<items->slots[category];i++)if(items->values[category][i]<-1||items->values[category][i]>999)return false;
+ }
+ return true;
+}
+static bool ni_apply(const NIItems *items){
+ for(unsigned c=0;c<3;c++)if(!items->slots[c]||items->slots[c]>NI_CAPACITY||!runtime_guest_writable(items->data[c],items->slots[c]*4))return false;
+ for(unsigned c=0;c<3;c++)for(unsigned i=0;i<items->slots[c];i++)if(items->values[c][i]>=0&&items->values[c][i]!=99&&!nc_i32(nc_field(items->data[c],i*4),99))return false;
+ return true;
+}
