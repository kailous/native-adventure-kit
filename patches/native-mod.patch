+/* Darwin defaults UDP SO_SNDBUF to 9216 bytes. A full 128-event input history is larger,
+   so explicitly reserve enough for the bounded packet; otherwise sendto silently stopped location updates. */
+enum { TEL_PACKET_CAPACITY=49152, TEL_SOCKET_BUFFER=65536 };
+static int telemetry_open_socket(void) {
+ int fd=socket(AF_INET,SOCK_DGRAM,0);
+ if(fd<0){perror("[totk-telemetry] socket");return -1;}
+ int size=TEL_SOCKET_BUFFER;
+ if(setsockopt(fd,SOL_SOCKET,SO_SNDBUF,&size,sizeof size)<0 || fcntl(fd,F_SETFL,O_NONBLOCK)<0){
+  perror("[totk-telemetry] configure socket");close(fd);return -1;
+ }
+ return fd;
+}
+static int telemetry_send_snapshot(const Snapshot *snap,uint64_t sequence,const struct sockaddr_in *dst) {
+ char buf[TEL_PACKET_CAPACITY],inputs[46000];
+ int len=build_packet(snap,sequence,buf,sizeof buf);
+ size_t in=runtime_observe_json(inputs,sizeof inputs,runtime_now_ns());
