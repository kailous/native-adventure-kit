@@ -0,0 +1,91 @@
+"""Native 1.4.3 title-menu additions, using the game's existing sixth button.
+
+Keep the original layout, focus controller and confirm animation. A guarded AINB
+edit sets a localized message before opening the screen. No vendor dependency.
+"""
+import hashlib
+import struct
+from settings_menu_data import rebuild
+
+EXIT_LABEL = 'NativeDesktopExit'
+EXIT_PANE = 'Pa_Button_05/T_Btn_00'
+OPEN_TITLE_SHA = '84c79fd2726ec8648ffc56163cc4b1e6a2c5bef31bf26e48c117d0e5110ee597'
+
+def add_exit_sequence(data):
+    assert hashlib.sha256(data).hexdigest() == OPEN_TITLE_SHA, 'unrecognized 1.4.3 OpenTitle sequence'
+    b = bytearray(data)
+    u32 = lambda at: struct.unpack_from('<I', b, at)[0]
+    nodes = 0x74 + u32(0x0c) * 24
+    def body(index):
+        head = nodes + index * 60
+        assert struct.unpack_from('<h', b, head + 2)[0] == index
+        return head, u32(head + 20)
+    head, old = body(4)
+    assert struct.unpack_from('<H', b, head)[0] == 2  # sequential
+    assert b[old+144:old+164] == bytes.fromhex('0000000002000002000200020002000200020002')
+    refs = [u32(old+164+i*4) for i in range(2)]
+    assert [u32(p) for p in refs] == [5, 7]
+    # Clone this parameter/plug block before the string pool. Existing absolute
+    # sections stay fixed; every original string offset remains valid.
+    pool = u32(0x24)
+    block = bytearray(b[old:old+164])
+    block[144:] = bytes([0,0,0,0,3,0] + [0,3]*7)
+    for i in range(3): block += struct.pack('<I', pool+176+i*8)
+    empty_name = u32(refs[0]+4)
+    for child in [5,34,7]: block += struct.pack('<II',child,empty_name)
+    assert len(block) == 200
+    original_pool = b[pool:]
+    b[pool:pool] = block
+    struct.pack_into('<I', b, 0x24, pool+len(block))
+    struct.pack_into('<I', b, head+20, pool)
+    # Node 34 is an existing unused Switch 2 message setter. macOS follows the
+    # retained Switch 1 branches; execute it once after their original labels.
+    _, message = body(34)
+    first, count = struct.unpack_from('<II', b, message+96)
+    assert count == 4
+    io = u32(0x34)
+    strings = u32(io+3*8)
+    def string(offset):
+        return original_pool[offset:original_pool.index(0,offset)].decode()
+    replacements = {'LabelName':('0005',EXIT_LABEL), 'TextID':('Pa_Button_04/T_Btn_00',EXIT_PANE)}
+    for i in range(first, first+count):
+        p = strings+i*16
+        name = string(u32(p))
+        if name not in replacements: continue
+        before,after = replacements[name]
+        assert string(u32(p+12)) == before
+        offset = len(b)-(pool+len(block))
+        b += after.encode()+b'\0'
+        struct.pack_into('<I',b,p+12,offset)
+    return bytes(b)
+
+def add_exit_animation(data):
+    """Keep all original tracks; show button 05 directly after visible rows."""
+    assert data[:6] == b'FLAN\xff\xfe'
+    b = bytearray(data)
+    pos = 0x14
+    for _ in range(struct.unpack_from('<H',b,16)[0]):
+        size = struct.unpack_from('<I',b,pos+4)[0]
+        if b[pos:pos+4] != b'pai1': pos += size; continue
+        count,table = struct.unpack_from('<H',b,pos+14)[0],struct.unpack_from('<I',b,pos+16)[0]
+        assert count == 6
+        offsets = [struct.unpack_from('<I',b,pos+table+i*4)[0] for i in range(count)]
+        start = pos+offsets[-1]
+        assert b[start:start+28].split(b'\0')[0] == b'Pa_Button_05'
+        assert start+76 == pos+size
+        # Track headers and key offsets are relative to their own owner.
+        visible = b'FLVI'+bytes([1,0,0,0])+struct.pack('<I',12)
+        visible += struct.pack('<BBBBHHI',0,0,1,0,1,0,12)+struct.pack('<fHH',0,1,0)
+        position = b'FLPA'+bytes([1,0,0,0])+struct.pack('<I',12)
+        position += struct.pack('<BBBBHHI',0,1,2,0,2,0,12)
+        position += struct.pack('<ffffff',0,-32.5,-55,6,-362.5,-55)
+        entry = b'Pa_Button_05'.ljust(28,b'\0')+bytes([2,0,0,0])+struct.pack('<II',40,40+len(visible))+visible+position
+        delta = len(entry)-76
+        b[start:pos+size] = entry
+        struct.pack_into('<I',b,pos+4,size+delta)
+        struct.pack_into('<I',b,12,len(b))
+        return bytes(b)
+    raise AssertionError('title button animation missing')
+
+def add_exit_labels(data, text):
+    return rebuild(data, [(EXIT_LABEL,text)])
