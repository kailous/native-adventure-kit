+
+/* The socket is nonblocking; late ticks are dropped instead of queued. */
+static void *tel_worker(void *arg) {
+ (void)arg;
+ struct sockaddr_in dst={.sin_family=AF_INET,.sin_port=htons(TEL_PORT)};
+ dst.sin_addr.s_addr=htonl(INADDR_LOOPBACK);
+ uint64_t sequence=0;
+ while(atomic_load_explicit(&telemetry_active,memory_order_acquire)) {
+  runtime_control_network();
+  Snapshot snap=current_snapshot(runtime_now_ns());
+  telemetry_send_snapshot(&snap,sequence++,&dst);
+  struct timespec delay={.tv_sec=0,.tv_nsec=TEL_INTERVAL_NS};
+  nanosleep(&delay,NULL);
+ }
+ return NULL;
+}
+
+void telemetry_init(void) {
+ main_base=(uintptr_t)runtime_module_base("main");
+ runtime_control_init(main_base);
+ ncam_module=runtime_module_info("main");
+ if(!main_base) return;
+ snprintf(tel_session,sizeof tel_session,"mac-native-%ld-%llx",(long)getpid(),
+          (unsigned long long)runtime_now_ns());
+ fprintf(stderr,"[totk-telemetry] init: version=%s, version-selected adapter\n",TOTK_GAME_VERSION);
+}
+
+void telemetry_start(void) {
+ if(!main_base || atomic_load(&telemetry_active)) return;
+ tel_socket=telemetry_open_socket();
+ if(tel_socket<0)return;
+ runtime_control_start();
+ runtime_phone_motion_start();
+ atomic_store_explicit(&telemetry_active,1,memory_order_release);
+ int error=pthread_create(&tel_thread,NULL,tel_worker,NULL);
+ if(error) {
+  atomic_store(&telemetry_active,0);close(tel_socket);tel_socket=-1;
+  fprintf(stderr,"[totk-telemetry] pthread_create: %s\n",strerror(error));return;
+ }
+ pthread_detach(tel_thread);
+ fprintf(stderr,"[totk-telemetry] started: frame snapshots → UDP 127.0.0.1:%d, 10 Hz\n",TEL_PORT);
+}
