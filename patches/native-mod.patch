diff --git a/games/totk/runtime/boot_loading_view.h b/games/totk/runtime/boot_loading_view.h
new file mode 100644
index 0000000000000000000000000000000000000000..a1aae75d524035fe025f347a19e54eed721168c9
--- /dev/null
+++ b/games/totk/runtime/boot_loading_view.h
@@ -0,0 +1,168 @@
+/* Figma 70:12. Native game boot overlay; all progress is from real runtime callbacks.
+ * Asset source: games/totk/assets/branding/loading, copied into the game bundle.
+ * This view does not start the game, verify data, fabricate totals, or own Metal. */
+#pragma once
+#import <AppKit/AppKit.h>
+#import <CoreText/CoreText.h>
+#include <math.h>
+#include "game_version.h"
+#include "totk_ui_lang.h"
+
+/* execv runs the game from Contents/Resources/totk/build. Its main bundle may
+ * therefore be the executable directory, not the outer .app. Prefer verified
+ * local asset roots and retain the launcher's canonical game working directory. */
+static NSURL *boot_loading_asset_directory(void) {
+    NSFileManager *fm=NSFileManager.defaultManager;
+    NSURL *resource=NSBundle.mainBundle.resourceURL;
+    NSMutableArray<NSURL *> *folders=[NSMutableArray new];
+    if(resource){
+        [folders addObject:[resource URLByAppendingPathComponent:@"totk/assets/branding/loading" isDirectory:YES]];
+        [folders addObject:[[resource URLByDeletingLastPathComponent] URLByAppendingPathComponent:@"assets/branding/loading" isDirectory:YES]];
+        [folders addObject:[resource URLByAppendingPathComponent:@"assets/branding/loading" isDirectory:YES]];
+    }
+    NSURL *working=[NSURL fileURLWithPath:[fm.currentDirectoryPath stringByAppendingPathComponent:@"assets/branding/loading"] isDirectory:YES];
+    [folders addObject:working];
+    for(NSURL *folder in folders){
+        BOOL complete=YES;
+        for(NSString *name in @[@"background.png",@"logo.svg",@"footer.png"])if(![fm fileExistsAtPath:[folder URLByAppendingPathComponent:name].path]){complete=NO;break;}
+        if(complete)return folder;
+    }
+    return working;
+}
+
+@interface TOTKBootLoadingView : NSView
+@property(nonatomic,copy) NSString *stage;
+@property(nonatomic,copy) NSAttributedString *detail;
+@property(nonatomic) double fraction;
+@property(nonatomic) BOOL determinate;
+@property(nonatomic,readonly) NSString *percentageText;
+@property(nonatomic,readonly) BOOL assetsReady;
+-(instancetype)initWithFrame:(NSRect)frame assetDirectory:(NSURL *)directory;
+-(void)showStatus:(NSString *)stage detail:(NSString *)detail;
+-(void)showStage:(NSString *)stage done:(uint64_t)done total:(uint64_t)total bytes:(BOOL)bytes;
+-(void)showWarmDone:(uint64_t)done total:(uint64_t)total shaders:(uint64_t)shaders shaderTotal:(uint64_t)shaderTotal pipelines:(uint64_t)pipelines pipelineTotal:(uint64_t)pipelineTotal;
+@end
+
+@implementation TOTKBootLoadingView {
+    NSImage *_background, *_logo, *_footer;
+    NSFont *_brandMedium, *_brandLight, *_body, *_bodyBold, *_bodyMedium, *_bodyLight;
+    NSTimer *_activityTimer;
+    double _activityPhase;
+}
+-(BOOL)isFlipped { return YES; }
+-(BOOL)isOpaque { return YES; }
+-(NSView *)hitTest:(NSPoint)point { (void)point; return nil; }
+static NSFont *boot_font(NSArray<NSString *> *names, CGFloat size, NSFontWeight weight) {
+    for(NSString *name in names){ NSFont *font=[NSFont fontWithName:name size:size];if(font)return font; }
+    return [NSFont systemFontOfSize:size weight:weight];
+}
+-(instancetype)initWithFrame:(NSRect)frame assetDirectory:(NSURL *)directory {
+    if((self=[super initWithFrame:frame])){
+        _background=[[NSImage alloc] initWithContentsOfURL:[directory URLByAppendingPathComponent:@"background.png"]];
+        _logo=[[NSImage alloc] initWithContentsOfURL:[directory URLByAppendingPathComponent:@"logo.svg"]];
+        _footer=[[NSImage alloc] initWithContentsOfURL:[directory URLByAppendingPathComponent:@"footer.png"]];
+        _brandMedium=boot_font(@[@"Axiforma-Medium",@"Axiforma Medium"],20,NSFontWeightMedium);
+        _brandLight=boot_font(@[@"Axiforma-Light",@"Axiforma Light"],12,NSFontWeightLight);
+        _body=boot_font(@[@"OPPO_Sans_4.0_SC",@"OPPOSans4.0SC-Regular",@"OPPOSans4-SC",@"OPPOSans4.0SC",@"OPPOSans4SC-Regular"],20,NSFontWeightRegular);
+        _bodyBold=[NSFont fontWithName:@"OPPO_Sans_4.0_SC_Bold" size:20]?:[[NSFontManager sharedFontManager] convertFont:_body toHaveTrait:NSBoldFontMask];
+        _bodyMedium=[NSFont fontWithName:@"OPPO_Sans_4.0_SC_Medium" size:20]?:_body;
+        _bodyLight=[NSFont fontWithName:@"OPPO_Sans_4.0_SC_Light" size:20]?:_body;
+        self.wantsLayer=YES;
+        if(!_bodyBold)_bodyBold=[NSFont boldSystemFontOfSize:20];
+        _stage=@(TOTK_UI("正在启动游戏","Starting the game"));
+        _detail=[[NSAttributedString alloc] initWithString:@(TOTK_UI("正在准备游戏环境","Preparing the game environment"))];
+        self.autoresizingMask=NSViewWidthSizable|NSViewHeightSizable;
+        [self updateActivity];
+    }
+    return self;
+}
+-(BOOL)assetsReady { return _background&&_logo&&_footer; }
+-(NSString *)percentageText { return self.determinate?[NSString stringWithFormat:@"%.0f%%",floor(fmin(1,fmax(0,self.fraction))*100)]:@"…"; }
+-(void)updateActivity {
+    [_activityTimer invalidate];_activityTimer=nil;
+    if(self.determinate||self.hidden||NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion)return;
+    __weak TOTKBootLoadingView *weakSelf=self;
+    _activityTimer=[NSTimer scheduledTimerWithTimeInterval:1.0/30 repeats:YES block:^(NSTimer *timer){
+        TOTKBootLoadingView *view=weakSelf;
+        if(!view||view.hidden){[timer invalidate];return;}
+        view->_activityPhase=fmod(view->_activityPhase+1.0/90,1.0);view.needsDisplay=YES;
+    }];
+}
+-(void)setHidden:(BOOL)hidden { [super setHidden:hidden];[self updateActivity]; }
+-(void)setDeterminate:(BOOL)value { _determinate=value;[self updateActivity];self.needsDisplay=YES; }
+-(void)showStatus:(NSString *)stage detail:(NSString *)detail {
+    NSAssert(NSThread.isMainThread,@"boot UI belongs to the main thread");
+    self.stage=stage?:@"";self.detail=[[NSAttributedString alloc] initWithString:detail?:@""];
+    self.fraction=0;self.determinate=NO;self.needsDisplay=YES;
+}
+-(void)showStage:(NSString *)stage done:(uint64_t)done total:(uint64_t)total bytes:(BOOL)bytes {
+    if(!total){[self showStatus:stage detail:@(TOTK_UI("正在处理，请稍候","Working, please wait"))];return;}
+    self.stage=stage?:@"";self.determinate=YES;self.fraction=fmin(1,(double)done/(double)total);
+    BOOL verify=[stage containsString:@"校验"]||[stage containsString:@"验证"]||[stage rangeOfString:@"verif" options:NSCaseInsensitiveSearch].location!=NSNotFound;
+    NSString *prefix=verify?@(TOTK_UI("已验证 ","Verified ")):@(TOTK_UI("已处理 ","Processed "));
+    NSString *a=bytes?[NSString stringWithFormat:@"%.1f",done/1e9]:[NSString stringWithFormat:@"%llu",(unsigned long long)done];
+    NSString *b=bytes?[NSString stringWithFormat:@"%.1f",total/1e9]:[NSString stringWithFormat:@"%llu",(unsigned long long)total];
+    NSString *unit=bytes?@" GB":@(TOTK_UI(" 项"," items"));
+    NSMutableAttributedString *text=[[NSMutableAttributedString alloc] initWithString:prefix];
+    [text appendAttributedString:[[NSAttributedString alloc] initWithString:a attributes:@{@"BootNumber":@YES}]];
+    [text appendAttributedString:[[NSAttributedString alloc] initWithString:@" / " attributes:@{@"BootLight":@YES}]];
+    [text appendAttributedString:[[NSAttributedString alloc] initWithString:b attributes:@{@"BootNumber":@YES}]];
+    [text appendAttributedString:[[NSAttributedString alloc] initWithString:unit]];
+    self.detail=text;self.needsDisplay=YES;
+}
+-(void)showWarmDone:(uint64_t)done total:(uint64_t)total shaders:(uint64_t)shaders shaderTotal:(uint64_t)shaderTotal pipelines:(uint64_t)pipelines pipelineTotal:(uint64_t)pipelineTotal {
+    [self showStage:@(TOTK_UI("准备着色器与管线","Preparing shaders and pipelines")) done:done total:total bytes:NO];
+    NSMutableAttributedString *text=[self.detail mutableCopy];
+    [text appendAttributedString:[[NSAttributedString alloc] initWithString:[NSString stringWithFormat:@(TOTK_UI(" · 着色器 %llu/%llu · 管线 %llu/%llu"," · shaders %llu/%llu · pipelines %llu/%llu")),(unsigned long long)shaders,(unsigned long long)shaderTotal,(unsigned long long)pipelines,(unsigned long long)pipelineTotal]]];
+    self.detail=text;self.needsDisplay=YES;
+}
+static void boot_draw_image(NSImage *image, NSRect rect, BOOL cover) {
+    if(!image)return;
+    NSSize size=image.size;if(size.width<=0||size.height<=0)return;
+    CGFloat factor=cover?fmax(rect.size.width/size.width,rect.size.height/size.height):fmin(rect.size.width/size.width,rect.size.height/size.height);
+    NSRect drawn=NSMakeRect(NSMidX(rect)-size.width*factor/2,NSMidY(rect)-size.height*factor/2,size.width*factor,size.height*factor);
+    [NSGraphicsContext saveGraphicsState];NSRectClip(rect);
+    [image drawInRect:drawn fromRect:NSZeroRect operation:NSCompositingOperationSourceOver fraction:1 respectFlipped:YES hints:@{NSImageHintInterpolation:@(NSImageInterpolationHigh)}];
+    [NSGraphicsContext restoreGraphicsState];
+}
+static NSFont *boot_scaled_font(NSFont *font, CGFloat scale) { return [NSFont fontWithDescriptor:font.fontDescriptor size:font.pointSize*scale]; }
+static void boot_draw_text(NSString *text, NSFont *font, NSRect rect, NSLineBreakMode mode) {
+    NSMutableParagraphStyle *style=[NSMutableParagraphStyle new];style.lineBreakMode=mode;
+    [text drawInRect:rect withAttributes:@{NSFontAttributeName:font,NSForegroundColorAttributeName:NSColor.whiteColor,NSParagraphStyleAttributeName:style}];
+}
+-(void)drawRect:(NSRect)dirty {
+    (void)dirty;[NSColor.blackColor setFill];NSRectFill(self.bounds);
+    CGFloat width=self.bounds.size.width,height=self.bounds.size.height,scale=fmin(width/1920,height/1080);
+    if(scale<=0)return;
+    boot_draw_image(_background,self.bounds,YES);
+    boot_draw_image(_logo,NSMakeRect(50*scale,50*scale,254*scale,103*scale),NO);
+    NSFont *brand=boot_scaled_font(_brandMedium,scale),*light=boot_scaled_font(_brandLight,scale);
+    boot_draw_text(@"The Legend of Zelda\nTears of the Kingdom",brand,NSMakeRect(332*scale,55*scale,212*scale,52*scale),NSLineBreakByClipping);
+    boot_draw_text(@"For macOS\nv" TOTK_GAME_VERSION,light,NSMakeRect(332*scale,119*scale,212*scale,38*scale),NSLineBreakByClipping);
+    boot_draw_image(_footer,NSMakeRect(0,height-149*scale,width,149*scale),YES);
+    NSRect track=NSMakeRect(50*scale,height-99*scale,width-100*scale,5*scale);
+    NSBezierPath *path=[NSBezierPath bezierPathWithRoundedRect:track xRadius:2.5*scale yRadius:2.5*scale];
+    [[NSColor colorWithWhite:0 alpha:0.5] setFill];[path fill];
+    [NSGraphicsContext saveGraphicsState];[path addClip];
+    NSRect fill=track;
+    if(self.determinate)fill.size.width*=fmin(1,fmax(0,self.fraction));
+    else {fill.size.width*=0.22;fill.origin.x+=(_activityPhase*(1+0.22)-0.22)*track.size.width;}
+    [NSColor.whiteColor setFill];[[NSBezierPath bezierPathWithRoundedRect:fill xRadius:2.5*scale yRadius:2.5*scale] fill];
+    [NSGraphicsContext restoreGraphicsState];
+    NSFont *body=boot_scaled_font(_body,scale),*bold=boot_scaled_font(_bodyBold,scale),*medium=boot_scaled_font(_bodyMedium,scale),*lightBody=boot_scaled_font(_bodyLight,scale);
+    CGFloat y=height-74*scale,line=26*scale;
+    NSDictionary *attrs=@{NSFontAttributeName:body,NSForegroundColorAttributeName:NSColor.whiteColor};
+    NSString *percent=self.percentageText;NSSize percentSize=[percent sizeWithAttributes:@{NSFontAttributeName:medium}];CGFloat right=width-50*scale-percentSize.width;
+    boot_draw_text(percent,medium,NSMakeRect(right,y,percentSize.width+scale,line),NSLineBreakByClipping);
+    CGFloat maxStage=fmin(600*scale,fmax(0,right-50*scale-120*scale));
+    CGFloat stageWidth=fmin([self.stage sizeWithAttributes:attrs].width,maxStage);
+    boot_draw_text(self.stage,body,NSMakeRect(50*scale,y,stageWidth+scale,line),NSLineBreakByTruncatingTail);
+    CGFloat detailX=50*scale+stageWidth+22*scale,detailWidth=fmax(0,right-detailX-24*scale);
+    NSMutableAttributedString *detail=[self.detail mutableCopy];
+    NSMutableParagraphStyle *style=[NSMutableParagraphStyle new];style.lineBreakMode=NSLineBreakByTruncatingTail;
+    [detail addAttributes:@{NSFontAttributeName:body,NSForegroundColorAttributeName:NSColor.whiteColor,NSParagraphStyleAttributeName:style} range:NSMakeRange(0,detail.length)];
+    [self.detail enumerateAttribute:@"BootNumber" inRange:NSMakeRange(0,self.detail.length) options:0 usingBlock:^(id value,NSRange range,BOOL *stop){(void)stop;if(value)[detail addAttribute:NSFontAttributeName value:bold range:range];}];
+    [self.detail enumerateAttribute:@"BootLight" inRange:NSMakeRange(0,self.detail.length) options:0 usingBlock:^(id value,NSRange range,BOOL *stop){(void)stop;if(value)[detail addAttribute:NSFontAttributeName value:lightBody range:range];}];
+    [detail drawInRect:NSMakeRect(detailX,y,detailWidth,line)];
+}
+@end
diff --git a/games/totk/runtime/camera_math.h b/games/totk/runtime/camera_math.h
new file mode 100644
index 0000000000000000000000000000000000000000..02e5b740f4fdfc6829d9b33424c740aa405a42d1
--- /dev/null
+++ b/games/totk/runtime/camera_math.h
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Read-only LookAtCamera validator, kept equivalent to mod/telemetry/camera_math.hpp. */
+#pragma once
+#include <math.h>
+#include <string.h>
+#include <stdbool.h>
+typedef struct {bool available;double position[3],target[3],x,z;} NativeCameraSample;
+static NativeCameraSample native_camera_decode(const unsigned char* raw,const float* player) {
+ NativeCameraSample out={0};double p[3],a[3];float copies[6],up[3],matrix[12];
+ memcpy(p,raw+96,24);memcpy(a,raw+120,24);memcpy(copies,raw+56,24);memcpy(up,raw+80,12);memcpy(matrix,raw+8,48);
+ double near=0,length=0,upNorm=0;
+ for(int i=0;i<3;i++){
+  if(!isfinite(p[i])||!isfinite(a[i])||!isfinite(copies[i])||!isfinite(copies[i+3])||!isfinite(up[i])||!isfinite(player[i])||fabs(p[i])>20000||fabs(a[i])>20000)return out;
+  if(fabs(p[i]-copies[i])>.02||fabs(a[i]-copies[i+3])>.02)return out;
+  double d=a[i]-player[i];near+=d*d;d=a[i]-p[i];length+=d*d;upNorm+=up[i]*up[i];
+ }
+ if(near>2500||length<.01||length>10000||fabs(upNorm-1)>.03)return out;
+ length=sqrt(length);
+ for(int i=0;i<3;i++){
+  double norm=0;for(int j=0;j<3;j++){float v=matrix[i*4+j];if(!isfinite(v))return out;norm+=v*v;}
+  if(fabs(norm-1)>.03)return out;
+  for(int j=0;j<i;j++){double dot=0;for(int k=0;k<3;k++)dot+=matrix[i*4+k]*matrix[j*4+k];if(fabs(dot)>.03)return out;}
+ }
+ double agreement=0;for(int i=0;i<3;i++)agreement-=matrix[8+i]*(a[i]-p[i])/length;
+ if(agreement<.995)return out;
+ double dx=a[0]-p[0],dz=a[2]-p[2],horizontal=hypot(dx,dz);
+ if(horizontal<.01)return out;
+ out.available=true;out.x=dx/horizontal;out.z=dz/horizontal;memcpy(out.position,p,24);memcpy(out.target,a,24);return out;
+}
diff --git a/games/totk/runtime/camera_probe.h b/games/totk/runtime/camera_probe.h
new file mode 100644
index 0000000000000000000000000000000000000000..9c7d3b7595e329f58ea8cc1284841bf4e9aac470
--- /dev/null
+++ b/games/totk/runtime/camera_probe.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Worker-only, bounded camera discovery in loader module and guest heap.
+   Never uses actor orientation as a substitute for the camera. */
+#pragma once
+#include "camera_math.h"
+#include "runtime.h"
+static uintptr_t ncam_vtable,ncam_object,ncam_ro,ncam_heap;
+static bool ncam_ro_complete;
+static const Module *ncam_module;
+static unsigned char ncam_buffer[65536+32];
+static bool ncam_vtable_valid(uintptr_t address){
+ uintptr_t f[5];const Module *m=ncam_module;uintptr_t main=m?(uintptr_t)m->base:0;
+ if(!main||address<main+m->ro_off||address>main+m->key_off-40||!runtime_player_read(address,f,sizeof f)||f[4]!=main+CONTROL_CAMERA_METHOD)return false;
+ for(unsigned i=0;i<5;i++)if(f[i]<main||f[i]>=main+m->text_end)return false;
+ return true;
+}
+static void ncam_discover(void){
+ const Module *m=ncam_module;if(!m||!CONTROL_CAMERA_SUPPORTED)return;
+ uintptr_t main=(uintptr_t)m->base,end=main+m->key_off;
+ if(!ncam_ro)ncam_ro=main+m->ro_off;
+ size_t budget=1024*1024;
+ while(ncam_ro<end&&budget){
+  size_t size=end-ncam_ro;if(size>sizeof ncam_buffer)size=sizeof ncam_buffer;
+  if(runtime_player_read(ncam_ro,ncam_buffer,size))for(size_t off=0;off+40<=size;off+=8){
+   uintptr_t fn=0;memcpy(&fn,ncam_buffer+off+32,8);
+   if(fn==main+CONTROL_CAMERA_METHOD&&ncam_vtable_valid(ncam_ro+off)){ncam_vtable=ncam_ro+off;return;}
+  }
+  size_t advance=size>32?size-32:size;ncam_ro+=advance;budget=advance>budget?0:budget-advance;
+ }
+ ncam_ro_complete=ncam_ro>=end;
+}
+static NativeCameraSample ncam_read(uintptr_t address,const float player[3]){
+ NativeCameraSample empty={0};unsigned char raw[144];uintptr_t first=0,again=0;
+ if(!address||!ncam_vtable||!runtime_player_read(address,raw,sizeof raw))return empty;
+ memcpy(&first,raw,8);if(first!=ncam_vtable||!runtime_player_read(address,&again,8)||again!=first)return empty;
+ return native_camera_decode(raw,player);
+}
+static NativeCameraSample ncam_capture(const float player[3]){
+ NativeCameraSample out={0};if(!CONTROL_CAMERA_SUPPORTED)return out;
+ if(!ncam_vtable&&!ncam_ro_complete)ncam_discover();
+ if(!ncam_vtable)return out;
+ out=ncam_read(ncam_object,player);if(out.available)return out;ncam_object=0;
+ uintptr_t base=0;size_t size=0;runtime_guest_heap_range(&base,&size);
+ if(!base||!size||base>UINTPTR_MAX-size)return out;
+ uintptr_t end=base+size;if(ncam_heap<base||ncam_heap>=end)ncam_heap=base;
+ size_t budget=4*1024*1024;
+ while(ncam_heap<end&&budget){
+  size_t take=end-ncam_heap;if(take>65536)take=65536;if(take>budget)take=budget;
+  if(runtime_player_read(ncam_heap,ncam_buffer,take))for(size_t off=0;off+8<=take;off+=8){
+   uintptr_t pointer=0;memcpy(&pointer,ncam_buffer+off,8);
+   if(pointer!=ncam_vtable)continue;out=ncam_read(ncam_heap+off,player);
+   if(out.available){ncam_object=ncam_heap+off;ncam_heap=ncam_object+8;return out;}
+  }
+  ncam_heap+=take;budget-=take;
+ }
+ if(ncam_heap>=end)ncam_heap=base;
+ return out;
+}
