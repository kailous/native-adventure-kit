@@ -0,0 +1,29 @@
+"""The comparison must not confuse logged compile time with total frame time."""
+import importlib.util
+from pathlib import Path
+import unittest
+
+path=Path(__file__).resolve().parents[1]/'games/totk/scripts/verify_pipeline_rescan.py'
+spec=importlib.util.spec_from_file_location('pipeline_rescan_comparison',path)
+comparison=importlib.util.module_from_spec(spec);spec.loader.exec_module(comparison)
+
+
+class PipelineRescanReport(unittest.TestCase):
+    def test_filtered_long_frame_metrics(self):
+        text='''[totk-gfx] [长帧] 帧 7（0.2 s）整帧 120.5 ms，提交+出图 11.0 ms，GPU 2.0 ms；新建管线 3 条 + 着色器库 1 个共 10.2 ms；上传贴图 0
+[totk-gfx] [长帧] 帧 8（0.3 s）整帧 100.0 ms，提交+出图 3.0 ms，GPU 1.0 ms；新建管线 0 条 + 着色器库 0 个共 0.0 ms；上传贴图 0
+[dm] 上屏节奏 p50 8.33 ms
+'''
+        stats=comparison.facts(text)
+        self.assertEqual(stats['logged_long_frames'],2)
+        self.assertEqual(stats['over_100ms'],1)
+        self.assertEqual(stats['worst_logged_ms'],120.5)
+        self.assertEqual(stats['logged_compile_ms'],10.2)
+        self.assertEqual(stats['logged_pipeline_builds'],3)
+        self.assertNotIn('fps',stats)
+
+    def test_no_logged_frames_is_not_an_fps_measurement(self):
+        stats=comparison.facts('')
+        self.assertEqual(stats['logged_long_frames'],0)
+        self.assertEqual(stats['worst_logged_ms'],0)
+        self.assertNotIn('average_fps',stats)
