--- /dev/null
+++ b/games/totk/runtime/guest_memory.h
@@ -0,0 +1,14 @@
+#pragma once
+#include "player_state.h"
+static inline int runtime_guest_write(uintptr_t address,const void *value,size_t size){
+ if(!address||!size||address>UINTPTR_MAX-size||size>256)return 0;
+ if(vm_write(mach_task_self(),(vm_address_t)address,(vm_offset_t)value,(mach_msg_type_number_t)size)!=KERN_SUCCESS)return 0;
+ unsigned char copy[256];return runtime_player_read(address,copy,size)&&!memcmp(copy,value,size);
+}
+static inline int runtime_guest_writable(uintptr_t address,size_t size){
+ if(!address||!size||address>UINTPTR_MAX-size)return 0;
+ mach_vm_address_t base=address;mach_vm_size_t length=0;vm_region_basic_info_data_64_t info={0};mach_msg_type_number_t count=VM_REGION_BASIC_INFO_COUNT_64;mach_port_t object=MACH_PORT_NULL;
+ kern_return_t result=mach_vm_region(mach_task_self(),&base,&length,VM_REGION_BASIC_INFO_64,(vm_region_info_t)&info,&count,&object);
+ if(object!=MACH_PORT_NULL)mach_port_deallocate(mach_task_self(),object);
+ return result==KERN_SUCCESS&&address>=base&&address-base<length&&size<=length-(address-base)&&(info.protection&VM_PROT_WRITE);
+}
