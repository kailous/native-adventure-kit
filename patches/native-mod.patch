@@ -0,0 +1,30 @@
+/* Production present-time producer, with a private three-float data page. */
+#ifndef GAME_PATCHES_SOURCE
+#define GAME_PATCHES_SOURCE "../games/totk/runtime/game_patches_v143.c"
+#endif
+#include GAME_PATCHES_SOURCE
+static _Atomic uint64_t slots;
+static _Atomic uint32_t interval;
+static int check(const double *pattern, unsigned n) {
+    frame_step_data=&slots; frame_interval_data=&interval;
+    last_present_ns=0; frame_sample_count=frame_sample_next=0; atomic_store(&pinned_step_us,0);
+    uint64_t now=1000000000; runtime_frame_step_update(now);
+    double want=0, actual=0;
+    for(unsigned i=0;i<6000;i++) {
+        double dt=pattern[i%n]; now+=(uint64_t)(dt*1e9+0.5); runtime_frame_step_update(now);
+        uint64_t bits=atomic_load(&slots); float values[2]; memcpy(values,&bits,8);
+        actual+=values[1]; want+=fmin(dt,1.0/15.0);
+    }
+    if(fabs(want-actual)>0.21) { fprintf(stderr,"frame-time mismatch %.6f vs %.6f\n",actual,want);return 1; }
+    return 0;
+}
+int main(void) {
+    const double patterns[][16]={{1.0/120},{1.0/144},{1.0/160},{1.0/240},
+      {1.0/240,1.0/80},{.004,.0127},{1.0/288,1.0/96},{.003,.0045,.006},{1.0/240,1.0/240,1.0/60},
+      {1.0/120,1.0/120,1.0/120,.2},{.1}};
+    const unsigned counts[]={1,1,1,1,2,2,2,3,3,4,1};
+    for(unsigned i=0;i<sizeof counts/sizeof counts[0];i++) if(check(patterns[i],counts[i]))return 1;
+    runtime_frame_step_pin(10); uint64_t bits=atomic_load(&slots); float values[2];memcpy(values,&bits,8);
+    if(fabs(values[1]-.01)>1e-6)return 1;
+    puts("11 real-time patterns plus pinned timing passed");return 0;
+}
