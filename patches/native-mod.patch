+ nc_append(out,cap,&n,"\"spawn\":{\"available\":%s,\"catalogHash\":\"%s\",\"accepted\":%s,\"created\":%s,\"itemId\":%d,\"engineResult\":%d,\"position\":[%.5f,%.5f,%.5f]},",ns_available(nc_main,v->has_hp)?"true":"false",NC_CATALOG_HASH,ns_accepted?"true":"false",ns_created?"true":"false",ns_id,ns_result,ns_position[0],ns_position[1],ns_position[2]);
+ nc_append(out,cap,&n,"\"link\":{\"available\":%s,\"active\":%s,\"remainingMs\":%u,\"buttons\":%u,\"leftStick\":{\"x\":%.5f,\"y\":%.5f},\"rightStick\":{\"x\":%.5f,\"y\":%.5f}}}",input.available?"true":"false",input.active?"true":"false",input.remaining_ms,input.input.buttons,input.input.lx/32767.f,input.input.ly/32767.f,input.input.rx/32767.f,input.input.ry/32767.f);
