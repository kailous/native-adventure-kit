+"""External workspace for standalone host probes (no game saves)."""
+import os
+from pathlib import Path
+
+SOURCE_ROOT = Path(__file__).resolve().parents[3]
+
+
+def probe_work():
+    path = Path(os.environ.get('TOTK_TEST_WORK', '/tmp/totk-native-host-tests')).expanduser().resolve()
+    if path == SOURCE_ROOT or SOURCE_ROOT in path.parents:
+        raise ValueError('TOTK_TEST_WORK must be outside the MacNativeGames source checkout')
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def probe_binary(name):
+    path = probe_work() / 'host-tests' / name
+    path.parent.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def probe_report(name):
+    path = probe_work() / 'reports' / name
+    path.parent.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def probe_input():
+    """Explicit external native work tree for extracted assets and translator tools."""
+    value = os.environ.get('TOTK_TEST_INPUT')
+    if not value:
+        raise SystemExit('Set TOTK_TEST_INPUT to an external native work tree containing build/, extracted/ and tooling/')
+    path = Path(value).expanduser().resolve()
+    if path == SOURCE_ROOT or SOURCE_ROOT in path.parents:
+        raise ValueError('TOTK_TEST_INPUT must be outside the MacNativeGames source checkout')
+    if not path.is_dir():
+        raise ValueError(f'TOTK_TEST_INPUT does not exist: {path}')
+    return path
+
+
+def require_inputs(root, *names):
+    missing = [str(root / name) for name in names if not (root / name).is_file()]
+    if missing:
+        raise SystemExit('Missing verification inputs (not accepted):\n' + '\n'.join(missing))
+
+
+def run_metal_probe(arguments, **kwargs):
+    """Share the production GPU slot; give way to the user's game."""
+    import subprocess
+    import sys
+    driver = Path(__file__).resolve().parent / 'dev/game_slot.py'
+    command = [sys.executable, str(driver), 'run', '--no-retry',
+               '--purpose', 'standalone Metal shader compilation',
+               '--expect-seconds', '30', '--', str(probe_binary('metal-shader-probe'))]
+    return subprocess.run(command + [str(arg) for arg in arguments], **kwargs)
diff --git a/games/totk/scripts/probes/README.md b/games/totk/scripts/probes/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..7d027dd60055983db83df43102ac3b49a676a20f
--- /dev/null
+++ b/games/totk/scripts/probes/README.md
@@ -0,0 +1,25 @@
+# 原生探针（原生端诊断程序）
+
+- 每个探针是独立诊断程序或驱动脚本，**不改变运行时代码**；`games/totk/Makefile` 的 `probe-*` 目标负责编译与运行，`scripts/verify_*.py` 按此目录引用探针源码。
+- 需要游戏内证据的探针必须经 `scripts/dev/game_slot.py` 的单实例锁启动，使用隔离存档副本（含 account.uid），遵守用户接管规则（用户接管即中止，不关游戏）。
+- 证据输出到外层项目 `build/probes/native/<日期>-<场景>/`（report.json、game.log、wshot、input.txt），约定见外层 `docs/dual-runtime-workflow.md`。
+- `mouse_menu_probe.py` 是完整游戏内探针模板：GPU 门控环境、player-ready UDP 等待、TOTK_INPUT_FILE 命令流（key/mouse/wshot/hletrace/close）、GameSlot 接管检测。
+
+## 完整 App 短时检查
+
+`native_app_smoke.py --app EXTERNAL_APP --evidence EXTERNAL_EVIDENCE --seconds 240` 核对 App 为 1.4.3，复制用户现有 profile（包括 account.uid），经生产 GameSlot 启动右下角 512×288 窗口。隔离数据保存在用户数据 tests 目录；截图与日志写入显式指定的外部证据目录。检测真实输入后停止自动化并保留游戏。报告 observed 只表示已收集证据，需要人工核对截图、读档和帧推进，不能当作全功能或性能验收。
+
+## 独立宿主探针输出与输入
+
+- Python 驱动统一使用 `scripts/probe_paths.py`：`TOTK_TEST_WORK` 默认 `/tmp/totk-native-host-tests`，二进制在 `host-tests/`，报告在 `reports/`；拒绝指向本源码仓库内的输出目录。
+- 需要游戏派生数据的 Python 驱动设置 `TOTK_TEST_INPUT` 为外部原生工作树（包含 `build/`、`extracted/` 等）；不依赖外层项目固定路径，不回写输入。缺少原始样本时明确退出，不能写成通过。
+- Make 的线程、输入、自动读档、电影探针使用 `HOST_TEST_WORK`（同样默认 `/tmp/totk-native-host-tests`）；纹理布局和 depth16 探针使用 `RENDER_PROBE_DIR`。两者支持路径中的空格。Python 的 `TOTK_TEST_WORK` 和 Make 的 `HOST_TEST_WORK` 是各自入口的覆盖参数，按需设置为同一路径。
+- `metal_shader_probe.m` 只验证 Metal library 编译，不代表渲染或游戏场景通过；着色器 Python 驱动经现有 `game_slot.py` 获取 GPU 单实例锁。
+- 电影的 `buffers` 检查要求至少占满 8 个输出槽；`paced` 检查需要超过 5 秒，才能进入其低帧率阶段并检查丢帧。短样本不能替代完整探针断言。
+- 路径回归：`python3 -B -m unittest discover -s games/totk/tests -p test_probe_paths.py`（在仓库根运行）。账号检查：`python3 -B games/totk/scripts/verify_account.py`。
+
+2026-10-22 复验：账号、线程、输入、自动读档正反例和纹理布局通过；电影十秒样本两模式及三种负例通过；Metal 编译正反例、EASU 12 例和顶点计数 96 例及负例通过。均属宿主/离屏验证，没有启动游戏。四个历史像素着色器和 FP64 历史样本组缺少原始 inventory / 失败清单 / shader-map，仍未验收。
+
+## 键鼠宿主回归
+
+`mouse_look_probe.c` 验证视角衰减、限幅与六轴输入；`mouse_mode_probe.m` 编译真实 gamepad.m，验证默认按钮、射箭组合、释放、持久化及六轴开关；`mouse_front_probe.m` 编译真实 frontend.m，替换系统指针 API，验证失焦/文字输入释放、用户接管通知和光标隐藏计数。入口为原生仓库根 `python -B -m unittest discover -s tests -p test_mouse.py`；输出为独立临时目录，不操作真实指针或游戏。使用说明见 `docs/mouse-controls.md`。
