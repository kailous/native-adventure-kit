+ }
+ runtime_input_key_synthetic(26,1);runtime_input_key_synthetic(26,1);
+ assert(mouse_toggles==1); // repeat does not toggle
+ runtime_input_key_synthetic(26,0);runtime_input_key_synthetic(26,1);runtime_input_key_synthetic(26,0);
+ assert(mouse_toggles==2);
+ assert(fps_overlay_full_hud()); // no display hotkeys
