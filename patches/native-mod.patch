@@ -0,0 +1,69 @@
+"""Native in-game layout row, localized messages and guarded enum counts."""
+import importlib.util
+from pathlib import Path
+import struct
+import re
+import subprocess
+import tempfile
+import unittest
+ROOT=Path(__file__).resolve().parents[1]
+TOTK=ROOT/'games/totk'
+spec=importlib.util.spec_from_file_location('layout_menu',TOTK/'scripts/settings_menu_data.py')
+menu=importlib.util.module_from_spec(spec);spec.loader.exec_module(menu)
+class LayoutMenuTests(unittest.TestCase):
+ def test_option_table_and_interpolation_choices(self):
+  names=[None,'None','IsCameraUpDownReverse','IsCameraRightLeftReverse','CameraRotateSpeed','IsUseGyro','None','IsSpecialPowerRotateUpDownReverse','IsSpecialPowerRotateRightLeftReverse','IsChangeJumpButton','None','IsLockMiniMapUpper','DisplayMode','IsDisplayTextRuby','MessageWindowTransparency','VoiceLanguage']
+  rows=[]
+  for name in names:
+   if name is None: rows.append(menu.Dict([('ButtonType',0xA0,'Button'),('ChoiceType',0xC0,['UseAmiibo','UnuseAmiibo'])]))
+   elif name=='None':rows.append(menu.Dict([('ButtonType',0xA0,'Separator'),('OptionType',0xA0,'None')]))
+   else:rows.append(menu.Dict([('ButtonType',0xA0,'Toggle'),('OptionType',0xA0,name)]))
+  root=menu.Dict([('OptionSetArray',0xC0,rows)])
+  strings=sorted({'Toggle','Selection','Button','Separator','UseAmiibo','UnuseAmiibo',*[p[2] for r in rows for p in r.pairs if isinstance(p[2],str)]})
+  original=menu.build(root,strings,sorted(['OptionSetArray','ButtonType','OptionType','ChoiceType']))
+  result,_,_=menu.parse_table(menu.add_fullscreen_row(original))
+  by_name={dict((k,v) for k,t,v in row.pairs)['OptionType']:dict((k,v) for k,t,v in row.pairs) for row in result.pairs[0][2] if any(k=='OptionType' for k,t,v in row.pairs)}
+  self.assertEqual(by_name['NativeControllerLayout']['ChoiceType'],['NativeLayoutCustom','NativeLayoutSwitch','NativeLayoutXbox'])
+  self.assertEqual(len(by_name['NativeInterpolation']['ChoiceType']),4)
+  reordered=result.pairs[0][2]
+  self.assertEqual(len(reordered),26)
+  actual=[]
+  for row in reordered:
+   values={k:v for k,t,v in row.pairs}
+   if values.get('ButtonType')=='Separator':actual.append('|')
+   else:actual.append(values.get('OptionType','__amiibo__'))
+  expected=[]
+  for index,(_,names) in enumerate(menu.SETTINGS_GROUPS):
+   if index:expected.append('|')
+   expected.extend(names)
+  self.assertEqual(actual,expected)
+  self.assertEqual(actual[0],'__amiibo__')
+ def test_guarded_enum_bounds(self):
+  text=(TOTK/'runtime/display_enum_v143.h').read_text().split('display_enum_bounds[] = {',1)[1]
+  entries=re.findall(r'\{0x([0-9a-f]+),0x([0-9a-f]+),0x([0-9a-f]+)\}',text)
+  self.assertEqual(len(entries),15)
+  for at,original,replacement in entries:
+   old,new=int(original,16),int(replacement,16)
+   if old==0x5280028f:self.assertEqual((new>>5)&65535,36)
+   else:
+    immediate=(old>>10)&4095
+    self.assertEqual((new>>10)&4095,{15:24,19:35,20:36}[immediate])
+    self.assertEqual(old&~(4095<<10),new&~(4095<<10))
+ def test_messages(self):
+  header=bytearray(32);header[:8]=b'MsgStdBn';struct.pack_into('<H',header,14,2)
+  for tag,data in [(b'LBL1',struct.pack('<III',1,0,12)),(b'TXT2',struct.pack('<I',0))]:
+   header+=tag+struct.pack('<I',len(data))+bytes(8)+data
+   header+=bytes((-len(header))%16)
+  struct.pack_into('<I',header,18,len(header))
+  original=menu.rebuild(bytes(header),[('old'+str(i),'original') for i in range(56)])
+  for lang in ['CNzh','TWzh','EUen','JPja']:
+   result=menu.add_fullscreen_labels(original,'Full screen','help',lang)
+   _,groups,_=menu.parse_lbl1(result);labels={k:v for group in groups for k,v in group};_,texts,_=menu.parse_txt2(result)
+   self.assertEqual(menu.utf16_text(texts[labels['1023_02']]),'Xbox')
+ def test_display_callbacks(self):
+  with tempfile.TemporaryDirectory() as tmp:
+   binary=Path(tmp)/'display'
+   build=subprocess.run(['xcrun','clang','-std=c11','-Wno-unused-function','-I'+str(TOTK/'third_party/d2r_gfx/gfx/nvn/include'),'-ffunction-sections','-Wl,-dead_strip',str(TOTK/'tests/display_settings_test.c'),'-o',str(binary)],capture_output=True,text=True)
+   self.assertEqual(build.returncode,0,build.stderr[-3000:])
+   run=subprocess.run([str(binary)],capture_output=True,text=True)
+   self.assertEqual(run.returncode,0,run.stdout+run.stderr)
