@@ -0,0 +1,85 @@
+/* Real frontend capture/release routing; cursor APIs are replaced, never warp or
+   hide the user's pointer. The window is never ordered front or made key. */
+#import <Cocoa/Cocoa.h>
+#import <ApplicationServices/ApplicationServices.h>
+#include <assert.h>
+static int hides, associations=1, warps, releases, activity, movement, heldButtons, mode;
+@interface ProbeCursor:NSObject
++(void)hide;
++(void)unhide;
+@end
+@implementation ProbeCursor
++(void)hide{hides++;}
++(void)unhide{hides--;assert(hides>=0);}
+@end
+static CGError probe_warp(CGPoint point){(void)point;warps++;return kCGErrorSuccess;}
+static CGError probe_associate(boolean_t on){associations=on;return kCGErrorSuccess;}
+#define NSCursor ProbeCursor
+#define CGWarpMouseCursorPosition probe_warp
+#define CGAssociateMouseAndMouseCursorPosition probe_associate
+#include "../../runtime/frontend.m"
+
+int runtime_mouse_enabled(void){return mode;}
+void runtime_mouse_move(double dx,double dy){assert(dx==3&&dy==-2);movement++;}
+void runtime_mouse_button(int button,int down){if(down)heldButtons|=1<<button;else heldButtons&=~(1<<button);}
+void runtime_mouse_release(void){heldButtons=0;releases++;}
+void runtime_input_mouse_activity(void){activity++;}
+void runtime_input_clear(void){}
+uint64_t runtime_now_ns(void){return 1000000000;}
+void runtime_oe_push_message(uint32_t message){(void)message;}
+
+@interface ProbeWindow:NSWindow
+@property BOOL keyboard;
+@end
+@implementation ProbeWindow
+-(BOOL)isKeyWindow{return self.keyboard;}
+@end
+@interface ProbeMotion:NSObject
+@end
+@implementation ProbeMotion
+-(CGFloat)deltaX{return 3;}
+-(CGFloat)deltaY{return -2;}
+-(NSInteger)buttonNumber{return 4;}
+@end
+
+int main(void){@autoreleasepool{
+ [NSApplication sharedApplication];
+ ProbeWindow *w=[[ProbeWindow alloc] initWithContentRect:NSMakeRect(0,0,512,288)
+     styleMask:NSWindowStyleMaskTitled backing:NSBackingStoreBuffered defer:YES];
+ window=w;TOTKInputView *view=[[TOTKInputView alloc] initWithFrame:w.contentView.bounds];w.contentView=view;
+ NSEvent *event=(NSEvent *)[ProbeMotion new];
+ front_mouse_update();assert(!mouseHeld&&associations&&!warps);
+ mode=1;front_mouse_update();assert(!mouseHeld); // no keyboard: no capture
+ w.keyboard=YES;view.cursorIsHidden=YES;hides=1; // old fullscreen idle-hide must be balanced
+ front_mouse_update();assert(mouseHeld&&!associations&&hides==1&&warps==1&&!view.cursorIsHidden);
+ [view mouseMoved:event];[view mouseDragged:event];[view rightMouseDragged:event];[view otherMouseDragged:event];
+ assert(movement==4&&activity==4);
+ [view mouseDown:event];[view rightMouseDown:event];[view otherMouseDown:event];
+ assert(heldButtons==19&&activity==7);
+ [view mouseUp:event];[view rightMouseUp:event];[view otherMouseUp:event];assert(!heldButtons);
+ [view mouseDown:event];w.keyboard=NO;front_mouse_update();
+ assert(!mouseHeld&&associations&&!hides&&!heldButtons&&releases==1);
+ int before=activity;[view mouseMoved:event];[view mouseDown:event];assert(activity==before);
+ w.keyboard=YES;front_mouse_update();assert(mouseHeld);
+ textEntryOpen=1;front_mouse_update();assert(!mouseHeld&&associations&&!hides);
+ textEntryOpen=0;front_mouse_update();assert(mouseHeld);
+ mode=0;front_mouse_update();assert(!mouseHeld&&associations&&!hides&&releases==3);
+ [view.cursorHideTimer invalidate];
+ NSString *game=[[@(__FILE__) stringByDeletingLastPathComponent] stringByDeletingLastPathComponent];game=[game stringByDeletingLastPathComponent];
+ NSURL *assets=[NSURL fileURLWithPath:[game stringByAppendingPathComponent:@"assets/branding/loading"] isDirectory:YES];
+ bootOverlay=[[TOTKBootLoadingView alloc] initWithFrame:NSMakeRect(0,0,512,288) assetDirectory:assets];
+ assert(bootOverlay.assetsReady);[w.contentView addSubview:bootOverlay];
+ runtime_boot_count("验证资源",4,10);[NSRunLoop.currentRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.02]];
+ assert([bootOverlay.percentageText isEqualToString:@"40%"]);
+ runtime_boot_count("加载资源",0,0);[NSRunLoop.currentRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.02]];
+ assert(!bootOverlay.determinate);
+ runtime_boot_progress("校验游戏资源",2000000000,10000000000);[NSRunLoop.currentRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.02]];
+ assert([bootOverlay.percentageText isEqualToString:@"20%"]&&[bootOverlay.detail.string containsString:@"2.0 / 10.0 GB"]);
+ runtime_warm_progress(5,10,3,5,2,5);front_frame_presented();[NSRunLoop.currentRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.02]];
+ assert(!bootOverlay.hidden&&[bootOverlay.percentageText isEqualToString:@"50%"]);
+ runtime_warm_done();[NSRunLoop.currentRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.02]];assert(bootOverlay.hidden);
+ runtime_boot_count("late callback",8,10);[NSRunLoop.currentRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.02]];assert(bootOverlay.hidden);
+
+ puts("{\"status\":\"pass\",\"probe\":\"mouse-front\",\"scope\":\"real frontend routing; fake cursor APIs and key state, no real pointer capture\"}");
+ return 0;
+}}
diff --git a/games/totk/scripts/probes/mouse_look_probe.c b/games/totk/scripts/probes/mouse_look_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..786f1e09772d7d102616a31b66f60af9dec98fa2
--- /dev/null
+++ b/games/totk/scripts/probes/mouse_look_probe.c
@@ -0,0 +1,90 @@
+// runtime/mouse_look.h: mouse movement as a right stick that decays (the yuzu-style "mouse panning" idea) and as a gyro.
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "mouse_look.h"
+
+static int failures, checked;
+static void check(int ok, const char *what) { checked++; if (!ok) { failures++; fprintf(stderr, "FAIL: %s\n", what); } }
+static int near(double a, double b, double tol) { return fabs(a - b) <= tol; }
+
+typedef struct { int32_t rx, ry; double gyro[3], acc[3]; } Tick;
+static Tick tick(MouseLook *m, const MouseLookSettings *s) { Tick t; mouse_look_tick(m, s, &t.rx, &t.ry, t.gyro, t.acc); return t; }
+
+int main(void) {
+    const MouseLookSettings s = mouse_look_settings(NULL, NULL, NULL, NULL, NULL);
+    check(s.sensitivity == 50 && s.counterweight == 20 && s.decay == 18 && s.min_decay == 6 && !s.invert_y,
+          "defaults: sensitivity 50, dead-zone counterweight 20, decay 18, minimum decay 6");
+    MouseLook m = {0};
+    Tick t = tick(&m, &s);
+    check(t.rx == 0 && t.ry == 0 && t.gyro[0] == 0 && t.gyro[2] == 0 && near(t.acc[2], -1, 1e-9) && t.acc[0] == 0 && t.acc[1] == 0,
+          "still: centred, no rotation, lying face up (z = -1 G)");
+
+    // 10 points right at sensitivity 50: 0.5 of the stick's range, shown on the next tick, then decaying.
+    mouse_look_move(&m, 10, 0, &s);
+    t = tick(&m, &s);
+    check(abs(t.rx - 16384) <= 1 && t.ry == 0, "10 points right: half the stick right");
+    Tick u = tick(&m, &s);
+    check(u.rx > 0 && u.rx < t.rx && u.rx > t.rx * 0.9, "no more movement: it decays (by 1 - 0.5^2 * 18%)");
+    for (int i = 0; i < 200; i++) u = tick(&m, &s);
+    check(u.rx == 0 && u.ry == 0, "and comes back to the centre (minimum decay 6% a tick)");
+
+    // The counterweight lifts a tiny movement over the game's own dead zone; the length is held at 1.5, shown at most 1.
+    mouse_look_move(&m, 0.5, 0, &s);
+    t = tick(&m, &s);
+    check(abs(t.rx - 6553) <= 2, "half a point: lifted to the counterweight, 20% of the range");
+    MouseLook f = {0};
+    mouse_look_move(&f, 0, 100, &s);
+    t = tick(&f, &s);
+    check(t.ry == -32767 && t.rx == 0, "100 points down: the stick fully down (AppKit's deltaY grows downwards)");
+    check(near(hypot(f.x, f.y), 1.5 * (1 - 0.18), 1e-9), "the held length is cut to 1.5, then decays with the full 18%");
+    MouseLook d = {0};
+    mouse_look_move(&d, 100, -100, &s);
+    t = tick(&d, &s);
+    check(t.rx == t.ry && t.rx > 23000 && hypot(t.rx, t.ry) <= 32767.5, "a fast diagonal: up-right on the stick's circle");
+
+    // Steady movement: equilibrium where the decay takes out what the mouse adds.
+    MouseLook e = {0};
+    for (int i = 0; i < 100; i++) { mouse_look_move(&e, 1, 0, &s); t = tick(&e, &s); }
+    check(t.rx > 6553 && t.rx < 32767, "slow steady movement (100 pt/s): a steady partial turn");
+
+    // Sensitivity and inverted Y.
+    MouseLookSettings inv = mouse_look_settings("100", "1", NULL, NULL, NULL);
+    check(inv.sensitivity == 100 && inv.invert_y == 1, "settings from the environment");
+    MouseLook v = {0};
+    mouse_look_move(&v, 0, 5, &inv);
+    t = tick(&v, &inv);
+    check(abs(t.ry - 16384) <= 1 && t.rx == 0, "sensitivity 100 doubles; inverted Y turns down into up");
+
+    // Gyro: per tick, yaw = -dx and pitch = -dy (points * sensitivity / 1000 * 2.5 rev/s), capped at 2 rev/s.
+    MouseLook g = {0};
+    mouse_look_move(&g, 4, -2, &s);
+    t = tick(&g, &s);
+    check(near(t.gyro[2], -4 * 0.05 * 2.5 * 2 * M_PI, 1e-6) && near(t.gyro[0], 2 * 0.05 * 2.5 * 2 * M_PI, 1e-6) && t.gyro[1] == 0,
+          "mouse right turns the controller clockwise seen from above (-z); mouse up tilts its top edge up (+x)");
+    check(near(t.acc[1], -sin(t.gyro[0] * 0.01), 1e-9) && near(t.acc[2], -cos(t.gyro[0] * 0.01), 1e-9),
+          "gravity follows the pitch, so the sensor fusion does not pull the aim back");
+    t = tick(&g, &s);
+    check(t.gyro[0] == 0 && t.gyro[2] == 0, "the gyro reads only the movement of its own tick");
+    mouse_look_move(&g, 1000, 0, &s);
+    t = tick(&g, &s);
+    check(near(fabs(t.gyro[2]), 2 * 2 * M_PI, 1e-6), "a very fast turn: capped at 2 revolutions a second");
+    MouseLook p = {0};
+    for (int i = 0; i < 100; i++) { mouse_look_move(&p, 0, -1000, &s); tick(&p, &s); }
+    check(near(p.pitch, 80 * M_PI / 180, 1e-9), "the pitch used for gravity stops at 80 degrees");
+
+    // Junk, reset and out-of-range settings.
+    MouseLook j = {0};
+    mouse_look_move(&j, NAN, 3, &s); mouse_look_move(&j, INFINITY, 0, &s);
+    t = tick(&j, &s);
+    check(t.rx == 0 && t.ry == 0 && t.gyro[2] == 0, "non-finite movement is dropped");
+    mouse_look_move(&j, 50, 50, &s); mouse_look_reset(&j);
+    t = tick(&j, &s);
+    check(t.rx == 0 && t.ry == 0 && t.gyro[0] == 0 && near(t.acc[2], -1, 1e-9), "reset: centred and lying flat again");
+    MouseLookSettings bad = mouse_look_settings("0", "2", "101", "x", "-1");
+    check(bad.sensitivity == 50 && bad.invert_y == 0 && bad.counterweight == 20 && bad.decay == 18 && bad.min_decay == 6,
+          "out-of-range settings keep the defaults");
+
+    printf("{\"status\":\"%s\",\"probe\":\"mouse-look\",\"checked\":%d,\"failures\":%d}\n", failures ? "fail" : "pass", checked, failures);
+    return failures != 0;
+}
diff --git a/games/totk/scripts/probes/mouse_menu_probe.py b/games/totk/scripts/probes/mouse_menu_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..c2202d0e2f35123c87bf83a1f9f79d972ee624c3
--- /dev/null
+++ b/games/totk/scripts/probes/mouse_menu_probe.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+"""In-game probe: does the 1.4.3 pause menu consume the hid mouse?
+
+Runs the candidate native binary with TOTK_MOUSE=1 on an isolated copied save
+(company window: 512x288 bottom-right, fullscreen inhibited, GPU paths gated
+like verify_pipeline_rescan.py). Evidence written to --output: hletrace counts
+while the pause menu is open (does the game call GetMouseStates?), plus wshots
+after pointer/click injections. The game is closed at the end unless the user
+takes over; never touches the player's save.
+"""
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import socket
+import struct
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'dev'))
+from game_slot import GameSlot
+
+
+def player_ready(deadline, check):
+    request = 1
+    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
+        sock.settimeout(0.3)
+        while time.monotonic() < deadline:
+            check()
+            sock.sendto(struct.pack("<4sBBBBQd", b"TKC1", 1, 0, 0, 0, request, 0), ("127.0.0.1", 7075))
+            request += 1
+            try:
+                state = json.loads(sock.recvfrom(8192)[0])
+                if state.get("code") == 0 and state.get("link", {}).get("available"):
+                    return time.monotonic()
+            except (socket.timeout, ValueError):
+                pass
+            time.sleep(0.2)
+    raise RuntimeError("timed out waiting for player-ready status")
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    for name in ("binary", "work", "output", "profile-source", "profile-root", "slot"):
+        p.add_argument("--" + name, type=Path, required=True)
+    args = p.parse_args()
+    for key, value in vars(args).items():
+        if isinstance(value, Path):
+            setattr(args, key, value.expanduser().resolve())
+    if not args.profile_root.is_relative_to(Path.home() / "Library/Application Support/MacNativeGames/TOTK/tests"):
+        p.error("profile-root must be below the dedicated TOTK/tests folder")
+    if (args.output / "report.json").exists():
+        p.error("output already has probe evidence")
+
+    profile = args.profile_root / "mouse-menu-20261022"
+    if profile.exists():
+        shutil.rmtree(profile)
+    profile.mkdir(parents=True)
+    shutil.copytree(args.profile_source / "save", profile / "save")
+    shutil.copy2(args.profile_source / "account.uid", profile / "account.uid")
+    (profile / "native-display.cfg").write_text("3 2 1 0 0 0 0 0 0 0\n")
+
+    args.output.mkdir(parents=True, exist_ok=True)
+    commands = args.output / "input.txt"
+    commands.write_text("")
+    env = os.environ | dict(
+        TOTK_PROFILE_DIR=str(profile),
+        TOTK_SHADER_CACHE=str(profile / "shader-cache"),
+        TOTK_SHADER_SEED_DIR=str(args.work / "build/shader-seed/v143"),
+        TOTK_INPUT_FILE=str(commands),
+        TOTK_MOUSE="1",
+        TOTK_WINDOW_SIZE="512x288",
+        TOTK_WINDOW_ANCHOR="bottom-right",
+        TOTK_FULLSCREEN_TEST_INHIBIT="1",
+        TOTK_ASSUME_FOCUS="1",
+        TOTK_AUTOLOAD="1",
+        TOTK_UI_LANG="zh",
+        TOTK_MENUBAR_FPS="0",
+        TOTK_TITLE_FPS="0",
+        TOTK_GPU_ALLOW_SUBMIT="1",
+        TOTK_GPU_WIDEN="1",
+        TOTK_GPU_BLOCKRT="1",
+        TOTK_GPU_MIDCLEAR="1",
+        TOTK_GPU_BUDGET_MB="5000",
+        DM_PSO_MANIFEST="off",
+        TOTK_PIPELINE_ARCHIVE="0",
+        TOTK_PSO_PREDICT_KEYS="64",
+        TOTK_PSO_RESCANS="32",
+        TOTK_GAME_SLOT_DIR=str(args.slot),
+    )
+    for name in ("TOTK_INPUT_SCRIPT", "TOTK_SURVEY", "DM_NVN_TSV", "TOTK_SHADER_PREFETCH"):
+        env.pop(name, None)
+    report = dict(binary=str(args.binary), sha256=hashlib.sha256(args.binary.read_bytes()).hexdigest(),
+                  profile=str(profile), status="starting", events=[])
+    report_path = args.output / "report.json"
+    report_path.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
+    logpath = args.output / "game.log"
+    started = time.monotonic()
+    taken = False
+    with GameSlot(owner="qoder", purpose="mouse menu probe", expect_seconds=215) as slot:
+        with logpath.open("wb") as log:
+            game = slot.popen([str(args.binary), "rewritten/v143", "boot"], cwd=args.work, env=env,
+                              stdout=log, stderr=log)
+        report.update(pid=game.pid, token=slot.token, status="running")
+        report_path.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
+
+        def check():
+            nonlocal taken
+            text = logpath.read_text(errors="replace")
+            if slot.preempted or "[input] user input" in text:
+                taken = True
+                raise RuntimeError("user takeover: no further control, game left open")
+            if game.poll() is not None:
+                raise RuntimeError("game exited: " + str(game.returncode))
+            return text
+
+        def send(command):
+            check()
+            with commands.open("a") as f:
+                f.write(command + "\n")
+            report["events"].append(dict(at=round(time.monotonic() - started, 2), command=command))
+            report_path.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
+
+        try:
+            ready = player_ready(started + 150, check)
+            report["player_ready_seconds"] = round(ready - started, 1)
+            send(f"wshot {args.output / '00-ready.png'}")
+            # Trace what the game calls while the pause menu opens, then dump the counts.
+            send("hletrace 2")
+            send("key 36 150")  # Plus: open the pause menu
+            time.sleep(3)
+            send(f"wshot {args.output / '01-menu-open.png'}")
+            send("hletrace 0")
+            time.sleep(0.5)
+            # Pointer to the centre, then left clicks at candidate spots.
+            send("mouse 640 360 0 1500")
+            time.sleep(2)
+            send(f"wshot {args.output / '02-mouse-centre.png'}")
+            for x, y in ((200, 360), (640, 360), (1040, 360), (640, 600)):
+                send(f"mouse {x} {y} 1 150")
+                time.sleep(1.5)
+                send(f"wshot {args.output / f'03-click-{x}-{y}.png'}")
+            # Idle-menu trace: per-frame mouse reads would show as a high count.
+            send("hletrace 2")
+            time.sleep(2)
+            send("hletrace 0")
+            send("close")
+            game.wait(timeout=25)
+            text = logpath.read_text(errors="replace")
+            report.update(status="closed", exit_code=game.returncode,
+                          hle_lines=[line for line in text.splitlines() if line.startswith("[hle]")],
+                          mouse_lines=[line for line in text.splitlines() if "ouse" in line],
+                          input_commands=commands.read_text())
+        except Exception as error:
+            report.update(status="user-takeover" if taken else "failed", error=str(error))
+            if not taken and game.poll() is None:
+                with commands.open("a") as f:
+                    f.write("close\n")
+                try:
+                    game.wait(timeout=25)
+                except Exception:
+                    pass
+        finally:
+            report_path.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/games/totk/scripts/probes/mouse_mode_probe.m b/games/totk/scripts/probes/mouse_mode_probe.m
new file mode 100644
index 0000000000000000000000000000000000000000..3610d929522afcf8c34c3335496d8d43e70264f4
--- /dev/null
+++ b/games/totk/scripts/probes/mouse_mode_probe.m
@@ -0,0 +1,92 @@
+/* runtime/gamepad.m's mouse mode (key 7): buttons through the controller layout, movement as the right stick and the gyro,
+   release, and the saved on / off. The real file is compiled in; the 10 ms ticks are driven here (mouseTicksByHand). */
+#include "../../runtime/gamepad.m"
+
+_Noreturn void runtime_fail(const char *message) { fprintf(stderr, "FAIL: %s\n", message); exit(1); }
+static InputObserver testObserver=INPUT_OBSERVER_INIT;
+void runtime_observe_input(unsigned s,uint64_t b,int32_t x,int32_t y,int32_t rx,int32_t ry){io_update(&testObserver,s,b,x,y,rx,ry,runtime_now_ns());}
+static uint64_t clockNow = 1000000000ull;
+uint64_t runtime_now_ns(void) { return clockNow; }
+void runtime_feedback_attach(GCController *controller) { (void)controller; }
+void runtime_feedback_detach(GCController *controller) { (void)controller; }
+void runtime_feedback_quiet(void) {}
+static int gyroOn = 1, motionMouse = -1, feeds, hookCalls;
+static double lastYaw, lastAcc;
+int runtime_gyro_enabled(void) { return gyroOn; }
+void runtime_motion_mouse(int on) { motionMouse = on; }
+void runtime_motion_feed_mouse(const double acc[3], const double gyro[3], uint64_t now) { (void)now; feeds++; lastYaw = gyro[2]; lastAcc = acc[2]; }
+static void hook(void) { hookCalls++; }
+
+static int failures, checked;
+static void check(int ok, const char *what) { checked++; if (!ok) { failures++; fprintf(stderr, "FAIL: %s\n", what); } }
+static int file_says(const char *path, const char *text) {
+    char got[64] = {0}; FILE *f = fopen(path, "r"); if (!f) return 0;
+    size_t n = fread(got, 1, sizeof got - 1, f); fclose(f); got[n] = 0; return !strcmp(got, text);
+}
+static RuntimeGamepadState settle(void) { RuntimeGamepadState s; runtime_gamepad_read(&s); runtime_gamepad_read(&s); return s; }   /* past latched presses */
+static void spin(void) { [NSRunLoop.currentRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.02]]; }
+enum { Y = 1 << 3, ZL = 1 << 8, ZR = 1 << 9 };
+
+int main(int argc, char **argv) { @autoreleasepool {
+    if (argc != 2) { fprintf(stderr, "usage: probe <empty folder>\n"); return 2; }
+    char controls[1024], saved[1100];
+    snprintf(controls, sizeof controls, "%s/controls.txt", argv[1]);
+    snprintf(saved, sizeof saved, "%s/mouse.txt", argv[1]);
+    setenv("TOTK_CONTROLS", controls, 1);
+    mouseTicksByHand = 1;
+    controller_map_default(controllerMap, controllerModes);
+    runtime_mouse_set_hook(hook);
+
+    check(runtime_controller_layout_get()==0,"custom layout is default");
+    check(runtime_controller_layout_set(2)&&runtime_controller_layout_get()==2,"Xbox layout applies immediately");
+    char layoutPath[1200];snprintf(layoutPath,sizeof layoutPath,"%s/controller-layout.txt",argv[1]);
+    check(file_says(layoutPath,"2\n"),"layout persisted independently of controls");
+    atomic_store(&controllerLayout,0);load_controller_layout();check(runtime_controller_layout_get()==2,"layout reload restores persisted selection");
+    check(!runtime_controller_layout_set(3)&&runtime_controller_layout_get()==2,"invalid layout rejected");
+    uint16_t preset[CONTROLLER_BUTTONS];uint8_t pm[CONTROLLER_BUTTONS];
+    controller_map_default(preset,pm);preset[4]=8;pm[4]=CONTROLLER_TOGGLE;
+    controller_map_layout(preset,pm,2);check(preset[0]==1&&preset[1]==2&&preset[2]==4&&preset[3]==8,"Xbox A B X Y letter layout");
+    check(preset[4]==8&&pm[4]==CONTROLLER_TOGGLE&&preset[17]==8,"preset leaves shoulder/stick and mouse mappings untouched");
+    controller_map_layout(preset,pm,1);check(preset[0]==2&&preset[1]==1&&preset[2]==8&&preset[3]==4,"Switch physical layout");
+    check(runtime_controller_layout_set(0),"return to custom");
+    check(!runtime_mouse_enabled(), "mouse mode starts off");
+    runtime_mouse_button(0, 1); runtime_mouse_move(10, 0); mouse_tick();
+    RuntimeGamepadState s = settle();
+    check(!s.buttons && !s.rx && !s.ry, "mouse mode off: clicks and movement do nothing");
+    runtime_mouse_button(0, 0);
+
+    check(runtime_mouse_toggle() == 1 && runtime_mouse_enabled() && file_says(saved, "on\n") && motionMouse == 1, "key 7: on, saved, the mouse takes the gyro");
+    spin(); check(hookCalls == 1, "the window is told (to capture the pointer)");
+    runtime_mouse_button(0, 1); s = settle(); check(s.buttons == Y, "left button: attack (Y)");
+    runtime_mouse_button(0, 0); s = settle(); check(!s.buttons, "left button up");
+    runtime_mouse_button(1, 1); s = settle(); check(s.buttons == ZR, "right button held: draw the bow (ZR)");
+    runtime_mouse_button(0, 1); s = settle(); check(!s.buttons, "left click while drawing: ZR let go (the shot), no attack");
+    runtime_mouse_button(0, 0); s = settle(); check(s.buttons == ZR, "left up, right still held: drawing again");
+    runtime_mouse_button(1, 0); runtime_mouse_button(2, 1); s = settle(); check(s.buttons == ZL, "middle button: target (ZL)");
+    runtime_mouse_button(2, 0); runtime_mouse_button(9, 1); s = settle(); check(!s.buttons, "a button number out of range is ignored");
+
+    runtime_mouse_move(10, 0); mouse_tick(); s = settle();
+    check(abs(s.rx - 16384) <= 1 && !s.ry, "10 points right: half the right stick right");
+    check(feeds == 1 && lastYaw < 0 && lastAcc == -1, "and the gyro turns clockwise, lying flat");
+    mouse_tick(); s = settle(); check(s.rx > 0 && s.rx < 16384 && feeds == 2, "it decays tick by tick, the gyro keeps sampling");
+    runtime_mouse_button(0, 1); runtime_mouse_release(); mouse_tick(); s = settle();
+    check(!s.buttons && !s.rx && !s.ry, "release (the window lost the pointer): buttons up, stick centred");
+
+    check(runtime_mouse_toggle() == 0 && file_says(saved, "off\n") && motionMouse == 0, "key 7 again: off, saved, the gyro back to the controller");
+    spin(); check(hookCalls == 2, "the window is told again (to free the pointer)");
+    FILE *f = fopen(saved, "w"); fputs("on\n", f); fclose(f);
+    load_mouse_mode(); check(runtime_mouse_enabled() && motionMouse == 1, "the next start reads mouse mode on");
+    runtime_mouse_toggle(); f = fopen(saved, "w"); fputs("maybe\n", f); fclose(f);
+    load_mouse_mode(); check(!runtime_mouse_enabled(), "a word other than on / off: off");
+
+    setenv("TOTK_MOUSE_GYRO", "0", 1); motionMouse = -1;
+    int before = feeds; runtime_mouse_toggle(); runtime_mouse_move(10, 0); mouse_tick(); s = settle();
+    check(motionMouse == 0 && feeds == before && s.rx > 0, "TOTK_MOUSE_GYRO=0: the stick only, the controller keeps the gyro");
+    runtime_mouse_toggle(); unsetenv("TOTK_MOUSE_GYRO");
+    gyroOn = 0; motionMouse = -1; before = feeds; runtime_mouse_toggle(); mouse_tick();
+    check(motionMouse == 0 && feeds == before, "TOTK_GYRO=0 (no six-axis device for the game): no mouse gyro either");
+    runtime_mouse_toggle();
+
+    printf("{\"status\":\"%s\",\"probe\":\"mouse\",\"checked\":%d,\"failures\":%d}\n", failures ? "fail" : "pass", checked, failures);
+    return failures != 0;
+}}
diff --git a/games/totk/scripts/probes/movie_probe.c b/games/totk/scripts/probes/movie_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..89207f7b5297a98e42678dc53ff051815d8bf3bb
--- /dev/null
+++ b/games/totk/scripts/probes/movie_probe.c
@@ -0,0 +1,190 @@
+/* Probe for the host VP9 movie::Decoder (runtime/movie_host.c) through its entries, driven the way main's movie player
+   drives the library (main+0x240d570 event loop, +0x240e118 feeding, +0x240dc78 frame fetch): every VP9 frame of an IVF
+   file (the blood-moon cutscene, ffmpeg -c copy) goes in, every output must equal ffmpeg's own VP9 decode (packed NV12,
+   a decoder independent of libvpx) byte for byte, outputs are held until all output slots are taken so inputs have to
+   wait, end of stream comes out last. Also: client events (format changed before the first output), output format keys,
+   output size, error statuses, decoders of other types left to the original code, destruction. Stand-ins replace the
+   guest's movie::Buffer, movie::MediaData and nn::os events.
+   Two runs: "buffers" hands frames over as soon as they are decoded (TOTK_MOVIE_PACE=0) and holds all output slots;
+   "paced" runs a fake clock at 95 game frames per second (movie_host_tick at every frame), with 3 s at 15 frames per
+   second in between (a loading hitch): every frame handed over is at most two frame periods late, at most one per game
+   frame, frames are dropped only in the slow part, none is late once the game is fast again (no catch-up), and the
+   17.3 s movie takes 17.3 s.
+   usage: movie-probe <frames.ivf> <reference.nv12> <width> <height> <frames> buffers|paced
+   TOTK_PROBE_NEGATIVE=1 (U and V swapped), =2 (no format-changed event) and =3 (paced run without pacing) must fail. */
+#include "../../runtime/movie_host.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+_Noreturn void runtime_fail(const char *s) { fprintf(stderr, "movie probe: runtime_fail: %s\n", s); exit(3); }
+void *runtime_symbol(const char *name) { (void)name; return NULL; }
+static int checks;
+static void need(int c, const char *fmt, ...) {
+    checks++; if (c) return;
+    va_list ap; va_start(ap, fmt); fprintf(stderr, "movie probe: FAILED: "); vfprintf(stderr, fmt, ap); fputc('\n', stderr); va_end(ap); exit(1);
+}
+
+/* ---- stand-ins for the guest ---- */
+typedef struct { int offset, size; void *data; size_t cap; } Buf;
+static void buf_set_range(void *b, int o, int s) { ((Buf *)b)->offset = o; ((Buf *)b)->size = s; }
+static void buf_set_data(void *b, void *d, size_t c) { ((Buf *)b)->data = d; ((Buf *)b)->cap = c; }
+static void *buf_base(const void *b) { return ((const Buf *)b)->data; }
+static size_t buf_capacity(const void *b) { return ((const Buf *)b)->cap; }
+typedef struct { char key[32]; int kind, v[4]; const char *s; } Entry;
+typedef struct { Entry e[32]; int n; } Md;
+static Entry *md_slot(Md *m, const char *k) { for (int i = 0; i < m->n; i++) if (!strcmp(m->e[i].key, k)) return &m->e[i]; if (m->n == 32) runtime_fail("md full"); Entry *e = &m->e[m->n++]; snprintf(e->key, sizeof e->key, "%s", k); return e; }
+static const Entry *md_get(const Md *m, const char *k) { for (int i = 0; i < m->n; i++) if (!strcmp(m->e[i].key, k)) return &m->e[i]; return NULL; }
+static bool md_find_int32(const void *m, const char *k, int *v) { const Entry *e = md_get(m, k); if (!e || e->kind != 1) return false; *v = e->v[0]; return true; }
+static bool md_find_string(const void *m, const char *k, const char **v) { const Entry *e = md_get(m, k); if (!e || e->kind != 2) return false; *v = e->s; return true; }
+static void md_set_int32(void *m, const char *k, int v) { Entry *e = md_slot(m, k); e->kind = 1; e->v[0] = v; }
+static void md_set_rect(void *m, const char *k, int l, int t, int r, int b) { Entry *e = md_slot(m, k); e->kind = 3; e->v[0] = l; e->v[1] = t; e->v[2] = r; e->v[3] = b; }
+static void md_set_string(void *m, const char *k, const char *v) { Entry *e = md_slot(m, k); e->kind = 2; e->s = v; }
+typedef struct { int count; } Event;
+static void signal_event(void *ev) { ((Event *)ev)->count++; }
+/* the library's own code, for decoders the host leaves to it */
+static int orig_ctor_calls, orig_d0_calls, orig_start_calls;
+static void orig_ctor(void *obj, int t, int f, int m, int p) { (void)t; (void)f; (void)m; (void)p; orig_ctor_calls++; ((void **)obj)[0] = (void *)0x1; ((void **)obj)[1] = (void *)0x2; }
+static void orig_d0(void *obj) { orig_d0_calls++; (void)obj; }
+static int orig_start(void *obj) { (void)obj; orig_start_calls++; return 0x7777; }
+static int orig_other(void) { return 0x7776; }
+static char fake_vtable[0xa8];
+static uint64_t fake_ns = 1000000000ull;
+static uint64_t fake_clock(void) { return fake_ns; }
+
+/* ---- entries ---- */
+typedef void (*ctor_t)(void *, int, int, int, int); typedef void (*obj_t)(void *);
+typedef int (*md_t)(void *, void *); typedef int (*int_t)(void *); typedef int (*pp_t)(void *, int *, int *);
+typedef int (*ib_t)(void *, int, void *); typedef int (*send_t)(void *, int, int, int, int64_t, unsigned);
+typedef int (*acq_t)(void *, int *, int64_t *, unsigned *, int *); typedef int (*i_t)(void *, int);
+#define E(t, w) ((t)movie_host_entry(w))
+
+static uint8_t *read_file(const char *path, size_t *n) {
+    FILE *f = fopen(path, "rb"); if (!f) { perror(path); exit(2); }
+    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);
+    uint8_t *b = malloc((size_t)sz); if (!b || fread(b, 1, (size_t)sz, f) != (size_t)sz) { perror(path); exit(2); }
+    fclose(f); *n = (size_t)sz; return b;
+}
+
+int main(int argc, char **argv) {
+    if (argc != 7 || (strcmp(argv[6], "buffers") && strcmp(argv[6], "paced"))) { fprintf(stderr, "usage: movie-probe <frames.ivf> <reference.nv12> <width> <height> <frames> buffers|paced\n"); return 2; }
+    int W = atoi(argv[3]), H = atoi(argv[4]), NF = atoi(argv[5]); size_t fb = (size_t)W * H * 3 / 2;
+    const int paced = !strcmp(argv[6], "paced"); const uint64_t TICK = 1000000000ull / 95;
+    const char *neg = getenv("TOTK_PROBE_NEGATIVE");   /* 3: the paced run with pacing off must fail */
+    setenv("TOTK_MOVIE_PACE", paced && !(neg && !strcmp(neg, "3")) ? "1" : "0", 1); movie_host_set_clock(fake_clock);
+    int64_t t_first = -1, pts_first = 0, late_max = 0, late_fast_max = 0; int ticks = 0, delivered = 0, last_k = -1;
+    int64_t *alltimes = calloc((size_t)NF, sizeof *alltimes); int nall = 0;
+    MovieGuest api = {signal_event, buf_set_range, buf_set_data, buf_base, buf_capacity, md_find_int32, md_find_string,
+                      md_set_int32, md_set_rect, md_set_string, fake_vtable + 0x10, {0}};
+    for (int i = 0; i < MOVIE_ENTRIES; i++) api.orig[i] = (void *)orig_other;
+    api.orig[MOVIE_CTOR] = (void *)orig_ctor; api.orig[MOVIE_D0] = (void *)orig_d0; api.orig[MOVIE_START] = (void *)orig_start;
+    movie_host_set_guest(&api);
+    size_t ivf_n, ref_n; uint8_t *ivf = read_file(argv[1], &ivf_n), *ref = read_file(argv[2], &ref_n);
+    need(ivf_n > 32 && !memcmp(ivf, "DKIF", 4) && !memcmp(ivf + 8, "VP90", 4), "IVF header");
+    need(ref_n == fb * (size_t)NF, "reference holds %d frames of %zu bytes", NF, fb);
+
+    /* names: every entry is reachable by its mangled name, other names are not taken */
+    need(runtime_movie_override("_ZN5movie7Decoder5StartEv") == movie_host_entry(MOVIE_START), "override by name");
+    need(runtime_movie_override("_ZN5movie9Extractor4ReadEPNS_6BufferE") == NULL, "extractor left alone");
+
+    /* a decoder of another type goes to the library, and so do its methods */
+    void *other[2] = {0}; E(ctor_t, MOVIE_CTOR)(other, 1, 4, 1, 16);
+    need(orig_ctor_calls == 1 && other[0] == (void *)0x1, "AVC decoder constructed by the library");
+    need(E(int_t, MOVIE_START)(other) == 0x7777 && orig_start_calls == 1, "its Start goes to the library");
+
+    void *dec[2] = {0}; E(ctor_t, MOVIE_CTOR)(dec, 3, 4, 1, 16);
+    need(dec[0] == fake_vtable + 0x10 && dec[1] != NULL, "VP9 decoder: library vtable, host state at +8");
+    need(E(int_t, MOVIE_START)(dec) == 0x2002, "Start before Configure is refused");
+    Event ev[4] = {{0}}; void *events[4] = {&ev[0], &ev[1], &ev[2], &ev[3]};
+    need(E(md_t, MOVIE_REGISTER_EVENTS)(dec, events) == 0, "RegisterClientEvents");
+    Md bad = {0}; md_set_string(&bad, "mime", "video/avc"); md_set_int32(&bad, "width", W); md_set_int32(&bad, "height", H);
+    need(E(md_t, MOVIE_CONFIGURE)(dec, &bad) == 0x2001, "AVC format refused by the VP9 decoder");
+    need(E(md_t, MOVIE_CONFIGURE)(dec, NULL) == 0x100b, "null format");
+    Md fmt = {0}; md_set_string(&fmt, "mime", "video/x-vnd.on2.vp9"); md_set_int32(&fmt, "width", W); md_set_int32(&fmt, "height", H);
+    need(E(md_t, MOVIE_CONFIGURE)(dec, &fmt) == 0, "Configure");
+    int size = 0, count = 0; need(E(pp_t, MOVIE_GET_OUTPUT_SIZE)(dec, &size, &count) == 0 && size == (int)fb && count == 1, "output size %d count %d", size, count);
+    need(E(int_t, MOVIE_START)(dec) == 0 && ev[0].count == 1, "Start signals input available");
+
+    int64_t times[64]; int in_free[16], nfree = 0, held[16], nheld = 0, next = 0, compared = 0, eos_sent = 0, eos_seen = 0, peak_held = 0, frame_of[16] = {0};
+    size_t pos = 32; uint8_t *dst = malloc(fb); Buf ob = {0};
+    for (int guard = 0; !eos_seen || nheld; guard++) {
+        need(guard < 100000, "decode loop makes progress");
+        uint64_t tick = TICK;
+        if (paced && t_first >= 0 && fake_ns >= (uint64_t)t_first + 5000000000ull && fake_ns < (uint64_t)t_first + 8000000000ull) tick = 1000000000ull / 15;
+        int got_this_tick = 0;
+        if (paced) { fake_ns += tick; ticks++; movie_host_tick(); }   /* one game frame: present */
+        for (;;) {   /* input event handler: every free input index */
+            int idx = -1, rem = 0, st = E(pp_t, MOVIE_ACQUIRE_INPUT)(dec, &idx, &rem);
+            if (st) { need(st == 0x1011 && idx == -1, "no input: 0x1011"); break; }
+            in_free[nfree++] = idx;
+        }
+        while (nfree && !eos_sent) {   /* feeder: one sample per free input buffer */
+            int idx = in_free[0]; memmove(in_free, in_free + 1, (size_t)--nfree * sizeof in_free[0]);
+            Buf ib = {0}; need(E(ib_t, MOVIE_GET_INPUT)(dec, idx, &ib) == 0 && ib.data && ib.cap >= (2u << 20), "input buffer %d", idx);
+            if (pos + 12 <= ivf_n) {
+                uint32_t n; int64_t pts; memcpy(&n, ivf + pos, 4); memcpy(&pts, ivf + pos + 4, 8); pos += 12;
+                need(pos + n <= ivf_n && n <= ib.cap, "IVF frame size");
+                memcpy(ib.data, ivf + pos, n); pos += n; times[next % 64] = pts * 1000; next++; if (nall < NF) alltimes[nall++] = pts * 1000;
+                need(E(send_t, MOVIE_SEND_INPUT)(dec, idx, 0, (int)n, pts * 1000, 0) == 0, "SendInputBufferForDecode");
+            } else {
+                need(E(send_t, MOVIE_SEND_INPUT)(dec, idx, 0, 0, 0, 4) == 0, "end of stream input"); eos_sent = 1;
+            }
+        }
+        for (;;) {   /* output event handler: queue every ready output */
+            int idx = -1, rem = 0; int64_t t = 0; unsigned fl = 0;
+            int st = E(acq_t, MOVIE_ACQUIRE_OUTPUT)(dec, &idx, &t, &fl, &rem);
+            if (st) { need(st == 0x100e && idx == -1, "no output: 0x100e"); break; }
+            need(ev[2].count >= 1, "format changed signalled before the first output");
+            if (fl & 4) { need(paced ? last_k == NF - 1 : compared + nheld == NF, "end of stream after all %d frames (got %d, last %d)", NF, compared + nheld, last_k); need(E(i_t, MOVIE_RELEASE_OUTPUT)(dec, idx) == 0, "release EOS"); eos_seen = 1; break; }
+            int k = 0; while (k < nall && alltimes[k] != t) k++;
+            need(k < nall && k > last_k, "output time %lld is a later frame than %d (frame %d)", (long long)t, last_k, k);
+            if (!paced) need(k == compared + nheld, "output %d is frame %d", compared + nheld, k);
+            if (paced) {   /* at most two frame periods late (a frame period: 1/30 s); within two game frames while the game is fast */
+                if (t_first < 0) { t_first = (int64_t)fake_ns; pts_first = t; }
+                int64_t due = t_first + (t - pts_first) * 1000, late = (int64_t)fake_ns - due, period = 1000000000 / 30;
+                need(late >= 0 && late <= 2 * period, "frame %d handed over %lld us after its time", k, (long long)(late / 1000));
+                int fast_again = due > t_first + 8200000000ll || due < t_first + 4900000000ll;
+                if (fast_again) need(late <= 2 * (int64_t)TICK, "frame %d handed over %lld us late while the game is fast (catch-up)", k, (long long)(late / 1000));
+                if (late > late_max) late_max = late; if (fast_again && late > late_fast_max) late_fast_max = late;
+            }
+            if (paced) { need(got_this_tick == 0, "at most one frame handed over per game frame (frame %d)", k); got_this_tick++; }
+            last_k = k; delivered++; frame_of[idx] = k;
+            held[nheld++] = idx; if (nheld > peak_held) peak_held = nheld;
+        }
+        /* renderer: present the oldest frame once every output slot is held, or when the input side has nothing left to do */
+        while (nheld && (paced || nheld >= 8 || !nfree || eos_sent)) {
+            buf_set_data(&ob, dst, fb); buf_set_range(&ob, 0, (int)fb);
+            need(E(ib_t, MOVIE_GET_OUTPUT)(dec, held[0], &ob) == 0 && ob.offset == 0 && ob.size == (int)fb, "GetOutputBuffer frame %d", compared);
+            size_t fk = (size_t)frame_of[held[0]];
+            if (memcmp(dst, ref + fb * fk, fb)) {
+                size_t k = 0; while (dst[k] == ref[fb * fk + k]) k++;
+                need(0, "frame %zu differs from ffmpeg's decode at byte %zu (%s plane): %u vs %u", fk, k, k < (size_t)W * H ? "Y" : "UV", dst[k], ref[fb * fk + k]);
+            }
+            checks++;
+            need(E(i_t, MOVIE_RELEASE_OUTPUT)(dec, held[0]) == 0, "ReleaseOutputBufferIndex"); compared++;
+            memmove(held, held + 1, (size_t)--nheld * sizeof held[0]);
+            break;   /* back to the event handlers: releasing may have decoded waiting inputs */
+        }
+    }
+    need(paced ? compared == delivered && compared < NF : compared == NF, "frames compared %d (delivered %d of %d)", compared, delivered, NF);
+    if (!paced) need(peak_held == 8, "all 8 output slots were held at once (peak %d): inputs had to wait", peak_held);
+    else {
+        double span = (double)(fake_ns - (uint64_t)t_first) / 1e9, movie = (double)(times[(NF - 1) % 64] - pts_first) / 1e6;
+        need(span >= movie && span <= movie + 0.1, "paced playback took %.3f s of game time for a %.3f s movie", span, movie);
+        fprintf(stderr, "movie probe: paced: %.3f s movie in %.3f s, %d game frames (3 s of them at 15 fps); %d of %d frames shown, %d dropped while slow; latest handover %.1f ms after due (%.1f ms while fast)\n",
+                movie, span, ticks, delivered, NF, NF - delivered, late_max / 1e6, late_fast_max / 1e6);
+    }
+    Md of = {0}; need(E(md_t, MOVIE_GET_OUTPUT_FORMAT)(dec, &of) == 0, "GetOutputFormat");
+    int v; const Entry *crop = md_get(&of, "crop");
+    need(md_find_int32(&of, "width", &v) && v == W && md_find_int32(&of, "height", &v) && v == H && md_find_int32(&of, "stride", &v) && v == W, "output width / height / stride");
+    need(crop && crop->kind == 3 && crop->v[0] == 0 && crop->v[1] == 0 && crop->v[2] == W - 1 && crop->v[3] == H - 1, "output crop");
+    need(md_find_int32(&of, "nv12-uv-offset", &v) && v == W * H, "nv12 UV offset");
+    need(E(ib_t, MOVIE_GET_INPUT)(dec, 0, NULL) == 0x100b, "GetInputBuffer null buffer");
+    need(E(int_t, MOVIE_FLUSH)(dec) == 0 && E(int_t, MOVIE_STOP)(dec) == 0, "Flush, Stop");
+    E(obj_t, MOVIE_D0)(dec);
+    need(orig_d0_calls == 1 && dec[1] == NULL && dec[0] == fake_vtable + 0x10, "delete: host state freed, the library frees the object");
+    need(E(int_t, MOVIE_START)(dec) == 0x7777, "a deleted decoder's address is no longer a host decoder");
+    printf("{\"probe\":\"movie\",\"run\":\"%s\",\"frames\":%d,\"checks\":%d,\"ok\":true}\n", argv[6], compared, checks);
+    return 0;
+}
diff --git a/games/totk/scripts/probes/movie_probe_inputs.py b/games/totk/scripts/probes/movie_probe_inputs.py
