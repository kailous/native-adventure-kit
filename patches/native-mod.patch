+"""Offline append-only ASB experiment. Never creates a deployable RomFS overlay."""
+import argparse
+import contextlib
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import uuid
+
+from inspect_resources import external_output
+
+COMMAND = 'NativeDanceProbe'
+NODE_GUID = str(uuid.uuid5(uuid.NAMESPACE_URL, 'local.totk/native-dance-probe/node'))
+COMMAND_GUID = str(uuid.uuid5(uuid.NAMESPACE_URL, 'local.totk/native-dance-probe/command'))
+
+
+def append_command(original):
+    """Add one independent alias to an existing idle clip; preserve all old data."""
+    data = copy.deepcopy(original)
+    if any(c['Name'] == COMMAND for c in data['Commands']):
+        raise ValueError('Probe command already exists')
+    if any(n['GUID'] in (NODE_GUID, COMMAND_GUID) for n in data['Nodes']):
+        raise ValueError('Probe GUID already exists')
+    if any(c['GUID'] in (NODE_GUID, COMMAND_GUID) for c in data['Commands']):
+        raise ValueError('Probe GUID already exists')
+    indices = [n['Node Index'] for n in data['Nodes']]
+    if indices != list(range(len(indices))):
+        raise ValueError('Expected contiguous original node indices')
+    # Copy scalar settings from an idle skeletal node. Drop links only on the NEW
+    # node, so it never points at original event/frame/selector subgraphs.
+    idle = next((n for n in data['Nodes'] if n['Node Type'] == 'SkeletalAnimation'
+                 and n.get('Body', {}).get('Animation') == 'Nml_Wait'), None)
+    if idle is None:
+        raise ValueError('No literal Nml_Wait node; refusing to guess')
+    body_keys = ('Animation', 'Unknown 1', 'Unknown 2', 'Unknown 3', 'Unknown 4')
+    if any(k not in idle['Body'] for k in body_keys):
+        raise ValueError('Unsupported skeletal node fields')
+    node = {'Node Index': len(indices), 'Node Type': 'SkeletalAnimation',
+            'No State Transition': True, 'GUID': NODE_GUID,
+            'Body': {k: copy.deepcopy(idle['Body'][k]) for k in body_keys}}
+    command = {'Name': COMMAND, 'Unknown 1': 0.0, 'Ignore Same Command': False,
+               'Interpolation Type': 0, 'GUID': COMMAND_GUID, 'Node Index': len(indices)}
+    data['Nodes'].append(node)
+    data['Commands'].append(command)
+    return data
+
+
+def originals_preserved(original, modified):
+    return (modified['Commands'][:len(original['Commands'])] == original['Commands']
+            and modified['Nodes'][:len(original['Nodes'])] == original['Nodes']
+            and all(modified[k] == v for k, v in original.items() if k not in ('Commands', 'Nodes')))
+
+
+def probe(toolkit, source, events, output):
+    toolkit, source, events = map(lambda p: Path(p).resolve(), (toolkit, source, events))
+    output = external_output(output, input_root=source.parent)
+    output.mkdir(parents=True, exist_ok=True)
+    # This external, pinned toolkit requires events.json relative to cwd.
+    sys.path.insert(0, str(toolkit))
+    from asb import ASB
+    before_cwd = Path.cwd()
+    try:
+        os.chdir(toolkit)
+        original = ASB.from_binary(source.read_bytes())
+        baseline = original.asdict()
+        if Path(original.filename).name != original.filename or original.filename in ('', '.', '..'):
+            raise ValueError('Unsafe toolkit output filename')
+        unchanged = output / 'unchanged'
+        unchanged.mkdir(exist_ok=True)
+        original.to_binary(str(unchanged))
+        roundtrip = ASB.from_binary((unchanged / (original.filename + '.asb')).read_bytes()).asdict()
+        if baseline != roundtrip:
+            raise ValueError('Unmodified ASB semantic roundtrip failed')
+        experiment = append_command(baseline)
+        staged = output / 'append-only'
+        staged.mkdir(exist_ok=True)
+        ASB.from_dict(experiment).to_binary(str(staged))
+        output_file = staged / (original.filename + '.asb')
+        reread = ASB.from_binary(output_file.read_bytes())
+        data = reread.asdict()
+        preserved = originals_preserved(baseline, data)
+        if not preserved or data != experiment:
+            raise ValueError('Append-only serialization changed original structures')
+        # No BAEV writer is used: reuse the original event bytes unchanged.
+        with (output / 'event-import.log').open('w') as log, contextlib.redirect_stdout(log):
+            original.import_baev(events.read_bytes())
+            reread.import_baev(events.read_bytes())
+        with_events_preserved = originals_preserved(original.asdict(), reread.asdict())
+        if not with_events_preserved:
+            raise ValueError('Original event associations changed')
+        result = {'status': 'offline-structural-pass', 'command': COMMAND,
+                  'original_commands': len(baseline['Commands']), 'new_commands': len(data['Commands']),
+                  'original_nodes': len(baseline['Nodes']), 'new_nodes': len(data['Nodes']),
+                  'unmodified_semantic_roundtrip': True, 'original_structures_preserved': preserved,
+                  'original_event_associations_preserved': with_events_preserved,
+                  'original_event_sha256': hashlib.sha256(events.read_bytes()).hexdigest(),
+                  'original_asb_sha256': hashlib.sha256(source.read_bytes()).hexdigest(),
+                  'experimental_asb_sha256': hashlib.sha256(output_file.read_bytes()).hexdigest(),
+                  'toolkit_asb_sha256': hashlib.sha256((toolkit / 'asb.py').read_bytes()).hexdigest(),
+                  'animation': 'Nml_Wait', 'new_dance_clip': False, 'deployed': False,
+                  'limitations': ['No game load/playback validation', 'No animation-controller ABI verified',
+                                  'No BSA scheduler registration or independent cancellation implemented',
+                                  'Existing clip reference only; no new curves or skeleton changes',
+                                  'Binary identity is not preserved; semantic equality covers parser-visible fields only']}
+        (output / 'result.json').write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n')
+        return result
+    finally:
+        os.chdir(before_cwd)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for key in ('toolkit', 'source', 'events', 'output'):
+        parser.add_argument('--' + key, type=Path, required=True)
+    args = parser.parse_args()
+    print(json.dumps(probe(args.toolkit, args.source, args.events, args.output)))
+
+
+if __name__ == '__main__':
+    main()
