+ uint32_t hid=0x20;id=0;need(style(&hid)==2&&style(&id)==0,"handheld mode: handheld controller only");
+ void(*disc)(const uint32_t *)=runtime_input_override("_ZN2nn3hid14DisconnectNpadERKj");disc(&id);need(style(&hid)==2,"handheld mode: disconnecting player 1 keeps the handheld controller");
+ runtime_input_key(38,1);runtime_input_key(38,0);need(hread(&out.state,1,&hid)==1&&out.state.buttons==1&&out.state.attr==1,"handheld short tap latched");
+ read(&out.state,1,&id);need(!out.state.attr&&!out.state.buttons,"handheld mode: player 1 not attached");
+ feedback_checks();
+ puts("{\"status\":\"pass\",\"scope\":\"input service state ABI, rumble and six-axis hid answers (on by default, off with =0 and in agent test sessions, left/right handles, batches, mute flags, newest-first states, orientation in the controller frame, gravity pull, axis remap), short tap latch, keyboard axes, four D-pad directions, focus clear of keyboard and controller, number keys 1-5 leave display settings unchanged (menu-only controls), key 7 mouse toggle and gyro ownership, unattached controller, handheld mode controller; no game control flow\"}");
+}
+
+int runtime_nfp_scan(const char *id,const char *uid){(void)id;(void)uid;return 0;}
diff --git a/games/totk/scripts/probes/inspect_map_ui.py b/games/totk/scripts/probes/inspect_map_ui.py
new file mode 100644
index 0000000000000000000000000000000000000000..9553dec0c3c9574495b4f565393b2cd768b20bca
--- /dev/null
+++ b/games/totk/scripts/probes/inspect_map_ui.py
@@ -0,0 +1,129 @@
+#!/usr/bin/env python3
+"""Verify the read-only 1.4.3 map UI layout against the user's extracted main ELF.
+
+Requires the build venv's capstone. Writes evidence only to --output outside
+the source checkout; never starts the game or accesses a running process.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+
+from capstone import Cs, CS_ARCH_ARM64, CS_MODE_ARM
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from probe_paths import SOURCE_ROOT
+
+
+def inspect(path):
+    raw = path.read_bytes()
+    digest = hashlib.sha256(raw).hexdigest()
+    if digest != '1000abfbcfc45c69fc4f5afcb9e6d70d145c0d209df5aa50cb8720f7ab4c00ff':
+        raise ValueError('Expected verified TOTK 1.4.3 main ELF')
+    phoff = struct.unpack_from('<Q', raw, 32)[0]
+    stride, count = struct.unpack_from('<HH', raw, 54)
+    segments = []
+    for i in range(count):
+        kind, _, offset, address, _, size, _, _ = struct.unpack_from('<IIQQQQQQ', raw, phoff + i * stride)
+        if kind == 1:
+            segments.append((address, raw[offset:offset + size]))
+
+    def read(address, size):
+        for base, data in segments:
+            if base <= address and address + size <= base + len(data):
+                return data[address - base:address - base + size]
+        raise ValueError(f'Unmapped ELF address {address:#x}')
+
+    decoder = Cs(CS_ARCH_ARM64, CS_MODE_ARM)
+    evidence = {}
+
+    def check(name, address, size, required):
+        instructions = [dict(address=hex(i.address), instruction=i.mnemonic + (' ' + i.op_str if i.op_str else ''))
+                        for i in decoder.disasm(read(address, size), address)]
+        missing = set(required) - {i['instruction'] for i in instructions}
+        if missing:
+            raise ValueError(f'{name}: missing expected instructions: {sorted(missing)}')
+        evidence[name] = instructions
+
+    check('mapLookupCaller', 0x1ffd3e4, 0x30,
+          ['ldr x8, [x8, #0x158]', 'mov w1, #0x84f', 'movk w1, #0x69aa, lsl #16',
+           'bl #0xcde80c', 'bl #0x215e190'])
+    check('registryGetter', 0xcde80c, 0x80,
+          ['ldr x8, [x0, #0x28]', 'ldr w9, [x8, #0x24]', 'ldr x11, [x8, #0x18]',
+           'ldr w8, [x8, #4]', 'ldr w9, [x0, #8]', 'ldr x10, [x0, #0x10]',
+           'ldr x0, [x10, w8, sxtw #3]'])
+    if struct.unpack('<Q', read(0x3960158, 8))[0] != 0x3acf960:
+        raise ValueError('Unexpected UI registry singleton slot')
+    check('constructor', 0xd9359c, 0x10,
+          ['adrp x8, #0x372b000', 'add x8, x8, #0x158', 'str x8, [x19]'])
+    if struct.unpack('<Q', read(0x372b168, 8))[0] != 0x215e5b0:
+        raise ValueError('Map vtable RTTI cast mismatch')
+    check('typeName', 0x215e678, 12,
+          ['adrp x0, #0x2c71000', 'add x0, x0, #0x2cc', 'ret'])
+    if read(0x2c712cc, 12) != b'UIMapScreen\0':
+        raise ValueError('Unexpected screen type name')
+    check('pauseBackgroundConstructor', 0xca03b4, 0x10,
+          ['adrp x8, #0x372d000', 'add x8, x8, #0x410', 'str x8, [x19]'])
+    if struct.unpack('<Q',read(0x372d420,8))[0]!=0x2167184:
+        raise ValueError('Pause background vtable RTTI mismatch')
+    check('pauseBackgroundTypeName',0x216720c,12,
+          ['adrp x0, #0x2ced000','add x0, x0, #0x74a','ret'])
+    if read(0x2ced74a,20)!=b'UIPauseMenuBGScreen\0':
+        raise ValueError('Unexpected pause background type name')
+    check('pauseBackgroundRegistryKey',0x880184,0x18,
+          ['mov w10, #0xfef9','movk w10, #0x6735, lsl #16','ldr x12, [x0, #0x18]'])
+    check('activePredicate', 0x28ff680, 0x18,
+          ['ldrb w8, [x0, #0x16e]', 'cmp w8, #2', 'ldrsb w8, [x0, #0x16d]',
+           'ccmp w8, #0, #8, eq', 'cset w0, ge'])
+    # Lifecycle can stay active while the map is hidden. Match the actual
+    # UIMapScreen draw path as a separate mandatory visibility condition.
+    check('mapDrawGate', 0xedfda4, 0x2c,
+          ['ldrb w8, [x19, #0x170]', 'cbz w8, #0xedfe54',
+           'ldrb w8, [x19, #0x171]', 'cbnz w8, #0xedfe54',
+           'ldrb w8, [x19, #0x16e]', 'ldrb w8, [x19, #0x16f]',
+           'cmp w8, #2', 'b.eq #0xedfe54',
+           'ldrb w8, [x19, #0x175]', 'tbz w8, #4, #0xedfe54'])
+    check('closePreservesLifecycle', 0x1fcd98, 0x8c,
+          ['ldrb w8, [x0, #0x16f]', 'cbnz w8, #0x1fce10',
+           'strb wzr, [x19, #0x16e]', 'cmp w8, #1',
+           'mov w8, #2', 'strb w8, [x19, #0x16f]', 'b #0x1fcdb4'])
+    check('worldPinPosition', 0x215aea0, 0x28,
+          ['ldr s0, [x19, #0x2d0]', 'ldr s1, [x19, #0x2d4]', 'fneg s0, s1',
+           'stp s0, s8, [sp, #8]', 'str s0, [sp, #0x10]'])
+    check('worldPinLayer', 0x215afdc, 0x30,
+          ['ldr w8, [x19, #0x2c0]', 'cmp w8, #2', 'adrp x9, #0x3718000',
+           'add x9, x9, #0x458', 'ldr x0, [x8, #0x20]'])
+    layers = []
+    for offset in (0x3718478, 0x3718480, 0x3718488):
+        pointer = struct.unpack('<Q', read(offset, 8))[0]
+        layers.append(read(pointer, 12).split(b'\0')[0].decode())
+    if layers != ['Sky', 'Ground', 'Underground']:
+        raise ValueError(f'Unexpected layer order: {layers}')
+    return dict(gameVersion='1.4.3', elfSha256=digest, registrySlot='0x3acf960',
+                mapHash='0x69aa084f', mapVtable='0x372b158',
+                pauseBackgroundHash='0x6735fef9',pauseBackgroundVtable='0x372d410',
+                fields=dict(phase='0x16e', transition='0x16d', drawState='0x16f',
+                            drawEnabled='0x170', hidden='0x171', drawFlags='0x175',
+                            layer='0x2c0', cursorXY='0x2d0'),
+                worldCoordinates='x = mapX; z = -mapY', layers=layers, evidence=evidence,
+                staticLayoutVerified=True, gameSceneVerified=False)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--elf', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    output = args.output.expanduser().resolve()
+    if output == SOURCE_ROOT or SOURCE_ROOT in output.parents:
+        parser.error('--output must be outside the MacNativeGames checkout')
+    report = inspect(args.elf)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, indent=2) + '\n')
+    print(output)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/games/totk/scripts/probes/mac_v143_soak.py b/games/totk/scripts/probes/mac_v143_soak.py
new file mode 100644
index 0000000000000000000000000000000000000000..74ba929a429b1840a9ad22acd8e46925a8a1e956
--- /dev/null
+++ b/games/totk/scripts/probes/mac_v143_soak.py
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+"""Observe one already-loaded private Mac test session, with bounded diagnostics.
+
+Does not launch the game or modify saves. Requires a test-owned slot and stops
+control on real input, process replacement, log rotation, or lost slot ownership.
+The game remains open for inspection when this observer finishes or fails.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import plistlib
+import re
+import subprocess
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--pid', type=int, required=True)
+    parser.add_argument('--test-root', type=Path, required=True)
+    parser.add_argument('--duration', type=float, default=4*3600)
+    parser.add_argument('--sample', type=float, default=60)
+    parser.add_argument('--capture', type=float, default=600)
+    parser.add_argument('--picture', type=float, default=900)
+    parser.add_argument('--interpolation', type=float, default=3600)
+    parser.add_argument('--initial-interpolation', choices=['off', '30+30', 'half-refresh', 'unlimited'], default='off',
+                        help='already configured at launch; observer records requests, not detected mode')
+    args = parser.parse_args()
+    if min(args.duration, args.sample, args.capture, args.picture, args.interpolation) <= 0:
+        parser.error('intervals and duration must be positive')
+    root = args.test_root.expanduser().resolve()
+    assert not (root/'soak-report.json').exists(), 'use a new directory; previous evidence is preserved'
+    launch = json.loads((root/'launch.json').read_text())
+    env = launch.get('env', launch.get('selected_env', {}))
+    assert env['TOTK_SLOT_OWNER'] == 'codex', 'private test ownership required'
+    assert Path(env['TOTK_PROFILE_DIR']).resolve() == root/'profile'
+    assert not env.get('DM_NVN_TSV'), 'disable per-frame TSV before long sessions'
+    commands = root/'input.txt'
+    assert Path(env['TOTK_INPUT_FILE']).resolve() == commands
+    slot = Path.home()/'Library/Application Support/MacNativeGames/TOTK/game-slot'
+    log = Path.home()/'Library/Logs/MacNativeGames/totk.log'
+    identity = log.stat().st_ino
+
+    def holder():
+        return dict(line.split('=', 1) for line in (slot/'holder').read_text().splitlines() if '=' in line)
+
+    original = holder()
+    assert original['owner'] == 'codex' and int(original['game_pid']) == args.pid
+    assert original['cwd'].endswith('.app/Contents/Resources/totk')
+    info = plistlib.loads((Path(original['cwd']).parents[1]/'Info.plist').read_bytes())
+    assert info['CFBundleShortVersionString'] == '1.4.3'
+    with Path(original['exe']).open('rb') as executable:
+        runtime_sha256 = hashlib.file_digest(executable, 'sha256').hexdigest()
+    started = time.monotonic()
+    report = dict(status='running', pid=args.pid, started=time.time(), duration_requested=args.duration,
+                  game_start=original['game_start'], token=original['token'], samples=[], actions=[],
+                  runtime_sha256=runtime_sha256, display_version=info['CFBundleShortVersionString'],
+                  screenshots=[], suspicious_log_lines=[], preexisting_diagnostic_lines=[], audio_reports=0,
+                  frame_counter_granularity=300,
+                  scope='one unpaused scene, periodic camera/picture/interpolation changes; not full-game or fair version performance comparison')
+    latest_frame = 0
+    first_frame = None
+    frame_changed = started
+    audio = None
+    pending = b''
+    initial_scan = True
+    next_sample = next_capture = 0
+    next_picture, next_interp = args.picture, args.interpolation
+    picture_index = 0
+    pictures = ['off', 'MetalFX', 'native-2K-canvas']
+    interps = ['off', '30+30', 'half-refresh', 'unlimited']
+    interp_index = interps.index(args.initial_interpolation)
+
+    def save():
+        report['elapsed_seconds'] = time.monotonic()-started
+        temporary = root/'soak-report.json.tmp'
+        temporary.write_text(json.dumps(report, ensure_ascii=False, indent=2)+'\n')
+        temporary.replace(root/'soak-report.json')
+
+    def guard():
+        os.kill(args.pid, 0)
+        current = holder()
+        if any(current.get(k) != original[k] for k in ('owner', 'game_pid', 'game_start', 'token')):
+            raise RuntimeError('slot changed; all scripted control stopped')
+        if log.stat().st_ino != identity:
+            raise RuntimeError('log rotated; all scripted control stopped')
+
+    def send(text):
+        guard()
+        with commands.open('a') as stream:
+            stream.write(text+'\n')
+        report['actions'].append(dict(elapsed=time.monotonic()-started, command=text))
+
+    with log.open('rb') as stream:
+        try:
+            while True:
+                guard()
+                pending += stream.read()
+                lines = pending.split(b'\n')
+                pending = lines.pop()
+                for raw in lines:
+                    line = raw.decode('utf-8', errors='replace')
+                    if '[input] user input' in line:
+                        raise RuntimeError('real user input; game left open, scripted control stopped')
+                    match = re.search(r'\[nvn\] 帧 (\d+)：\d+ 个函数', line)
+                    if match and int(match[1]) > latest_frame:
+                        latest_frame = int(match[1])
+                        frame_changed = time.monotonic()
+                    match = re.search(r'output level: rms ([\d.]+) peak ([\d.]+).*underruns (\d+), overruns (\d+)', line)
+                    if match:
+                        audio = dict(rms=float(match[1]), peak=float(match[2]),
+                                     underruns=int(match[3]), overruns=int(match[4]))
+                        report['audio_reports'] += 1
+                    if re.search(r'GPU fault|command buffer.*(?:failed|error)|integrity mismatch|\[fatal\]|runtime_fail|EXC_BAD_ACCESS|【红】', line, re.I):
+                        field = 'preexisting_diagnostic_lines' if initial_scan else 'suspicious_log_lines'
+                        if len(report[field]) < 200:
+                            report[field].append(line)
+                initial_scan = False
+                if first_frame is None and latest_frame:
+                    first_frame = latest_frame
+                elapsed = time.monotonic()-started
+                if elapsed >= next_sample:
+                    ps = subprocess.run(['ps', '-p', str(args.pid), '-o', 'rss=,%cpu=,stat='],
+                                        capture_output=True, text=True, check=True).stdout.split()
+                    if 'Z' in ps[2]:
+                        raise RuntimeError('game is a zombie process')
+                    row = dict(elapsed=elapsed, frame=latest_frame, rss_kib=int(ps[0]),
+                               cpu_percent=float(ps[1]), audio=audio,
+                               picture=pictures[picture_index], interpolation=interps[interp_index],
+                               frame_progress_age_seconds=time.monotonic()-frame_changed)
+                    report['samples'].append(row)
+                    save()
+                    print(json.dumps(row, ensure_ascii=False), flush=True)
+                    next_sample += args.sample
+                if elapsed >= args.duration:
+                    break
+                if time.monotonic()-frame_changed > 90:
+                    raise RuntimeError('no periodic frame progress for 90 seconds; game left open for inspection')
+                if elapsed >= next_capture:
+                    shot = root/f'soak-{round(elapsed):05d}.png'
+                    send('wshot '+str(shot))
+                    report['screenshots'].append(dict(elapsed=elapsed, path=str(shot)))
+                    if next_capture:
+                        # Short alternating turns exercise visibility without moving the player.
+                        send('key '+('124' if len(report['screenshots']) % 2 else '123')+' 250')
+                    next_capture += args.capture
+                if elapsed >= next_picture:
+                    send('key 20 150')
+                    picture_index = (picture_index+1) % len(pictures)
+                    next_picture += args.picture
+                if elapsed >= next_interp:
+                    send('key 19 150')
+                    interp_index = (interp_index+1) % len(interps)
+                    next_interp += args.interpolation
+                time.sleep(1)
+            report.update(status='finished-awaiting-visual-review', ended=time.time(),
+                          first_frame=first_frame, last_frame=latest_frame, game_left_open=True)
+        except Exception as error:
+            report.update(status='stopped-for-inspection', ended=time.time(), error=str(error), game_left_open=True)
+            raise
+        finally:
+            save()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/games/totk/scripts/probes/metal_shader_probe.m b/games/totk/scripts/probes/metal_shader_probe.m
new file mode 100644
index 0000000000000000000000000000000000000000..afc546ff9c9f8413701fcef5c5c719a8f489308e
--- /dev/null
+++ b/games/totk/scripts/probes/metal_shader_probe.m
@@ -0,0 +1,38 @@
+// Compile supplied MSL libraries on the local Metal device; no game is launched.
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+int main(int argc, const char *argv[]) {
+    @autoreleasepool {
+        if (argc < 2) {
+            fprintf(stderr, "usage: metal-shader-probe shader.metal [...]\n");
+            return 2;
+        }
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        if (!device) {
+            fprintf(stderr, "Metal device unavailable\n");
+            return 2;
+        }
+        NSUInteger compiled = 0;
+        for (int i = 1; i < argc; ++i) {
+            NSError *error = nil;
+            NSString *path = [NSString stringWithUTF8String:argv[i]];
+            NSString *source = [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:&error];
+            if (!source) {
+                fprintf(stderr, "%s: %s\n", argv[i], error.localizedDescription.UTF8String);
+                return 1;
+            }
+            MTLCompileOptions *options = [MTLCompileOptions new];
+            id<MTLLibrary> library = [device newLibraryWithSource:source options:options error:&error];
+            if (!library) {
+                fprintf(stderr, "%s: %s\n", argv[i], error.localizedDescription.UTF8String);
+                return 1;
+            }
+            compiled++;
+        }
+        NSDictionary *report = @{ @"status": @"pass", @"compiled": @(compiled), @"scope": @"Metal library compilation only" };
+        NSData *json = [NSJSONSerialization dataWithJSONObject:report options:0 error:nil];
+        puts([[NSString alloc] initWithData:json encoding:NSUTF8StringEncoding].UTF8String);
+        return 0;
+    }
+}
diff --git a/games/totk/scripts/probes/mfx_resize_probe.m b/games/totk/scripts/probes/mfx_resize_probe.m
new file mode 100644
index 0000000000000000000000000000000000000000..933489ea3e688b6696ce1433685b23746ff8b08f
--- /dev/null
+++ b/games/totk/scripts/probes/mfx_resize_probe.m
@@ -0,0 +1,151 @@
+// Construction-only diagnostic for repeated production interpolation rebuilds.
+// No game data or encoded interpolation: this isolates one part of a memory
+// investigation, and cannot establish the lifetime of encoded/in-flight work.
+// Build with runtime/game_slot.c; run in the same canonical game slot.
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <libproc.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/resource.h>
+#include <unistd.h>
+#include "runtime.h"
+#include "totk_mfx.m"
+
+_Noreturn void runtime_fail(const char *message) {
+    fprintf(stderr, "resize probe: %s\n", message);
+    exit(2);
+}
+
+static void sample(id<MTLDevice> device, int iteration, int previous_alive) {
+    struct rusage_info_v4 usage = {0};
+    if (proc_pid_rusage(getpid(), RUSAGE_INFO_V4, (rusage_info_t *)&usage))
+        runtime_fail("proc_pid_rusage");
+    printf("{\"iteration\":%d,\"canvas_width\":%lu,\"canvas_height\":%lu,"
+           "\"metal_allocated_bytes\":%llu,\"phys_footprint\":%llu,"
+           "\"residency_allocations\":%lu,\"previous_interpolator_alive\":%s}\n", iteration,
+           (unsigned long)g.out_w, (unsigned long)g.out_h,
+           (unsigned long long)device.currentAllocatedSize,
+           (unsigned long long)usage.ri_phys_footprint, (unsigned long)g.rs.allocationCount,
+           previous_alive ? "true" : "false");
+    fflush(stdout);
+}
+
+// Optional real encodes: black scene, transparent UI, fixed depth and identity
+// camera motion. Keep the returned frame payload through completion, after the
+// production helper has cleared its interpolator's public texture bindings.
+static void encode_fixture(id<MTLDevice> device) {
+    static id<MTLCommandQueue> copy_queue;
+    static id<MTL4CommandQueue> queue;
+    static id<MTL4CommandAllocator> allocator;
+    static id<MTL4CommandBuffer> command;
+    static id<MTLTexture> depth;
+    static id<MTLResidencySet> depth_set;
+    NSError *error = nil;
+    if (!queue) {
+        copy_queue = [device newCommandQueue]; queue = [device newMTL4CommandQueue];
+        allocator = [device newCommandAllocator]; command = [device newCommandBuffer];
+        depth_set = [device newResidencySetWithDescriptor:[MTLResidencySetDescriptor new] error:&error];
+        if (!queue || !copy_queue || !allocator || !command || !depth_set) runtime_fail("fixture queues");
+        [queue addResidencySet:g.rs]; [queue addResidencySet:depth_set];
+    }
+    if (!depth || depth.width != g.in_w || depth.height != g.in_h) {
+        if (depth) [depth_set removeAllocation:depth];
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float width:g.in_w height:g.in_h mipmapped:NO];
+        td.storageMode = MTLStorageModePrivate; td.usage = MTLTextureUsageShaderRead;
+        depth = [device newTextureWithDescriptor:td];
+        if (!depth) runtime_fail("fixture depth");
+        [depth_set addAllocation:depth]; [depth_set commit];
+    }
+    id<MTLBuffer> zero = [device newBufferWithLength:g.out_w*g.out_h*8 options:MTLResourceStorageModeShared];
+    id<MTLBuffer> db = [device newBufferWithLength:g.in_w*g.in_h*4 options:MTLResourceStorageModeShared];
+    if (!zero || !db) runtime_fail("fixture initialization buffers");
+    memset(zero.contents, 0, zero.length);
+    for (NSUInteger i=0; i<g.in_w*g.in_h; i++) ((float *)db.contents)[i] = 0.5f;
+    id<MTLCommandBuffer> init = [copy_queue commandBuffer];
+    id<MTLBlitCommandEncoder> blit = [init blitCommandEncoder];
+    for (id<MTLTexture> target in @[g.scene[0],g.scene[1],g.ui]) {
+        NSUInteger pitch = target.width*(target.pixelFormat == MTLPixelFormatRGBA16Float ? 8 : 4);
+        [blit copyFromBuffer:zero sourceOffset:0 sourceBytesPerRow:pitch sourceBytesPerImage:pitch*target.height sourceSize:MTLSizeMake(target.width,target.height,1) toTexture:target destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];
+    }
+    [blit copyFromBuffer:db sourceOffset:0 sourceBytesPerRow:g.in_w*4 sourceBytesPerImage:g.in_w*g.in_h*4 sourceSize:MTLSizeMake(g.in_w,g.in_h,1) toTexture:depth destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];
+    [blit endEncoding];
+    for (int s=0; s<2; s++) {
+        MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+        pass.colorAttachments[0].texture=g.out[s]; pass.colorAttachments[0].loadAction=MTLLoadActionClear;
+        pass.colorAttachments[0].storeAction=MTLStoreActionStore; pass.colorAttachments[0].clearColor=MTLClearColorMake(1,0,1,1);
+        [[init renderCommandEncoderWithDescriptor:pass] endEncoding];
+    }
+    [init commit]; [init waitUntilCompleted]; if (init.error) runtime_fail("fixture initialization");
+    g.dt=1.0/30; g.cur=0; g.hist_ok=0; g.cam[56]=0.1; g.cam[57]=25000; g.cam[62]=(double)g.out_w/g.out_h; g.cam[70]=50*M_PI/180;
+    for (int s=0; s<2; s++) {
+        float *par=g.mv_par[s].contents; memset(par,0,256);
+        par[0]=par[5]=par[10]=par[15]=1; par[16]=g.in_w; par[17]=g.in_h;
+        par[18]=1.0f/g.in_w; par[19]=1.0f/g.in_h; par[20]=1;
+        g.enc_depth=depth; [allocator reset]; [command beginCommandBufferWithAllocator:allocator];
+        NSArray *resources=mfx_frame_encode(command,s,nil,0);
+        if (resources.count!=8 || g.fi.colorTexture || g.fi.depthTexture || g.fi.outputTexture) runtime_fail("frame binding ownership");
+        [command endCommandBuffer]; dispatch_semaphore_t done=dispatch_semaphore_create(0); __block NSError *gpu_error=nil;
+        MTL4CommitOptions *options=[MTL4CommitOptions new];
+        [options addFeedbackHandler:^(id<MTL4CommitFeedback> feedback) { gpu_error=feedback.error; if(resources.count!=8) abort(); dispatch_semaphore_signal(done); }];
+        const id<MTL4CommandBuffer> list[]={command}; [queue commit:list count:1 options:options];
+        if(dispatch_semaphore_wait(done,dispatch_time(DISPATCH_TIME_NOW,10*NSEC_PER_SEC)) || gpu_error) runtime_fail("fixture interpolation completion");
+    }
+    id<MTLBuffer> pixel=[device newBufferWithLength:256 options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> read=[copy_queue commandBuffer]; blit=[read blitCommandEncoder];
+    [blit copyFromTexture:g.out[1] sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(g.out_w/2,g.out_h/2,0) sourceSize:MTLSizeMake(1,1,1) toBuffer:pixel destinationOffset:0 destinationBytesPerRow:256 destinationBytesPerImage:256];
+    [blit endEncoding]; [read commit]; [read waitUntilCompleted]; if(read.error) runtime_fail("fixture readback");
+    const uint8_t *rgb=pixel.contents; if(rgb[0]>4 || rgb[1]>4 || rgb[2]>4) runtime_fail("fixture black output remained unwritten/incorrect");
