+"""Reject legacy relative-output CLIs in the source checkout; imports stay side-effect-free."""
+from pathlib import Path
+
+
+def require_external_worktree(script):
+    path = Path(script).resolve()
+    for parent in path.parents:
+        if (parent / 'repository-policy.json').is_file():
+            raise SystemExit(
+                'This command writes generated data and cannot run inside the source checkout. '
+                'Prepare an external tree with build_app.py --work EXTERNAL_WORK, '
+                'then run the command under EXTERNAL_WORK/totk (or make -C EXTERNAL_WORK/totk TARGET). '
+                'Do not recreate source build/analysis/extracted/rewritten directories.')
