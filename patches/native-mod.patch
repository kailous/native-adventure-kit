+"""Host checks for the production launcher's bounded GPU memory policy."""
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+class GpuBudgetTests(unittest.TestCase):
+    def test_ram_sizes_and_protection(self):
+        source = r'''
+#include <assert.h>
+#include "gpu_budget_policy.h"
+int main(void) {
+    assert(totk_gpu_budget_mb(0) == 5000);
+    assert(totk_gpu_budget_mb(1) == 1);
+    assert(totk_gpu_budget_mb(8ULL << 30) == 3276);
+    assert(totk_gpu_budget_mb(16ULL << 30) == 6553);
+    assert(totk_gpu_budget_mb(24ULL << 30) == 8192);
+    assert(totk_gpu_budget_mb(128ULL << 30) == 8192);
+    assert(totk_gpu_budget_mb(UINT64_MAX) == 8192);
+}
+'''
