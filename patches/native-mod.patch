new file mode 100644
index 0000000000000000000000000000000000000000..5b2bf3365878234f208c61715aab03166d8da3b0
--- /dev/null
+++ b/tests/test_animation_research.py
@@ -0,0 +1,60 @@
+"""Offline research guards and append-only behavior; no game data or toolkit needed."""
+import copy
+import io
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'games/totk/scripts/animation_research'))
+from inspect_resources import external_output, read_resource, sarc_members
+from probe_asb import append_command, originals_preserved, NODE_GUID
+
+
+class AnimationResearchTests(unittest.TestCase):
+    def graph(self):
+        return {'Metadata': {'Filename': 'Fake'}, 'Commands': [{'Name': 'Wait', 'GUID': 'original', 'Node Index': 0}],
+                'Nodes': [{'Node Index': 0, 'Node Type': 'SkeletalAnimation', 'No State Transition': True,
+                           'GUID': 'old-node', 'Body': {'Animation': 'Nml_Wait', 'Unknown 1': 1,
+                                                      'Unknown 2': 0, 'Unknown 3': False, 'Unknown 4': 0.0,
+                                                      'Events': [1]}}], 'Transitions': ['keep']}
+
+    def test_append_preserves_original_and_does_not_share_events(self):
+        original = self.graph()
+        saved = copy.deepcopy(original)
+        modified = append_command(original)
+        self.assertEqual(original, saved)
+        self.assertTrue(originals_preserved(original, modified))
+        self.assertNotIn('Events', modified['Nodes'][-1]['Body'])
+        self.assertEqual(modified['Commands'][-1]['Node Index'], 1)
+        modified['Nodes'][0]['Body']['Animation'] = 'changed'
+        self.assertFalse(originals_preserved(original, modified))
+
+    def test_duplicate_or_unknown_layout_refused(self):
+        with self.assertRaises(ValueError):
+            append_command(append_command(self.graph()))
+        graph = self.graph()
+        graph['Nodes'][0]['GUID'] = NODE_GUID
+        with self.assertRaises(ValueError):
+            append_command(graph)
+        graph = self.graph()
+        graph['Nodes'][0]['Node Index'] = 5
+        with self.assertRaises(ValueError):
+            append_command(graph)
+
+    def test_output_boundaries(self):
+        with tempfile.TemporaryDirectory() as folder:
+            source = Path(folder) / 'source'
+            with self.assertRaises(ValueError):
+                external_output(source / 'generated', source)
+            with self.assertRaises(ValueError):
+                external_output(Path(folder) / 'input/out', source, Path(folder) / 'input')
+
+    def test_resource_ranges_and_invalid_archive(self):
+        for row in ({'offset': -1, 'size': 1}, {'offset': True, 'size': 1},
+                    {'offset': 2, 'size': 3}, {'offset': 0, 'size': 0}):
+            with self.assertRaises(ValueError):
+                read_resource(io.BytesIO(b'abcd'), row, 4)
+        self.assertEqual(read_resource(io.BytesIO(b'abcd'), {'offset': 1, 'size': 2}, 4), b'bc')
+        with self.assertRaises(ValueError):
+            sarc_members(b'bad')
