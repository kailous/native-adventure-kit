+#!/usr/bin/env python3
+"""Bounded 1.4.3 ABBA comparison using copied saves; never touches the player's save.
+
+Uses the standard game slot and stops the entire comparison on real input.
+The OS Metal cache is not cleared: ABBA balances, but cannot remove, driver-cache bias.
+Reported long frames are the runtime's logged subset, not all frames or an FPS benchmark.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import socket
+import struct
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).resolve().parent/'dev'))
+from game_slot import GameSlot
+
+LONG = re.compile(r'\[长帧\].*?整帧 ([\d.]+) ms.*?新建管线 (\d+) 条 \+ 着色器库 (\d+) 个共 ([\d.]+) ms')
+
+
+def facts(text):
+    rows = [tuple(map(float, row)) for row in LONG.findall(text)]
+    return dict(logged_long_frames=len(rows), over_100ms=sum(r[0] > 100 for r in rows),
+                worst_logged_ms=max((r[0] for r in rows), default=0),
+                logged_compile_ms=sum(r[3] for r in rows),
+                logged_pipeline_builds=sum(int(r[1]) for r in rows))
+
+
+def trial(args, kind, index):
+    out = args.output/f'{index:02d}-{kind}';out.mkdir(parents=True)
+    profile = args.profile_root/out.name;profile.mkdir(parents=True)
+    shutil.copytree(args.profile_source/'save', profile/'save')
+    shutil.copy2(args.profile_source/'account.uid', profile/'account.uid')
+    # Same 1440p native render, no interpolation/TAA/HUD; only prediction differs.
+    (profile/'native-display.cfg').write_text('3 2 1 0 0 0 0 0 0 0\n')
+    commands=out/'input.txt';commands.write_text('')
+    binary=getattr(args, kind)
+    env=os.environ | dict(TOTK_PROFILE_DIR=str(profile),TOTK_SHADER_CACHE=str(profile/'shader-cache'),
+        TOTK_SHADER_SEED_DIR=str(args.work/'build/shader-seed/v143'),TOTK_INPUT_FILE=str(commands),
+        TOTK_WINDOW_SIZE='512x288',TOTK_WINDOW_ANCHOR='bottom-right',TOTK_FULLSCREEN_TEST_INHIBIT='1',
+        TOTK_ASSUME_FOCUS='1',TOTK_AUTOLOAD='1',TOTK_UI_LANG='zh',TOTK_MENUBAR_FPS='0',TOTK_TITLE_FPS='0',
+        TOTK_GPU_ALLOW_SUBMIT='1',TOTK_GPU_WIDEN='1',TOTK_GPU_BLOCKRT='1',TOTK_GPU_MIDCLEAR='1',
+        TOTK_GPU_BUDGET_MB='5000',DM_PSO_MANIFEST='off',TOTK_PIPELINE_ARCHIVE='0',
+        TOTK_PSO_PREDICT_KEYS='32' if kind=='baseline' else '64',
+        TOTK_PSO_RESCANS='0' if kind=='baseline' else '32',
+        TOTK_GAME_SLOT_DIR=str(args.slot))
+    if args.inspect:
+        env.pop('DM_PSO_MANIFEST',None);env.pop('TOTK_PIPELINE_ARCHIVE',None)
+    for name in ('TOTK_INPUT_SCRIPT','TOTK_SURVEY','DM_NVN_TSV','TOTK_SHADER_PREFETCH'):
+        env.pop(name,None)
+    report=dict(kind=kind,binary=str(binary),sha256=hashlib.sha256(binary.read_bytes()).hexdigest(),
+        profile=str(profile),status='starting',events=[],scope='logged long frames; cold application cache, shared OS driver cache')
+    path=out/'report.json';logpath=out/'game.log'
+    def save():path.write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\n')
+    save();taken=False
+    with GameSlot(owner='codex',purpose='PR166 ABBA '+out.name,expect_seconds=int(args.seconds+190)) as slot:
+        with logpath.open('wb') as log:
+            game=slot.popen([str(binary),'rewritten/v143','boot'],cwd=args.work,env=env,stdout=log,stderr=log)
+        report.update(pid=game.pid,token=slot.token,status='running');save()
+        def check():
+            nonlocal taken
+            text=logpath.read_text(errors='replace')
+            if slot.preempted or '[input] user input' in text:
+                taken=True
+                raise RuntimeError('user takeover: no further control, game left open')
+            if game.poll() is not None:raise RuntimeError('game exited: '+str(game.returncode))
+            return text
+        def send(command):
+            check()
+            with commands.open('a') as f:f.write(command+'\n')
+            report['events'].append(dict(at=time.monotonic()-started,command=command));save()
+        started=time.monotonic()
+        try:
+            deadline=started+150;request=1;ready=None
+            with socket.socket(socket.AF_INET,socket.SOCK_DGRAM) as sock:
+                sock.settimeout(.3)
+                while time.monotonic()<deadline:
+                    check();sock.sendto(struct.pack('<4sBBBBQd',b'TKC1',1,0,0,0,request,0),('127.0.0.1',7075));request+=1
+                    try:
+                        state=json.loads(sock.recvfrom(8192)[0])
+                        if state.get('code')==0 and state.get('link',{}).get('available'):
+                            ready=time.monotonic();break
+                    except (socket.timeout,ValueError):pass
+                    time.sleep(.2)
+            if ready is None:raise RuntimeError('timed out waiting for player-ready status')
+            report['player_ready_seconds']=ready-started
+            offset=len(check());send('wshot '+str(out/'ready.png'));send('hudshot '+str(out/'hud.png'))
+            # Fixed camera-only route, no movement, save actions or display shortcuts.
+            report['ready']=True;save()
+            print(json.dumps(dict(kind=kind,pid=game.pid,ready=True,output=str(out)),ensure_ascii=False),flush=True)
+            camera=() if args.inspect else (5,13,21);done=set()
+            while time.monotonic()-ready<args.seconds:
+                check();elapsed=time.monotonic()-ready
+                for at in camera:
+                    if elapsed>=at and at not in done:
+                        send('key 124 1500');done.add(at)
+                time.sleep(.25)
+            text=check();report.update(status='passed',startup_and_route=facts(text),route_only=facts(text[offset:]))
+            report['prediction_statistics']=[line for line in text.splitlines() if '并行预编 至提交' in line]
+            send('wshot '+str(out/'end.png'));time.sleep(.5);send('close');game.wait(timeout=25)
+            report['input_commands']=commands.read_text()
+            report['exit_code']=game.returncode
+            if game.returncode:report['status']='failed'
+        except Exception as error:
+            report.update(status='user-takeover' if taken else 'failed',error=str(error))
+            if not taken and game.poll() is None:
+                with commands.open('a') as f:f.write('close\n')
+                try:game.wait(timeout=25)
+                except Exception:pass
+        finally:save()
+    return report
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    for name in ('baseline','candidate','work','output','profile-source','profile-root','slot'):
+        p.add_argument('--'+name,type=Path,required=True)
+    p.add_argument('--seconds',type=float,default=32)
+    p.add_argument('--inspect',action='store_true',help='one guarded candidate session for menu/HUD and normal-play inspection')
+    args=p.parse_args()
+    for key,value in vars(args).items():
+        if isinstance(value,Path):setattr(args,key,value.expanduser().resolve())
+    if not 25<=args.seconds<=(600 if args.inspect else 60):p.error('invalid measurement/inspection duration')
+    if not args.profile_root.is_relative_to(Path.home()/'Library/Application Support/MacNativeGames/TOTK/tests'):
+        p.error('profile-root must be below the dedicated TOTK/tests folder')
+    os.environ['TOTK_GAME_SLOT_DIR']=str(args.slot)
+    args.output.mkdir(parents=True,exist_ok=True)
+    if (args.output/'report.json').exists():p.error('output already has comparison evidence')
+    result=dict(status='running',order=['candidate'] if args.inspect else ['baseline','candidate','candidate','baseline'],runs=[],
+                limitations=['OS driver cache stays shared; ordering reduces but does not eliminate bias',
+                             'one copied save and camera route only; no full-game performance claim',
+                             'long-frame log is a filtered subset; no average FPS or percentile derived from it'])
+    if args.inspect:result['limitations'].append('functional HUD/menu inspection, not an ABBA performance comparison')
+    path=args.output/'report.json'
+    for i,kind in enumerate(result['order'],1):
+        run=trial(args,kind,i);result['runs'].append(run)
+        if run['status']!='passed':result['status']=run['status']
+        path.write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n')
+        print(json.dumps(dict(run=i,kind=kind,status=run['status'],facts=run.get('route_only')),ensure_ascii=False),flush=True)
+        if run['status']!='passed':break
+    if len(result['runs'])==len(result['order']) and all(r['status']=='passed' for r in result['runs']):result['status']='passed'
+    path.write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n')
+    return 0 if result['status']=='passed' else 1
+
+
+if __name__=='__main__':raise SystemExit(main())
