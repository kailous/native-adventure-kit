+ nc_append(out,cap,&n,"\"healthLocked\":%s,\"lockedHearts\":%.2f,\"staminaLocked\":%s,\"lockedStamina\":%.3f,\"rupeesLocked\":%s,\"lockedRupees\":%d,\"arrowsLocked\":%s,\"lockedArrows\":%d,\"healthCapEnabled\":%s,\"healthCap\":%.2f,\"items99Enabled\":%s,\"itemsSupported\":false,",nc_health_lock?"true":"false",nc_health_lock?nc_health_value/4.f:-1,nc_stamina_lock?"true":"false",nc_stamina_lock?nc_stamina_value/1000.f:-1,nc_money_lock?"true":"false",nc_money_lock?nc_money_value:-1,nc_arrows_lock?"true":"false",nc_arrows_lock?nc_arrows_value:-1,nc_cap?"true":"false",nc_cap_value/4.f,ni_enabled?"true":"false");
+ uintptr_t world=nw_world(v->has_hp&&v->health>0);
+ nc_append(out,cap,&n,"\"weather\":{\"available\":%s,\"lastRequestedId\":%d,\"locked\":%s,\"engineRequestedId\":%d},",world?"true":"false",nw_last,nw_locked?"true":"false",nw_readback(world));
+ int32_t durability[3]={-1,-1,-1};
+ for(unsigned i=0;i<3;i++){int32_t max=0;if(!nc_equipped(v->root,i,&durability[i],&max))durability[i]=-1;}
+ nc_append(out,cap,&n,"\"durability\":[%d,%d,%d],\"durabilityModes\":[%d,%d,%d],\"durabilityScope\":\"pouch\",\"durabilityCounts\":[%d,%d,%d],",durability[0],durability[1],durability[2],pc_modes[0],pc_modes[1],pc_modes[2],nc_bag_ready[0]?(int)nc_bags[0].count:-1,nc_bag_ready[1]?(int)nc_bags[1].count:-1,nc_bag_ready[2]?(int)nc_bags[2].count:-1);
+ nc_append(out,cap,&n,"\"capabilities\":{\"playerValues\":%s,\"linkInput\":%s,\"pouchDurability\":%s,\"itemQuantities99\":%s,\"weather\":%s,\"spawn\":%s},",supported,supported,supported,supported,nw_world(v->has_hp&&v->health>0)?"true":"false",ns_available(nc_main,v->has_hp)?"true":"false");
