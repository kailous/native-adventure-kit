diff --git a/games/totk/runtime/title_exit_hooks.h b/games/totk/runtime/title_exit_hooks.h
new file mode 100644
index 0000000000000000000000000000000000000000..d7c8a563095d83ebe6d85ad748388eee0e2004fd
--- /dev/null
+++ b/games/totk/runtime/title_exit_hooks.h
@@ -0,0 +1,29 @@
+/* 1.4.3 SeqExecuteWaitScreenButtonInput::enter. The game's title button
+ * controller performs navigation, hit testing, sound and confirm animation.
+ * Only its completed Title_00 / Pa_Button_05 result requests desktop exit. */
+static DisplayGuestFn title_exit_wait_original;
+extern void runtime_front_request_close(void) __attribute__((weak));
+static int title_exit_requested;
+static uint64_t title_exit_wait(uintptr_t object,uintptr_t b,uintptr_t c,uint32_t d){
+ uintptr_t listener,selected,param,screen;
+ memcpy(&listener,(void *)(object+0x30),8);
+ memcpy(&selected,(void *)(object+0x40),8);
+ memcpy(&param,(void *)(object+0xd8),8);param&=~(uintptr_t)3;
+ if(!listener&&selected&&param){
+  memcpy(&screen,(void *)param,8);
+  if(screen&&!strcmp((const char *)screen,"Title_00")&&!strcmp((const char *)selected,"Pa_Button_05")){
+   if(!title_exit_requested){title_exit_requested=1;fprintf(stderr,"[totk-title] game menu confirmed: exit to desktop\n");if(runtime_front_request_close)runtime_front_request_close();}
+   return 0;
+  }
+ }
+ return title_exit_wait_original(object,b,c,d);
+}
+static void patch_title_exit(Module *m,uint64_t *cursor,uint64_t limit){
+ (void)cursor;(void)limit;
+ uintptr_t old;const uint32_t slot=0x36e2a38;
+ memcpy(&old,m->base+slot,8);
+ if(old!=(uintptr_t)m->base+0x1fe4104)runtime_fail("1.4.3 title confirm virtual slot guard");
+ title_exit_wait_original=(DisplayGuestFn)old;
+ void *wrapped=runtime_hle_wrap_named((void *)title_exit_wait,"NativeTitleExit");
+ memcpy(m->base+slot,&wrapped,8);
+}
diff --git a/games/totk/runtime/virtual_input.c b/games/totk/runtime/virtual_input.c
new file mode 100644
index 0000000000000000000000000000000000000000..93d11ebc0993fa1efa81d1cf5c15c614ffc06425
--- /dev/null
+++ b/games/totk/runtime/virtual_input.c
@@ -0,0 +1,69 @@
+/* Host-native equivalent of the bounded NSO link_input adapter. No guest pointers. */
+#include "virtual_input.h"
+#include <pthread.h>
+#include <string.h>
+static pthread_mutex_t vi_lock=PTHREAD_MUTEX_INITIALIZER;
+static RuntimeVirtualPayload vi_steps[8];
+static unsigned vi_count,vi_index;
+static bool vi_menu,vi_ready;
+static uint64_t vi_deadline,vi_observed,vi_ready_tick;
+static void vi_clear(void){vi_count=vi_index=0;vi_deadline=0;vi_menu=false;memset(vi_steps,0,sizeof vi_steps);}
+static bool vi_recent(uint64_t tick,uint64_t now){return tick && now>=tick && now-tick<500000000ULL;}
+static bool vi_available(uint64_t now){return vi_ready && vi_recent(vi_ready_tick,now) && vi_recent(vi_observed,now);}
+static bool vi_menu_available(uint64_t now){return !vi_ready && vi_recent(vi_ready_tick,now) && vi_recent(vi_observed,now);}
+static void vi_advance(uint64_t now){
+ bool allowed=vi_menu?vi_menu_available(now):vi_available(now);
+ if(!allowed){vi_clear();return;}
+ while(vi_count && now>=vi_deadline){
+  if(++vi_index>=vi_count){vi_clear();break;}
+  vi_deadline+=(uint64_t)vi_steps[vi_index].duration_ms*1000000ULL;
+ }
+}
+bool runtime_virtual_valid(const RuntimeVirtualPayload *steps,unsigned count,bool menu){
+ if(!steps || !count || count>8 || (menu && count!=1))return false;
+ uint32_t total=0;
+ for(unsigned i=0;i<count;i++){
+  const RuntimeVirtualPayload *p=&steps[i];
+  if((p->buttons&~0xffffu)||!p->duration_ms||p->duration_ms>5000 ||
+     p->lx<-32767||p->lx>32767||p->ly<-32767||p->ly>32767||
+     p->rx<-32767||p->rx>32767||p->ry<-32767||p->ry>32767)return false;
+  if(menu && (p->duration_ms>250 || (p->buttons!=1 && p->buttons!=(1u<<13) && p->buttons!=(1u<<15)) || p->lx||p->ly||p->rx||p->ry))return false;
+  total+=p->duration_ms;
+ }
+ return total<=5000;
+}
+bool runtime_virtual_set(const RuntimeVirtualPayload *steps,unsigned count,bool menu,uint64_t now){
+ if(!runtime_virtual_valid(steps,count,menu))return false;
+ pthread_mutex_lock(&vi_lock);
+ bool available=menu?vi_menu_available(now):vi_available(now);
+ if(available){memcpy(vi_steps,steps,count*sizeof *steps);vi_count=count;vi_index=0;vi_menu=menu;vi_deadline=now+(uint64_t)steps[0].duration_ms*1000000ULL;}
+ pthread_mutex_unlock(&vi_lock);return available;
+}
+void runtime_virtual_stop(void){pthread_mutex_lock(&vi_lock);vi_clear();pthread_mutex_unlock(&vi_lock);}
+void runtime_virtual_ready(bool ready,uint64_t now){
+ pthread_mutex_lock(&vi_lock);
+ if(ready!=vi_ready || !vi_recent(vi_ready_tick,now))vi_clear();
+ vi_ready=ready;vi_ready_tick=now;
+ pthread_mutex_unlock(&vi_lock);
+}
+RuntimeVirtualSnapshot runtime_virtual_snapshot(uint64_t now){
+ RuntimeVirtualSnapshot out={0};pthread_mutex_lock(&vi_lock);
+ vi_advance(now);out.available=vi_available(now);out.active=vi_count>0;
+ if(out.active){out.input=vi_steps[vi_index];out.remaining_ms=(uint32_t)((vi_deadline-now+999999)/1000000);
+  for(unsigned i=vi_index+1;i<vi_count;i++)out.remaining_ms+=vi_steps[i].duration_ms;}
+ pthread_mutex_unlock(&vi_lock);return out;
+}
+static void vi_axis(uint64_t *buttons,int32_t *x,int32_t *y,int32_t vx,int32_t vy,unsigned shift){
+ if(!vx&&!vy)return;
+ *buttons&=~(UINT64_C(15)<<shift);
+ if(vx<-16400)*buttons|=UINT64_C(1)<<shift;
+ if(vy>16400)*buttons|=UINT64_C(1)<<(shift+1);
+ if(vx>16400)*buttons|=UINT64_C(1)<<(shift+2);
+ if(vy<-16400)*buttons|=UINT64_C(1)<<(shift+3);
+ *x=vx;*y=vy;
+}
+void runtime_virtual_mix(uint64_t *buttons,int32_t *lx,int32_t *ly,int32_t *rx,int32_t *ry,uint64_t now){
+ pthread_mutex_lock(&vi_lock);vi_observed=now;vi_advance(now);
+ if(vi_count){RuntimeVirtualPayload *p=&vi_steps[vi_index];*buttons|=p->buttons;vi_axis(buttons,lx,ly,p->lx,p->ly,16);vi_axis(buttons,rx,ry,p->rx,p->ry,20);}
+ pthread_mutex_unlock(&vi_lock);
+}
