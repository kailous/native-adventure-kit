+/* An unsupported game layout still negotiates its version and never runs old
+   offsets, mutation handlers, virtual input, or preference restoration. */
+#include <assert.h>
+#include "../runtime/virtual_input.c"
+#include "nfp_stubs.h"
+#include "../runtime/native_control.c"
+#include "../runtime/telemetry.c"
+uint64_t runtime_now_ns(void){return 2000000000ULL;}
+uint8_t *runtime_module_base(const char *name){(void)name;return (uint8_t *)1;}
+const Module *runtime_module_info(const char *name){(void)name;return NULL;}
+void runtime_guest_heap_range(uintptr_t *base,size_t *size){*base=0;*size=0;}
+int main(void){
+ telemetry_init();assert(main_base==1&&nc_main==1);
+ NCValues values=nc_values();assert(!values.has_hp&&!values.has_money);
+ NCRequest r={{'T','K','C','1'},1,0,0,0,1,0};assert(nc_execute(&r,&values,runtime_now_ns())==0);
+#if CONTROL_LAYOUT_SUPPORTED
+ r.op=26;assert(nc_execute(&r,&values,runtime_now_ns())==(CONTROL_SPAWN_ABI_SUPPORTED?1:4));
+#else
+ for(unsigned op=1;op<=27;op++){r.op=(uint8_t)op;assert(nc_execute(&r,&values,runtime_now_ns())==4);}
+#endif
+ char reply[4096];assert(nc_encode(reply,sizeof reply,1,0,&values,runtime_now_ns())>0);
+ assert(strstr(reply,"\"gameVersion\":\"" TOTK_GAME_VERSION "\""));
+#if CONTROL_LAYOUT_SUPPORTED
+ assert(strstr(reply,"\"playerValues\":true")&&strstr(reply,"\"spawn\":false")&&strstr(reply,"\"controlLayoutSupported\":true"));
+#else
+ assert(strstr(reply,"\"playerValues\":false")&&strstr(reply,"\"itemQuantities99\":false")&&strstr(reply,"\"controlLayoutSupported\":false"));
+#endif
+ Snapshot snap={.tick=runtime_now_ns()};assert(build_packet(&snap,1,reply,sizeof reply)>0);
+ assert(strstr(reply,"\"adapterSupported\":true"));
+ assert(strstr(reply,"\"connected\":false"));puts(reply);return 0;
+}
