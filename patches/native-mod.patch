+#include <math.h>
+#include <stdio.h>
+
+int main(int argc,const char **argv){@autoreleasepool{
+ if(argc!=2)return 2;
+ NSError *error=nil;id<MTLDevice>d=MTLCreateSystemDefaultDevice();
