+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+REPO = Path(__file__).resolve().parents[1]
+GAME = REPO / 'games/totk'
+SPEC = importlib.util.spec_from_file_location('worktree_paths', GAME / 'scripts/worktree_paths.py')
+paths = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(paths)
+
+
+class SourceWorktreeTests(unittest.TestCase):
+    def test_legacy_source_driver_stops_before_creating_artifacts(self):
+        run = subprocess.run([sys.executable, '-B', str(GAME / 'scripts/prepare_runtime.py')],
+                             text=True, capture_output=True)
+        self.assertNotEqual(run.returncode, 0)
+        self.assertIn('external tree', run.stderr)
+
+    def test_external_tree_is_allowed(self):
+        with tempfile.TemporaryDirectory() as folder:
+            script = Path(folder) / 'totk/scripts/prepare_runtime.py'
+            script.parent.mkdir(parents=True)
+            script.write_text('')
+            paths.require_external_worktree(script)
+
+    def test_source_make_runtime_target_refused(self):
+        run = subprocess.run(['make', '-n', 'runtime'], cwd=GAME, text=True, capture_output=True)
+        self.assertNotEqual(run.returncode, 0)
+        self.assertIn('EXTERNAL_WORK', run.stderr)
+
+    @unittest.skipUnless(sys.platform == 'darwin', 'macOS slot ABI')
+    def test_c_and_python_defaults_match_launcher_without_touching_real_profile(self):
+        spec = importlib.util.spec_from_file_location('game_slot_test_defaults', GAME / 'scripts/dev/game_slot.py')
+        slot = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(slot)
+        with tempfile.TemporaryDirectory(prefix='totk slot migration ') as folder:
+            home = Path(folder)
+            driver = home / 'slot.c'
+            driver.write_text('#include <stdio.h>\n#include <stdlib.h>\n'
+                              f'#include "{GAME / "runtime/game_slot.c"}"\n'
+                              '_Noreturn void runtime_fail(const char *s){fprintf(stderr,"%s",s);exit(1);}\n'
+                              'int main(void){slot_dir_init();puts(slot_dir);return 0;}\n')
+            binary = home / 'slot-probe'
+            subprocess.run(['xcrun','clang','-std=c11','-O1','-Wall','-Wextra','-Werror',str(driver),'-o',str(binary)], check=True, capture_output=True)
+            env = os.environ.copy()
+            env['HOME'] = str(home)
+            env.pop('TOTK_GAME_SLOT_DIR', None)
+            run = subprocess.run([str(binary)], env=env, check=True, text=True, capture_output=True)
+            from unittest.mock import patch
+            with patch.dict(os.environ, env, clear=True):
+                python_default = slot.slot_dir()
+            self.assertEqual(run.stdout.strip(), str(python_default))
+            self.assertEqual(python_default, (home / 'Library/Application Support/MacNativeGames/TOTK/game-slot').resolve())
+
+
+if __name__ == '__main__':
+    unittest.main()
