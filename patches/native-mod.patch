--- /dev/null
+++ b/games/totk/runtime/quantity_control.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Quantity arrays are resolved by field hash and their declared lengths.
+   Empty slots remain -1; no sparse stepping past an array's end. */
+#pragma once
+#define NI_CAPACITY 1024
+typedef struct {uintptr_t data[3];unsigned slots[3];int32_t values[3][NI_CAPACITY];} NIItems;
+static NIItems ni_items;static bool ni_enabled;
+static bool ni_load(NIItems *items){
+ static const uint32_t quantities[]={0xde2d8500,0x2a952a60,0x60d16ab0},names[]={0xd96ebf12,0x7c0f89ad,0xa86f2f10};
+ memset(items,0,sizeof *items);uintptr_t manager=nc_follow(nc_main,CONTROL_DATA_SLOT);
+ for(unsigned category=0;category<3;category++){
+  items->data[category]=pc_array_limit(manager,3,quantities[category],64,NI_CAPACITY,&items->slots[category]);
+  uintptr_t name_object=pc_object(manager,17,names[category],144);uint64_t name_count=0;
+  if(!items->data[category]||!name_object||!nc_read(nc_field(name_object,0x70),&name_count,8)||name_count!=items->slots[category]||!nc_read(items->data[category],items->values[category],items->slots[category]*4))return false;
+  for(unsigned i=0;i<items->slots[category];i++)if(items->values[category][i]<-1||items->values[category][i]>999)return false;
+ }
+ return true;
+}
+static bool ni_apply(const NIItems *items){
+ for(unsigned c=0;c<3;c++)if(!items->slots[c]||items->slots[c]>NI_CAPACITY||!runtime_guest_writable(items->data[c],items->slots[c]*4))return false;
+ for(unsigned c=0;c<3;c++)for(unsigned i=0;i<items->slots[c];i++)if(items->values[c][i]>=0&&items->values[c][i]!=99&&!nc_i32(nc_field(items->data[c],i*4),99))return false;
+ return true;
+}
