@@ -0,0 +1,28 @@
+#import "../games/totk/runtime/danmaku_overlay.h"
+#include <assert.h>
+static NSData *packet(NSDictionary *settings,NSString *body){return [NSJSONSerialization dataWithJSONObject:@{@"protocol":@"totk-danmaku/1",@"kind":@"chat",@"settings":settings,@"user":@"测试观众",@"text":body} options:0 error:nil];}
+int main(int argc,char **argv){@autoreleasepool{
+ [NSApplication sharedApplication];
+ TOTKDanmakuView *v=[[TOTKDanmakuView alloc] initWithFrame:NSMakeRect(0,0,512,288) port:0];
+ assert(![v hitTest:NSMakePoint(10,10)]&&![v acceptsFirstResponder]&&![v isOpaque]);
+ NSMutableDictionary *s=[@{@"enabled":@YES,@"nickname":@YES,@"mode":@"fade",@"position":@"top",@"fontSize":@24,@"speed":@120,@"duration":@5} mutableCopy];
+ [v ingest:[@"invalid" dataUsingEncoding:NSUTF8StringEncoding] now:100];assert(v.messages.count==0);
+ for(int i=0;i<100;i++)[v ingest:packet(s,@"你好，海拉鲁！ 🐱") now:100];
+ assert(v.messages.count==2);assert([v.messages[0][@"text"] containsString:@"测试观众"]);
+ [v advance:106];assert(v.messages.count==0);
+ s[@"nickname"]=@NO;[v ingest:packet(s,@"只有内容") now:110];assert([v.messages[0][@"text"] isEqual:@"只有内容"]);
+ s[@"enabled"]=@NO;[v ingest:packet(s,@"不可见") now:111];assert(v.messages.count==0);
+ s[@"enabled"]=@YES;s[@"mode"]=@"scroll";double now=NSProcessInfo.processInfo.systemUptime;
+ [v ingest:packet(s,@"游戏内弹幕：你好，海拉鲁！") now:now-3];assert(v.messages.count==1);
+ if(argc>1){
+  NSBitmapImageRep *bitmap=[[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:512 pixelsHigh:288 bitsPerSample:8 samplesPerPixel:4 hasAlpha:YES isPlanar:NO colorSpaceName:NSCalibratedRGBColorSpace bytesPerRow:0 bitsPerPixel:0];
+  [v cacheDisplayInRect:v.bounds toBitmapImageRep:bitmap];
+  [[bitmap representationUsingType:NSBitmapImageFileTypePNG properties:@{}] writeToFile:@(argv[1]) atomically:YES];
+ }
+ // A real local datagram enters through the production timer/receiver.
+ struct sockaddr_in addr={0};socklen_t length=sizeof(addr);assert(getsockname(v.socketFD,(struct sockaddr *)&addr,&length)==0);
+ int fd=socket(AF_INET,SOCK_DGRAM,0);NSData *wire=packet(s,@"loopback");assert(sendto(fd,wire.bytes,wire.length,0,(struct sockaddr *)&addr,length)==(ssize_t)wire.length);close(fd);
+ [NSRunLoop.mainRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:.05]];
+ assert(v.messages.count>=1);[v advance:now+100];assert(v.messages.count==0);
+ [v.timer invalidate];puts("danmaku host: pass (UTF-8, limits, expiry, settings, input pass-through, loopback)");
+}return 0;}
