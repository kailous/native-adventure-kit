new file mode 100644
index 0000000000000000000000000000000000000000..26e9f8e9ab9f5d35c80b4823465b143deb85d1ba
--- /dev/null
+++ b/games/totk/scripts/probe_paths.py
@@ -0,0 +1,55 @@
+"""External workspace for standalone host probes (no game saves)."""
+import os
+from pathlib import Path
+
+SOURCE_ROOT = Path(__file__).resolve().parents[3]
+
+
+def probe_work():
+    path = Path(os.environ.get('TOTK_TEST_WORK', '/tmp/totk-native-host-tests')).expanduser().resolve()
+    if path == SOURCE_ROOT or SOURCE_ROOT in path.parents:
+        raise ValueError('TOTK_TEST_WORK must be outside the MacNativeGames source checkout')
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def probe_binary(name):
+    path = probe_work() / 'host-tests' / name
+    path.parent.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def probe_report(name):
+    path = probe_work() / 'reports' / name
+    path.parent.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def probe_input():
+    """Explicit external native work tree for extracted assets and translator tools."""
+    value = os.environ.get('TOTK_TEST_INPUT')
+    if not value:
+        raise SystemExit('Set TOTK_TEST_INPUT to an external native work tree containing build/, extracted/ and tooling/')
+    path = Path(value).expanduser().resolve()
+    if path == SOURCE_ROOT or SOURCE_ROOT in path.parents:
+        raise ValueError('TOTK_TEST_INPUT must be outside the MacNativeGames source checkout')
+    if not path.is_dir():
+        raise ValueError(f'TOTK_TEST_INPUT does not exist: {path}')
+    return path
+
+
+def require_inputs(root, *names):
+    missing = [str(root / name) for name in names if not (root / name).is_file()]
+    if missing:
+        raise SystemExit('Missing verification inputs (not accepted):\n' + '\n'.join(missing))
+
+
+def run_metal_probe(arguments, **kwargs):
+    """Share the production GPU slot; give way to the user's game."""
+    import subprocess
+    import sys
+    driver = Path(__file__).resolve().parent / 'dev/game_slot.py'
+    command = [sys.executable, str(driver), 'run', '--no-retry',
+               '--purpose', 'standalone Metal shader compilation',
+               '--expect-seconds', '30', '--', str(probe_binary('metal-shader-probe'))]
+    return subprocess.run(command + [str(arg) for arg in arguments], **kwargs)
