+/* Figma 70:12. Native game boot overlay; all progress is from real runtime callbacks.
+ * Asset source: games/totk/assets/branding/loading, copied into the game bundle.
+ * This view does not start the game, verify data, fabricate totals, or own Metal. */
+#pragma once
+#import <AppKit/AppKit.h>
+#import <CoreText/CoreText.h>
+#include <math.h>
+#include "game_version.h"
+#include "totk_ui_lang.h"
+
+/* execv runs the game from Contents/Resources/totk/build. Its main bundle may
+ * therefore be the executable directory, not the outer .app. Prefer verified
+ * local asset roots and retain the launcher's canonical game working directory. */
+static NSURL *boot_loading_asset_directory(void) {
+    NSFileManager *fm=NSFileManager.defaultManager;
+    NSURL *resource=NSBundle.mainBundle.resourceURL;
+    NSMutableArray<NSURL *> *folders=[NSMutableArray new];
+    if(resource){
+        [folders addObject:[resource URLByAppendingPathComponent:@"totk/assets/branding/loading" isDirectory:YES]];
+        [folders addObject:[[resource URLByDeletingLastPathComponent] URLByAppendingPathComponent:@"assets/branding/loading" isDirectory:YES]];
+        [folders addObject:[resource URLByAppendingPathComponent:@"assets/branding/loading" isDirectory:YES]];
+    }
+    NSURL *working=[NSURL fileURLWithPath:[fm.currentDirectoryPath stringByAppendingPathComponent:@"assets/branding/loading"] isDirectory:YES];
+    [folders addObject:working];
+    for(NSURL *folder in folders){
+        BOOL complete=YES;
+        for(NSString *name in @[@"background.png",@"logo.svg",@"footer.png"])if(![fm fileExistsAtPath:[folder URLByAppendingPathComponent:name].path]){complete=NO;break;}
+        if(complete)return folder;
+    }
+    return working;
+}
