+static void nc_apply_locks(NCValues *v){
+ if(ni_enabled&&(!v->has_hp||!ni_load(&ni_items)||!ni_apply(&ni_items)))ni_enabled=false;
+ if(nc_health_lock){if(!v->has_hp||v->hp!=nc_lock_slots[0])nc_health_lock=false;else {if(nc_health_value>v->maximum)nc_health_value=v->maximum;if(nc_cap&&nc_health_value>nc_cap_value)nc_health_value=nc_cap_value;nc_health_lock=nc_i32(v->hp,nc_health_value);}}
+ if(nc_stamina_lock){if(!v->has_stamina||v->stamina!=nc_lock_slots[1])nc_stamina_lock=false;else nc_stamina_lock=nc_float(v->stamina,nc_stamina_value)&&nc_float(v->internal,nc_stamina_value);}
+ if(nc_money_lock){if(!v->has_money||v->coins!=nc_lock_slots[2])nc_money_lock=false;else nc_money_lock=nc_i32(v->coins,nc_money_value);}
+ if(nc_arrows_lock){if(!v->has_arrows||v->arrows!=nc_lock_slots[3])nc_arrows_lock=false;else nc_arrows_lock=nc_i32(v->arrows,nc_arrows_value);}
+ if(nc_cap&&v->has_hp){int32_t hp=0;if(nc_read(v->hp,&hp,4)&&hp>nc_cap_value&&!nc_i32(v->hp,nc_cap_value))nc_cap=false;}
+}
+static int nc_nfp_reply(char *out,size_t cap,uint64_t id,int code){char state[256];runtime_nfp_status_json(state,sizeof state);return snprintf(out,cap,"{\"protocol\":\"totk-amiibo/1\",\"id\":\"%016llx\",\"code\":%d,\"runtime\":\"native\",\"gameVersion\":\"%s\",\"amiibo\":%s}",(unsigned long long)id,code,TOTK_GAME_VERSION,state);}
+static int nc_execute(const NCRequest *r,NCValues *v,uint64_t now){
+ if(r->op==29)return r->version==1&&!r->target&&!r->mode&&r->value==0?0:2;
+ if(r->op==28){
+  if(r->version!=4||r->target||r->mode||r->value!=0)return 2;
+  const unsigned char *raw=(const unsigned char *)nc_input;char model[17],uid[15];
+  for(unsigned i=0;i<8;i++)snprintf(model+2*i,3,"%02x",raw[i]);
+  for(unsigned i=0;i<7;i++)snprintf(uid+2*i,3,"%02x",raw[8+i]);
+  return runtime_nfp_scan(model,uid)?0:5;
+ }
+ if(!CONTROL_LAYOUT_SUPPORTED)return r->op==0&&!r->target&&!r->mode&&r->value==0?0:4;
+ if(!isfinite(r->value))return 2;
+ if(r->op==5||r->op==27)return 4;
+ if(r->op==24||r->op==25)return nw_execute(v->has_hp&&v->health>0,r,now);
+ if(r->op==10){
+  if(r->target||r->mode>1||r->value!=0)return 2;
+  if(!r->mode){ni_enabled=false;return 0;}
+  if(!v->has_hp||!ni_load(&ni_items)||!ni_apply(&ni_items))return 1;
+  ni_enabled=true;return 0;
+ }
+ if(r->op==26&&!CONTROL_SPAWN_ABI_SUPPORTED)return 4;
+ if(r->op==26)return ns_spawn(nc_main,v->has_hp,r->target,r->mode,r->value,now);
+ if(r->op==4){
+  unsigned i=r->target;if(i>2||r->mode>3||r->value!=0)return 2;
+  if(!r->mode){pc_modes[i]=0;nc_held[i]=0;return 0;}
+  if(!v->has_hp||!nc_bag_ready[i])return 1;
+  if(r->mode==3){memset(&pc_frozen[i],0,sizeof pc_frozen[i]);if(!pc_freeze(i,&nc_bags[i]))return 1;pc_modes[i]=3;return 0;}
+  if(!pc_apply(&nc_bags[i],r->mode))return 4;
+  int32_t cur=0,max=0;uintptr_t hp=nc_equipped(v->root,i,&cur,&max);
+  if(hp&&!nc_i32(hp,r->mode==1?1:max))return 1;
+  if(r->mode==1){pc_modes[i]=0;nc_held[i]=0;}else if(pc_modes[i]==3)memset(&pc_frozen[i],0,sizeof pc_frozen[i]);
+  return 0;
+ }
+ if(r->op==23){
+  if(r->mode||r->value!=0||!runtime_virtual_valid(nc_input,r->target,false))return 2;
+  return runtime_virtual_set(nc_input,r->target,false,now)?0:6;
+ }
+ if(r->target||((r->op!=6&&r->op!=7&&r->op!=8&&r->op!=9&&r->op!=12)&&r->mode))return 2;
+ if(r->op==13||r->op==22){
+  bool menu=r->op==22;
+  if(r->value!=0||!runtime_virtual_valid(nc_input,1,menu))return 2;
+  return runtime_virtual_set(nc_input,1,menu,now)?0:6;
+ }
+ if(r->op==14){if(r->value!=0)return 2;runtime_virtual_stop();return 0;}
+ if(r->op==0)return r->value==0?0:2;
+ if(r->op==1){
+  if(!v->has_hp)return 1;
+  if(r->value<0||r->value*4>v->maximum||floor(r->value*4)!=r->value*4)return 2;
+  if(!nc_i32(v->hp,(int32_t)(r->value*4)))return 1;
+  if(nc_health_lock){nc_health_value=(int32_t)(r->value*4);if(!nc_health_value)nc_health_lock=false;}return 0;
+ }
+ if(r->op==2){
+  if(r->value<0||r->value>3)return 2;
+  if(!v->has_stamina)return 1;
+  float value=(float)(r->value*1000);
+  if(!nc_float(v->stamina,value)||!nc_float(v->internal,value))return 1;
+  if(nc_stamina_lock)nc_stamina_value=value;return 0;
+ }
+ if(r->op==3||r->op==11){
+  bool arrows=r->op==11;double limit=arrows?999:99999999;
+  if(r->value<0||r->value>limit||floor(r->value)!=r->value)return 2;
+  if(arrows?(!v->has_hp||!v->has_arrows):!v->has_money)return 1;
+  if(!nc_i32(arrows?v->arrows:v->coins,(int32_t)r->value))return 1;
+  if(arrows&&nc_arrows_lock)nc_arrows_value=(int32_t)r->value;
+  if(!arrows&&nc_money_lock)nc_money_value=(int32_t)r->value;return 0;
+ }
+ if(r->op==6||r->op==7||r->op==8||r->op==9||r->op==12){
+  if(r->mode>1||(r->op!=9&&r->value!=0))return 2;
+  if(!r->mode){switch(r->op){case 6:nc_health_lock=false;break;case 7:nc_stamina_lock=false;break;case 8:nc_money_lock=false;break;case 9:nc_cap=false;break;case 12:nc_arrows_lock=false;break;}return 0;}
+  if(r->op==9&&(r->value<.25||r->value>40||floor(r->value*4)!=r->value*4))return 2;
+  if(!v->has_hp)return 1;
+  switch(r->op){
+   case 6:if(v->health<=0)return 2;nc_health_lock=true;nc_health_value=v->health;nc_lock_slots[0]=v->hp;break;
+   case 7:if(!v->has_stamina)return 1;nc_stamina_lock=true;nc_stamina_value=v->stamina_value;nc_lock_slots[1]=v->stamina;break;
+   case 8:if(!v->has_money)return 1;nc_money_lock=true;nc_money_value=v->rupees;nc_lock_slots[2]=v->coins;break;
+   case 9:nc_cap=true;nc_cap_value=(int32_t)(r->value*4);break;
+   case 12:if(!v->has_arrows)return 1;nc_arrows_lock=true;nc_arrows_value=v->arrow_count;nc_lock_slots[3]=v->arrows;break;
+  }return 0;
+ }
+ return 4;
+}
+void runtime_control_frame(uint64_t now){
+ if(!nc_main)return;
+#if CONTROL_PROBE_AVAILABLE
+ nc_probe(now);
+#endif
+ NCValues values=nc_values();
+ bool scene_changed=values.root!=nc_root;
+ if(!values.has_hp||values.health<=0||scene_changed)nw_clear();
+ bool changed=scene_changed||(nc_last_frame&&(now<nc_last_frame||now-nc_last_frame>500000000ULL));
+ if(!values.has_hp||(!nc_health_lock&&values.health<=0)||changed)nc_clear_locks();
+ if(changed)runtime_virtual_stop();
+ nc_root=values.root;nc_last_frame=now;
+ if(CONTROL_LAYOUT_SUPPORTED)nc_apply_locks(&values);values=nc_values();
+ nw_frame(values.has_hp&&values.health>0,now);
+ ns_observe(values.has_hp&&values.health>0&&!scene_changed,now);
+ nc_pouches(&values,atomic_load_explicit(&nc_phase,memory_order_acquire)==1);
+ runtime_virtual_ready(CONTROL_LAYOUT_SUPPORTED&&values.has_hp&&values.health>0,now);
+ int expected=1;
+ if(!atomic_compare_exchange_strong_explicit(&nc_phase,&expected,3,memory_order_acquire,memory_order_relaxed))return;
+ now=runtime_now_ns(); /* The packet may have arrived after this frame began. */
+ int code=now<nc_received||now-nc_received>NC_EXPIRY_NS?3:nc_execute(&nc_request,&values,now);
+ if(CONTROL_LAYOUT_SUPPORTED)nc_apply_locks(&values);values=nc_values();
+ runtime_virtual_ready(CONTROL_LAYOUT_SUPPORTED&&values.has_hp&&values.health>0,now);
+ nc_pouches(&values,true);
+ nc_reply_size=nc_request.op==28||nc_request.op==29?nc_nfp_reply(nc_reply,sizeof nc_reply,nc_request.id,code):nc_encode(nc_reply,sizeof nc_reply,nc_request.id,code,&values,now);
+ atomic_store_explicit(&nc_phase,2,memory_order_release);
+}
+static bool nc_decode(const unsigned char *raw,size_t size,NCRequest *r,RuntimeVirtualPayload steps[8]){
+ if(size<sizeof *r||size>NC_PACKET_MAX)return false;
+ memcpy(r,raw,sizeof *r);if(memcmp(r->magic,"TKC1",4))return false;
+ memset(steps,0,8*sizeof *steps);
+ if(r->version==1)return size==24&&r->op!=13&&r->op!=22&&r->op!=23&&r->op!=28;
+ if(r->version==2){if(size!=48||(r->op!=13&&r->op!=22))return false;memcpy(steps,raw+24,24);return true;}
+ if(r->version==4){if(size!=40||r->op!=28||raw[39])return false;memcpy(steps,raw+24,16);return true;}
+ if(r->version==3){if(r->op!=23||!r->target||r->target>8||size!=24+24u*r->target)return false;memcpy(steps,raw+24,24u*r->target);return true;}
+ return false;
+}
+static bool nc_same_peer(const struct sockaddr_in *a,const struct sockaddr_in *b){return a->sin_family==b->sin_family&&a->sin_port==b->sin_port&&a->sin_addr.s_addr==b->sin_addr.s_addr;}
+void runtime_control_network(void){
+ if(nc_socket<0)return;
+ uint64_t now=runtime_now_ns();int phase=atomic_load_explicit(&nc_phase,memory_order_acquire);
+ /* An expired queued command is cancelled atomically even if frames stalled. */
+ if(phase==1 && now>=nc_received && now-nc_received>NC_EXPIRY_NS){int expected=1;
+  if(atomic_compare_exchange_strong_explicit(&nc_phase,&expected,3,memory_order_acquire,memory_order_relaxed)){
+   nc_reply_size=nc_request.op==28||nc_request.op==29?nc_nfp_reply(nc_reply,sizeof nc_reply,nc_request.id,3):snprintf(nc_reply,sizeof nc_reply,"{\"protocol\":\"totk-control/1\",\"id\":\"%016llx\",\"code\":3}",(unsigned long long)nc_request.id);atomic_store_explicit(&nc_phase,2,memory_order_release);
+  }
+ }
+ if(atomic_load_explicit(&nc_phase,memory_order_acquire)==2){
+  if(nc_reply_size>0){sendto(nc_socket,nc_reply,(size_t)nc_reply_size,0,(struct sockaddr *)&nc_peer,sizeof nc_peer);
+   NCCached *cache=&nc_cache[nc_cache_next++%8];*cache=(NCCached){.valid=true,.peer=nc_peer,.id=nc_request.id,.until=now+10000000000ULL,.size=nc_raw_size,.reply_size=nc_reply_size};memcpy(cache->raw,nc_raw,nc_raw_size);memcpy(cache->reply,nc_reply,(size_t)nc_reply_size);
+  }
+  atomic_store_explicit(&nc_phase,0,memory_order_release);
+ }
+ if(atomic_load_explicit(&nc_phase,memory_order_acquire)!=0)return;
+ for(unsigned budget=0;budget<8;budget++){
+  unsigned char raw[NC_PACKET_MAX+1];struct sockaddr_in peer={0};socklen_t length=sizeof peer;
+  ssize_t size=recvfrom(nc_socket,raw,sizeof raw,0,(struct sockaddr *)&peer,&length);
+  if(size<0)return;
+  if(length!=sizeof peer||peer.sin_family!=AF_INET||peer.sin_addr.s_addr!=htonl(INADDR_LOOPBACK))continue;
+  NCRequest request;RuntimeVirtualPayload steps[8];if(!nc_decode(raw,(size_t)size,&request,steps))continue;
+  bool replay=false;
+  for(unsigned i=0;i<8;i++){NCCached *cache=&nc_cache[i];if(cache->valid&&now<cache->until&&request.id==cache->id&&nc_same_peer(&peer,&cache->peer)){
+    if(cache->size==(size_t)size&&!memcmp(cache->raw,raw,(size_t)size))sendto(nc_socket,cache->reply,(size_t)cache->reply_size,0,(struct sockaddr *)&peer,sizeof peer);
+    replay=true;break;
+  }}
+  if(replay)continue;
+  nc_request=request;memcpy(nc_input,steps,sizeof nc_input);nc_received=now;nc_peer=peer;nc_raw_size=(size_t)size;memcpy(nc_raw,raw,(size_t)size);
+  atomic_store_explicit(&nc_phase,1,memory_order_release);return;
+ }
+}
+void runtime_control_init(uintptr_t main){nc_main=main;}
+void runtime_control_start(void){
+ if(!nc_main||nc_socket>=0)return;
+ int fd=socket(AF_INET,SOCK_DGRAM,0);if(fd<0){perror("[totk-control] socket");return;}
+ struct sockaddr_in address={.sin_family=AF_INET,.sin_port=htons(CONTROL_PORT)};address.sin_addr.s_addr=htonl(INADDR_LOOPBACK);
+ if(fcntl(fd,F_SETFL,O_NONBLOCK)<0||bind(fd,(struct sockaddr *)&address,sizeof address)<0){perror("[totk-control] bind/nonblocking (one runtime per port)");close(fd);return;}
+ nc_socket=fd;fprintf(stderr,"[totk-control] native TKC1 listening on 127.0.0.1:%d\n",CONTROL_PORT);
+}
