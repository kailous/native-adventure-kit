diff --git a/games/totk/scripts/check_repository.py b/games/totk/scripts/check_repository.py
new file mode 100644
index 0000000000000000000000000000000000000000..52c9ffedc70f19358213692b18d71421568de785
--- /dev/null
+++ b/games/totk/scripts/check_repository.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Standalone, read-only source/output boundary check. Requires no game inputs."""
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+FORBIDDEN = ('.sav', '.keys', '.xci', '.nsp', '.nca', '.nsz', '.xcz', '.pem', '.key', '.totkpack')
+
+
+def file_digest(path):
+    h = hashlib.sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            h.update(block)
+    return h.hexdigest()
+
+
+def check(root, policy):
+    errors = []
+    for path in root.iterdir():
+        if path.name not in policy['rootEntries']:
+            errors.append(f'Unregistered native root entry: {path.name}')
+    for name in policy['generatedDirectories']:
+        folder = root / name
+        if folder.is_symlink():
+            errors.append(f'Generated source directory must not be a symlink: {name}')
+            continue
+        if not folder.exists():
+            continue
+        if (name not in policy['legacyDirectories']
+                and not any(p.startswith(name + '/') for p in policy['legacyArtifacts'])
+                and not any(p.startswith(name + '/') for p in policy['runtimeStateDirectories'])):
+            errors.append(f'Generated directory recreated inside native source: {name}')
+        # Never descend into directory links, including links to large external caches.
+        def visit(path):
+            relative = path.relative_to(root).as_posix()
+            if relative in policy['runtimeStateDirectories']:
+                if path.is_symlink() or not path.is_dir():
+                    errors.append(f'Runtime state must be a real directory: {relative}')
+                return
+            if path.is_symlink():
+                errors.append(f'Generated-content link in source: {relative}')
+            elif path.is_dir():
+                if relative not in policy['legacyDirectories'] and relative not in policy['generatedDirectories']:
+                    errors.append(f'New generated directory inside native source: {relative}')
+                for child in path.iterdir():
+                    visit(child)
+            elif path.is_file():
+                expected = policy['legacyArtifacts'].get(relative)
+                if not expected:
+                    errors.append(f'New generated artifact inside native source: {relative}')
+                elif file_digest(path) != expected['sha256']:
+                    errors.append(f'Legacy generated artifact overwritten: {relative}')
+        visit(folder)
+    # Inputs belong outside this checkout even when Git ignores them.
+    frozen_roots = set(policy['generatedDirectories'])
+    for folder, directories, files in os.walk(root, followlinks=False):
+        relative = Path(folder).relative_to(root)
+        directories[:] = [name for name in directories
+                          if name not in ('.git', '.venv', '__pycache__')
+                          and (relative / name).as_posix() not in frozen_roots]
+        for name in directories + files:
+            path = relative / name
+            if name.lower().endswith(FORBIDDEN) or name.endswith('.app'):
+                errors.append(f'User/build input inside native source: {path.as_posix()}')
+    result = subprocess.run(['git', '-C', str(root), 'ls-files', '-z'], check=True, capture_output=True)
+    for name in filter(None, result.stdout.decode().split('\0')):
+        parts = PurePosixPath(name).parts
+        if name.lower().endswith(FORBIDDEN) or any(p.endswith('.app') for p in parts):
+            errors.append(f'Forbidden tracked user/build input: {name}')
+    return errors
+
+
+def main():
+    policy = json.loads((ROOT / 'repository-policy.json').read_text(encoding='utf-8'))
+    if policy.get('schemaVersion') != 1:
+        raise ValueError('Unsupported native policy schema')
+    errors = check(ROOT, policy)
+    for error in errors:
+        print('ERROR:', error)
+    print(f'Native repository: {len(errors)} policy violation(s); {len(policy["legacyArtifacts"])} legacy artifact exception(s)')
+    return 1 if errors else 0
+
+
+if __name__ == '__main__':
+    try:
+        sys.exit(main())
+    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as exc:
+        print(f'ERROR: native policy check incomplete: {exc}', file=sys.stderr)
+        sys.exit(2)
