+  assert([hud.label.stringValue containsString:@"New shaders 3"]);
+  assert([hud.label.stringValue containsString:@"GPU 43% (31%)"]);
+  assert([hud.label.stringValue containsString:@"New render pipelines 2"]);
+  assert(NSMinX(hud.frame)>=0&&NSMinY(hud.frame)>=0);
+  assert(NSMaxX(hud.frame)<=512&&NSMaxY(hud.frame)<=288);
+  assert(NSWidth(hud.frame)<=236&&NSHeight(hud.frame)<268);
+ }
+ for(unsigned key=18;key<=23;key++){
