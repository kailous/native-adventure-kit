+/* AppKit menu entry; no game save or reward edits. */
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+#include "amiibo_catalog.h"
+@interface TOTKAmiiboPicker:NSObject
+-(void)scan:(id)sender;
+@end
+@implementation TOTKAmiiboPicker
+-(void)scan:(id)sender{
+ (void)sender;
+ NSAlert *a=[NSAlert new];a.messageText=@"扫描虚拟 amiibo";
+ a.informativeText=@"先在游戏选项中启用 amiibo，再使用 amiibo 能力。选择一个角色后扫描；奖励和每日次数由游戏决定。";
+ [a addButtonWithTitle:@"扫描"];[a addButtonWithTitle:@"取消"];[a addButtonWithTitle:@"导入文件…"];
+ NSPopUpButton *list=[[NSPopUpButton alloc] initWithFrame:NSMakeRect(0,0,310,28) pullsDown:NO];
+ for(unsigned i=0;i<sizeof amiibo_catalog/sizeof *amiibo_catalog;i++)[list addItemWithTitle:[NSString stringWithUTF8String:TOTK_UI(amiibo_catalog[i].name_cn,amiibo_catalog[i].name)]];
+ a.accessoryView=list;NSInteger choice=[a runModal];if(choice==NSAlertSecondButtonReturn)return;
+ NSString *model=nil,*uid=nil;
+ if(choice==NSAlertFirstButtonReturn){model=[NSString stringWithUTF8String:amiibo_catalog[list.indexOfSelectedItem].id];}
+ else{
+  NSOpenPanel *p=[NSOpenPanel openPanel];p.title=@"选择 amiibo JSON 或标签 BIN 文件";p.allowedContentTypes=@[UTTypeJSON,UTTypeData];p.allowsMultipleSelection=NO;
+  if([p runModal]!=NSModalResponseOK)return;NSData *data=[NSData dataWithContentsOfURL:p.URL];
+  if([p.URL.pathExtension.lowercaseString isEqualToString:@"json"]){
+   id root=data?[NSJSONSerialization JSONObjectWithData:data options:0 error:nil]:nil;
+   if([root isKindOfClass:NSDictionary.class]){id v=root[@"amiiboId"];if([v isKindOfClass:NSString.class])model=v;id u=root[@"uid"];if([u isKindOfClass:NSString.class])uid=u;}
+  }else if(data.length==532||data.length==540||data.length==572){
+   const uint8_t *b=data.bytes;NSMutableString *m=[NSMutableString new],*u=[NSMutableString new];for(unsigned i=0;i<8;i++)[m appendFormat:@"%02x",b[0x54+i]];const unsigned offsets[]={0,1,2,4,5,6,7};for(unsigned i=0;i<7;i++)[u appendFormat:@"%02x",b[offsets[i]]];model=m;uid=u;
+  }
+ }
+ if(model.length==16&&!uid)uid=[@"04" stringByAppendingString:[model substringToIndex:12]];
+ BOOL ok=model&&uid&&runtime_nfp_scan(model.UTF8String,uid.UTF8String);
+ NSAlert *result=[NSAlert new];result.messageText=ok?@"虚拟 amiibo 已准备好":@"无法扫描此 amiibo";
+ result.informativeText=ok?@"请在游戏中使用 amiibo 能力。当前已在等待扫描时，会立即识别。":@"请结束当前扫描后再试。JSON 需包含 amiiboId（16 位十六进制），uid 可选（14 位）；BIN 需为 532、540 或 572 字节的标签文件。";[result runModal];
+}
+@end
+static TOTKAmiiboPicker *amiiboPicker;
