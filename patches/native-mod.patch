+        int n=fscanf(f,"%u %u %u %u %u %u %u %u %u %u",&version,&r,&q,&full,&interp,&fps,&shaders,&load,&aspect,&smoothing);
+        if(n>=4&&version>=1&&version<=3&&r<4&&q<2&&full<2){
+            display_resolution=r;display_quality=q;display_fullscreen=full;
