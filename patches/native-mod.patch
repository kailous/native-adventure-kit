+ fps_overlay_set_enabled(0);tick(hud);
+ if(hud_compact())assert(![hud.label.stringValue containsString:@"FPS 60"]);
+ fps_overlay_set_enabled(1);load_enabled=0;tick(hud);
+ if(hud_compact())assert(![hud.label.stringValue containsString:@"GPU 43%"]);
