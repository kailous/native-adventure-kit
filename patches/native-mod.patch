@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* WorldManager::setWeather, called only by runtime_control_frame.
+   Both verified versions: mutex +0x20, buffer index +0x2380,
+   buffer base +0x940, stride 0xd20, weather request +0xcd8. */
+#pragma once
+typedef void (*NWSetter)(void *,uint32_t,uint32_t);
+static uintptr_t nw_manager;static uint64_t nw_tick;static int nw_last=-1;static bool nw_locked;
+#ifdef NATIVE_CONTROL_TEST
+static NWSetter nw_test_setter;
+#endif
+static bool nw_type(unsigned type){return type<=3||type==6||type==7||type==10;}
+static NWSetter nw_entry(void){
+ if(!CONTROL_WEATHER_SUPPORTED)return NULL;
+#ifdef NATIVE_CONTROL_TEST
+ if(nw_test_setter)return nw_test_setter;
+#endif
+ const uint32_t expected[]={0xa9bd7bfd,0xa90157f6,0xa9024ff4,0x910003fd};
+ uint32_t actual[4];uintptr_t address=nc_field(nc_main,CONTROL_WEATHER_ENTRY);
+ if(!nc_read(address,actual,sizeof actual)||memcmp(actual,expected,sizeof actual))return NULL;
+ return (NWSetter)address;
+}
+static uintptr_t nw_world(bool ready){
+ if(!ready||!CONTROL_WEATHER_SUPPORTED||!nw_entry())return 0;
+ uintptr_t world=nc_follow(nc_main,CONTROL_WEATHER_SLOT);unsigned index=2;
+ if(!runtime_guest_writable(world,0x2384)||!nc_read(nc_field(world,0x2380),&index,4)||index>1)return 0;
+#ifndef NATIVE_CONTROL_TEST
+ const Module *m=runtime_module_info("main");uintptr_t vtable=nc_ptr(world),fn=nc_ptr(vtable);
+ if(!m||vtable<nc_main+m->ro_off||vtable>=nc_main+m->key_off||fn<nc_main||fn>=nc_main+m->text_end)return 0;
+#endif
+ return world;
+}
+static int nw_readback(uintptr_t world){
+ unsigned index=2;int32_t value=-1;
+ if(!world||!nc_read(nc_field(world,0x2380),&index,4)||index>1||!nc_read(nc_field(world,0x1618+index*0xd20),&value,4))return -1;
+ return value;
+}
+static void nw_clear(void){nw_manager=0;nw_tick=0;nw_last=-1;nw_locked=false;}
+static bool nw_set(uintptr_t world,unsigned type,unsigned immediate,uint64_t now){
+ NWSetter setter=nw_entry();if(!world||!setter||!nw_type(type))return false;
+ setter((void *)world,type,immediate);
+ /* Only acknowledge after observing the engine's requested-weather field. */
+ if(nw_readback(world)!=(int)type)return false;
+ nw_manager=world;nw_last=(int)type;nw_tick=now;return true;
+}
+static void nw_frame(bool ready,uint64_t now){
+ uintptr_t world=nw_world(ready);
+ if(!world||world!=nw_manager){nw_clear();nw_manager=world;}
+ if(nw_locked&&(now<nw_tick||now-nw_tick>=1000000000ULL)&&!nw_set(world,(unsigned)nw_last,0,now))nw_clear();
+}
+static int nw_execute(bool ready,const NCRequest *request,uint64_t now){
+ if(!CONTROL_WEATHER_SUPPORTED)return 4;
+ if(request->value!=0||request->mode>1)return 2;
+ if(request->op==25&&!request->mode){if(request->target)return 2;nw_locked=false;return 0;}
+ if(!request->mode||!nw_type(request->target))return 2;
+ uintptr_t world=nw_world(ready);if(!world)return 1;
+ if(!nw_set(world,request->target,1,now))return 1;
+ if(request->op==25)nw_locked=true;
+ return 0;
+}
