--- /dev/null
+++ b/games/totk/runtime/nfp_virtual.h
@@ -0,0 +1,43 @@
+/* One virtual NFC reader. ABI layouts/state values checked against libnx nfc.h.
+ * Host UI queues public model/UID data; only NFP calls touch guest buffers. */
+#include <stdlib.h>
+#include <stdint.h>
+#define NFP_DEVICE_NOT_FOUND 0x8073u
+#define NFP_INVALID_STATE 0x1773u
+static pthread_mutex_t nfp_lock=PTHREAD_MUTEX_INITIALIZER;
+static int nfp_state,nfp_device,nfp_pending;
+static unsigned nfp_mount_target;
+static uint8_t nfp_model[0x40],nfp_uid[7];
+static void *nfp_activate,*nfp_deactivate;
+static const uint64_t nfp_handle=0x544f544b00000001ULL;
+static int nfp_valid(const void *h){uint64_t v=0;if(h)memcpy(&v,h,8);return v==nfp_handle;}
+static int nfp_hex(const char *s,size_t n,uint8_t *out){
+    if(!s||strlen(s)!=n*2)return 0;
+    for(size_t i=0;i<n;i++){unsigned v=0;for(unsigned j=0;j<2;j++){unsigned char c=s[2*i+j];unsigned x=c>='0'&&c<='9'?c-'0':c>='a'&&c<='f'?c-'a'+10:c>='A'&&c<='F'?c-'A'+10:255;if(x>15)return 0;v=v*16+x;}out[i]=(uint8_t)v;}return 1;
+}
+int runtime_nfp_scan(const char *id,const char *uid){
+    uint8_t raw[8],serial[7];if(!nfp_hex(id,8,raw)||!nfp_hex(uid,7,serial))return 0;
+    pthread_mutex_lock(&nfp_lock);
+    if(nfp_device==2||nfp_device==4||nfp_pending){pthread_mutex_unlock(&nfp_lock);return 0;}
+    memset(nfp_model,0,sizeof nfp_model);memcpy(nfp_model,raw,3);nfp_model[3]=raw[6];memcpy(nfp_model+4,raw+4,2);nfp_model[6]=raw[3];memcpy(nfp_uid,serial,7);nfp_pending=1;
+    if(nfp_state&&nfp_device==1){nfp_device=2;nfp_pending=0;if(nfp_activate)hle_try_signal_system_event(nfp_activate);}
+    pthread_mutex_unlock(&nfp_lock);fprintf(stderr,"[totk-nfp] virtual tag queued: %s\n",id);return 1;
+}
+static unsigned nfp_initialize(void){pthread_mutex_lock(&nfp_lock);nfp_state=1;nfp_device=0;nfp_mount_target=0;pthread_mutex_unlock(&nfp_lock);return 0;}
+static unsigned nfp_finalize(void){pthread_mutex_lock(&nfp_lock);nfp_state=0;nfp_device=0;nfp_pending=0;nfp_mount_target=0;nfp_activate=nfp_deactivate=NULL;pthread_mutex_unlock(&nfp_lock);return 0;}
+static int nfp_get_state(void){pthread_mutex_lock(&nfp_lock);int s=nfp_state;pthread_mutex_unlock(&nfp_lock);return s;}
+static unsigned nfp_list(void *handles,int *count,int max){if(!count||max<0||(!handles&&max))return NFP_INVALID_STATE;pthread_mutex_lock(&nfp_lock);int ready=nfp_state;pthread_mutex_unlock(&nfp_lock);*count=ready&&max?1:0;if(*count)memcpy(handles,&nfp_handle,8);return ready?0:NFP_INVALID_STATE;}
+static unsigned nfp_attach_availability(void *event){if(!event)return NFP_INVALID_STATE;hle_bind_system_event(event,1);return 0;}
+/* SDK 1.4.3 AttachActivateEvent/AttachDeactivateEvent attach with EventClearMode=1 (auto-clear), not libnx Event wrapper defaults. */
+static unsigned nfp_attach_activate(void *event,const void *h){if(!event||!nfp_valid(h))return NFP_DEVICE_NOT_FOUND;hle_bind_system_event(event,1);pthread_mutex_lock(&nfp_lock);nfp_activate=event;if(nfp_device==2)hle_try_signal_system_event(event);pthread_mutex_unlock(&nfp_lock);return 0;}
+static unsigned nfp_attach_deactivate(void *event,const void *h){if(!event||!nfp_valid(h))return NFP_DEVICE_NOT_FOUND;hle_bind_system_event(event,1);pthread_mutex_lock(&nfp_lock);nfp_deactivate=event;pthread_mutex_unlock(&nfp_lock);return 0;}
+static int nfp_device_state(const void *h){pthread_mutex_lock(&nfp_lock);int s=nfp_state&&nfp_valid(h)?nfp_device:5;pthread_mutex_unlock(&nfp_lock);return s;}
+static unsigned nfp_start(const void *h){pthread_mutex_lock(&nfp_lock);unsigned r=0;if(!nfp_state||!nfp_valid(h))r=NFP_DEVICE_NOT_FOUND;else if(nfp_device!=0&&nfp_device!=3)r=NFP_INVALID_STATE;else{nfp_device=nfp_pending?2:1;nfp_pending=0;if(nfp_device==2&&nfp_activate)hle_try_signal_system_event(nfp_activate);}pthread_mutex_unlock(&nfp_lock);fprintf(stderr,"[totk-nfp] start detection: %#x\n",r);return r;}
+static unsigned nfp_stop(const void *h){pthread_mutex_lock(&nfp_lock);unsigned r=nfp_state&&nfp_valid(h)?0:NFP_DEVICE_NOT_FOUND;if(!r){if((nfp_device==2||nfp_device==4)&&nfp_deactivate)hle_try_signal_system_event(nfp_deactivate);nfp_device=0;nfp_mount_target=0;}pthread_mutex_unlock(&nfp_lock);return r;}
+static unsigned nfp_mount(const void *h,unsigned type,unsigned target){pthread_mutex_lock(&nfp_lock);unsigned r=nfp_valid(h)&&nfp_device==2&&type==0&&(target&3)&&!(target&~3u)?0:NFP_INVALID_STATE;if(!r){if(nfp_device==2)nfp_mount_target=0;nfp_device=4;nfp_mount_target|=target;}pthread_mutex_unlock(&nfp_lock);fprintf(stderr,"[totk-nfp] mount type=%u target=%u: %#x\n",type,target,r);return r;}
+static unsigned nfp_unmount(const void *h){pthread_mutex_lock(&nfp_lock);unsigned r=nfp_valid(h)&&nfp_device==4?0:NFP_INVALID_STATE;if(!r){nfp_device=2;nfp_mount_target=0;}pthread_mutex_unlock(&nfp_lock);return r;}
+static unsigned nfp_npad(void *out,const void *h){if(!out||!nfp_valid(h))return NFP_DEVICE_NOT_FOUND;uint32_t id=0;memcpy(out,&id,4);return 0;}
+static unsigned nfp_tag(void *out,const void *h){pthread_mutex_lock(&nfp_lock);unsigned r=out&&nfp_valid(h)&&(nfp_device==2||nfp_device==4)?0:NFP_INVALID_STATE;if(!r){uint8_t b[0x58]={0};memcpy(b,nfp_uid,7);b[10]=7;uint32_t protocol=1,kind=2;memcpy(b+0x20,&protocol,4);memcpy(b+0x24,&kind,4);memcpy(out,b,sizeof b);}pthread_mutex_unlock(&nfp_lock);return r;}
+static unsigned nfp_model_info(void *out,const void *h){pthread_mutex_lock(&nfp_lock);unsigned r=out&&nfp_valid(h)&&nfp_device==4&&(nfp_mount_target&1)?0:NFP_INVALID_STATE;if(!r)memcpy(out,nfp_model,sizeof nfp_model);pthread_mutex_unlock(&nfp_lock);fprintf(stderr,"[totk-nfp] model info: %#x\n",r);return r;}
+
+void runtime_nfp_status_json(char *out,size_t size){pthread_mutex_lock(&nfp_lock);snprintf(out,size,"{\"available\":true,\"initialized\":%s,\"deviceState\":%d,\"queued\":%s}",nfp_state?"true":"false",nfp_device,nfp_pending?"true":"false");pthread_mutex_unlock(&nfp_lock);}
diff --git a/games/totk/runtime/player_state.h b/games/totk/runtime/player_state.h
new file mode 100644
index 0000000000000000000000000000000000000000..6112dcb9811480f995e4ad0634e9d11ef432dc8f
--- /dev/null
+++ b/games/totk/runtime/player_state.h
@@ -0,0 +1,69 @@
+/* Shared, read-only player lookup. No hooks, writes, cached Actor pointers or HP dependency. */
+#pragma once
+#include "game_version.h"
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <math.h>
+#include "mach_vm_compat.h"
+
+typedef struct { float position[3], rotation[9]; } RuntimePlayerState;
+static inline int runtime_player_read(uintptr_t address, void *out, size_t size) {
+    if (!address || !size || address > UINTPTR_MAX - size) return 0;
+    mach_vm_size_t got = 0;
+    return mach_vm_read_overwrite(mach_task_self(), address, size, (uintptr_t)out, &got) == KERN_SUCCESS && got == size;
+}
+static inline uintptr_t runtime_player_ptr(uintptr_t address) {
+    uintptr_t p = 0; return runtime_player_read(address, &p, sizeof p) ? p : 0;
+}
+static inline int runtime_player_valid_xyz(const float xyz[3]) {
+    return isfinite(xyz[0]) && isfinite(xyz[1]) && isfinite(xyz[2]) &&
+           fabsf(xyz[0]) <= 5500 && xyz[1] >= -1500 && xyz[1] <= 3500 && fabsf(xyz[2]) <= 5000;
+}
+static inline uintptr_t runtime_player_actor(uintptr_t main) {
+    if (!main) return 0;
+    uintptr_t module = runtime_player_ptr(main + GAME_ADDR(0x4663f08));
+    uintptr_t scene = module ? runtime_player_ptr(module + 0x1e8) : 0;
+    int count = 0;
+    if (!scene || !runtime_player_read(scene + 0x50, &count, 4) || count < 14 || count > 256) return 0;
+    uintptr_t components = runtime_player_ptr(scene + 0x58);
+    uintptr_t resident = components ? runtime_player_ptr(components + 13 * 8) : 0;
+    if (!resident || !runtime_player_read(resident + 0x20, &count, 4) || count < 1 || count > 64) return 0;
+    uintptr_t links = runtime_player_ptr(resident + 0x28);
+    for (int i = 0; links && i < count; ++i) {
+        uintptr_t data = runtime_player_ptr(links + (uintptr_t)i * 0x70 + 8);
+        uintptr_t actor = data ? runtime_player_ptr(data + 0x40) : 0;
+        uintptr_t name = actor ? runtime_player_ptr(actor + GAME_ACTOR_NAME) : 0;
+        char text[7]; float xyz[3];
+        if (name && runtime_player_read(name, text, sizeof text) && !memcmp(text, "Player", 7) &&
+            runtime_player_read(actor + GAME_ACTOR_POS, xyz, sizeof xyz) && runtime_player_valid_xyz(xyz)) return actor;
+    }
+    return 0;
+}
+static inline int runtime_player_sample(uintptr_t main, RuntimePlayerState *out) {
+    memset(out, 0, sizeof *out);
+    uintptr_t actor = runtime_player_actor(main);
+    if (!actor) return 0;
+    /* Position and rotation are adjacent in the versioned Actor layout. Copy
+       both in one kernel read; game-frame scheduling further reduces tearing. */
+    _Static_assert(GAME_ACTOR_ROT == GAME_ACTOR_POS + 12, "contiguous player transform");
+    RuntimePlayerState sample;
+    if (!runtime_player_read(actor + GAME_ACTOR_POS, &sample, sizeof sample) ||
+        !runtime_player_valid_xyz(sample.position)) return 0;
+    for (int i = 0; i < 9; ++i)
+        if (!isfinite(sample.rotation[i]) || fabsf(sample.rotation[i]) > 1.1f) return 0;
+    for (int row = 0; row < 3; ++row) {
+        float norm = 0;
+        for (int j = 0; j < 3; ++j) norm += sample.rotation[row*3+j] * sample.rotation[row*3+j];
+        if (fabsf(norm - 1) > .05f) return 0;
+        for (int other = row + 1; other < 3; ++other) {
+            float dot = 0;
+            for (int j = 0; j < 3; ++j) dot += sample.rotation[row*3+j] * sample.rotation[other*3+j];
+            if (fabsf(dot) > .05f) return 0;
+        }
+    }
+    const float *r = sample.rotation;
+    float determinant = r[0]*(r[4]*r[8]-r[5]*r[7]) - r[1]*(r[3]*r[8]-r[5]*r[6]) + r[2]*(r[3]*r[7]-r[4]*r[6]);
+    if (fabsf(determinant - 1) > .1f) return 0;
+    *out = sample; return 1;
+}
diff --git a/games/totk/runtime/pouch_control.h b/games/totk/runtime/pouch_control.h
