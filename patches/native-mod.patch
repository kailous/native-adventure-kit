+/* Apply production v143 code patches to a private local image for instruction
+ * emulation. No guest entry, graphics, services, or user saves are executed. */
+#include "runtime.h"
+#include "game_patches.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <string.h>
+#include "../../runtime/game_patches_v143.c"
+_Noreturn void runtime_fail(const char *s){fprintf(stderr,"%s\n",s);exit(1);}
+int mfxup_output_enabled(void){return 0;}
+void runtime_oe_push_message(uint32_t m){(void)m;}
+void dm_gfx_set_flag(const char *s,int v){(void)s;(void)v;}
+void runtime_survey_init(Module *m){(void)m;}
+/* UI/host seams are not exercised by the ARM64 timing fixture. */
+void *runtime_symbol(const char *name){(void)name;return 0;}
+void *runtime_hle_wrap_named(void *fn,const char *name){(void)name;return fn;}
+void dm_guest_write_prepare(void *p,size_t n){(void)p;(void)n;}
+int runtime_controller_layout_get(void){return 0;}
+int runtime_controller_layout_set(unsigned n){(void)n;return 0;}
+void runtime_front_request_close(void){}
+void runtime_front_set_fullscreen(int on){(void)on;}
+void fps_overlay_set_enabled(int on){(void)on;}
+void fps_overlay_set_hints_enabled(int on){(void)on;}
+void shader_overlay_set_enabled(int on){(void)on;}
+void sysload_set_enabled(int on){(void)on;}
+void taa_set_enabled(int on){(void)on;}
+int main(int argc,char **argv){
+ if(argc!=4)return 2;
+ FILE *f=fopen(argv[1],"rb");struct stat st;
+ if(!f||fstat(fileno(f),&st))return 2;
+ size_t data=((size_t)st.st_size+0x3fff)&~(size_t)0x3fff,size=data+0x4000;
+ unsigned char *base=mmap(NULL,size,PROT_READ|PROT_WRITE,MAP_ANON|MAP_PRIVATE,-1,0);
+ if(base==MAP_FAILED||fread(base,1,(size_t)st.st_size,f)!=(size_t)st.st_size)return 2;fclose(f);
+ Module m={.name="main",.base=base,.file_size=(size_t)st.st_size,.size=size,.text_end=strtoull(argv[3],NULL,0)};
+ /* Exercise production timing/fade emitters without the unrelated display GOT hooks. */
+ patch_realtime(&m);patch_output_res(&m);patch_render_res(&m);patch_fixed_res(&m);
+ patch_slowmo_bounce(&m);patch_fade_increment(&m);
+ for(unsigned i=0;i<sizeof fps60/sizeof *fps60;i++){
+  uint32_t word;memcpy(&word,m.base+fps60[i].off,4);
+  if(word!=fps60[i].original)runtime_fail("timing fixture FPS guard");
+  memcpy(m.base+fps60[i].off,&fps60[i].replacement,4);
+ }
+ runtime_frame_step_pin(10.0);
+ float values[3];memcpy(values,base+data,sizeof values);
+ printf("{\"pin\":[%.9g,%.9g,%.9g]",values[0],values[1],values[2]);
+ runtime_frame_step_pin(0);runtime_frame_step_update(1000000000ULL);runtime_frame_step_update(1025000000ULL);
+ memcpy(values,base+data,sizeof values);printf(",\"sample\":[%.9g,%.9g,%.9g]}\n",values[0],values[1],values[2]);
+ f=fopen(argv[2],"wb");if(!f||fwrite(base,1,size,f)!=size||fclose(f))return 2;
+ munmap(base,size);return 0;
+}
