+ setenv("TOTK_RUMBLE","0",1);setenv("TOTK_GYRO","0",1);
+ int(*none)(void *,int,const uint32_t *,uint32_t)=runtime_input_override(getV);uint32_t hs[2]={0xdead,0xbeef},pid=0;
