@@ -0,0 +1,143 @@
+"""Read-only native v143 animation resource inventory; outputs stay external."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import struct
+
+SOURCE = Path(__file__).resolve().parents[4]
+PATHS = (
+    'AS/Player.root.asb.zs',
+    'Model/Player_Animation.anim.bfres.zs',
+    'Model/Player_Demo_Animation.anim.bfres.zs',
+    'Model/Player_Animation.Skeleton.bfres.mc',
+    'AnimationEvent/AsNode/Player.root.baev.zs',
+    'AnimationEvent/Animation/Player_Animation.anim.baev.zs',
+    'Pack/Actor/Player.pack.zs',
+)
+MAX_RESOURCE = 128 * 1024 * 1024
+
+
+def external_output(output, source=SOURCE, input_root=None):
+    output, source = Path(output).resolve(), Path(source).resolve()
+    if output == source or source in output.parents:
+        raise ValueError('Output must be outside the native source checkout')
+    if input_root is not None:
+        input_root = Path(input_root).resolve()
+        if output == input_root or input_root in output.parents:
+            raise ValueError('Output must not be inside the read-only input directory')
+    return output
+
+
+def read_resource(image, entry, image_size):
+    offset, size = entry['offset'], entry['size']
+    if type(offset) is not int or type(size) is not int or not 0 <= offset <= image_size:
+        raise ValueError('Invalid resource range')
+    if not 0 < size <= MAX_RESOURCE or size > image_size - offset:
+        raise ValueError('Resource range exceeds image or research limit')
+    image.seek(offset)
+    data = image.read(size)
+    if len(data) != size:
+        raise ValueError('Truncated resource')
+    return data
+
+
+def sarc_members(data):
+    if len(data) < 32 or data[:4] != b'SARC' or data[6:8] != b'\xff\xfe':
+        raise ValueError('Unsupported SARC')
+    header, size, start = struct.unpack_from('<HxxII', data, 4)
+    if size != len(data) or not 0 <= header <= len(data) - 12:
+        raise ValueError('Invalid SARC size/header')
+    if data[header:header + 4] != b'SFAT':
+        raise ValueError('Missing SFAT')
+    count = struct.unpack_from('<H', data, header + 6)[0]
+    names = header + 12 + count * 16
+    if names + 8 > start or start > len(data) or data[names:names + 4] != b'SFNT':
+        raise ValueError('Invalid SARC table')
+    names += 8
+    result = {}
+    for i in range(count):
+        _, attr, lo, hi = struct.unpack_from('<4I', data, header + 12 + i * 16)
+        pos = names + (attr & 0xffffff) * 4
+        if attr >> 24 != 1 or not names <= pos < start or not 0 <= lo <= hi <= len(data) - start:
+            raise ValueError('Invalid SARC member')
+        end = data.find(b'\0', pos, start)
+        if end < 0:
+            raise ValueError('Unterminated SARC name')
+        name = data[pos:end].decode('utf-8')
+        if name in result:
+            raise ValueError('Duplicate SARC member')
+        result[name] = data[start + lo:start + hi]
+    return result
+
+
+def inventory(romfs, output, samples=False):
+    import compression.zstd as zstd
+    romfs = Path(romfs).resolve()
+    if romfs.name != 'romfs' or romfs.parent.name != 'v143':
+        raise ValueError('Expected the native v143/romfs input directory')
+    output = external_output(output, input_root=romfs)
+    index_path = romfs / 'index.json'
+    manifest = json.loads(index_path.read_text())
+    if manifest.get('status') != 'pass':
+        raise ValueError('Input index has not passed extraction validation')
+    files = {row['path']: row for row in manifest['files']}
+    image_path = romfs / 'romfs.bin'
+    image_size = image_path.stat().st_size
+    if image_size != manifest['romfs_size']:
+        raise ValueError('Image size does not match validated index')
+    output.mkdir(parents=True, exist_ok=True)
+    result = {'scope': 'offline inventory only; no playback or game modification',
+              'index_sha256': hashlib.sha256(index_path.read_bytes()).hexdigest(),
+              'game_version': '1.4.3', 'resources': []}
+    with image_path.open('rb') as image:
+        def read(path):
+            return read_resource(image, files[path], image_size)
+        dictionaries = {}
+        for blob in sarc_members(zstd.decompress(read('Pack/ZsDic.pack.zs'))).values():
+            dictionary = zstd.ZstdDict(blob)
+            dictionaries[dictionary.dict_id] = dictionary
+        for path in PATHS:
+            if path not in files:
+                result['resources'].append({'path': path, 'present': False})
+                continue
+            raw = read(path)
+            row = {'path': path, 'present': True, 'stored_bytes': len(raw),
+                   'sha256': hashlib.sha256(raw).hexdigest()}
+            data = raw
+            if path.endswith('.zs'):
+                info = zstd.get_frame_info(raw)
+                if info.decompressed_size is None or not 0 < info.decompressed_size <= MAX_RESOURCE:
+                    raise ValueError('Unknown/oversized compressed resource')
+                data = zstd.decompress(raw, zstd_dict=dictionaries.get(info.dictionary_id))
+                if len(data) != info.decompressed_size:
+                    raise ValueError('Decompressed resource length mismatch')
+            strings = sorted(set(s.decode() for s in re.findall(rb'[A-Za-z_][A-Za-z0-9_./-]{3,100}', data)))
+            row.update(decoded_bytes=len(data), magic_hex=data[:16].hex(),
+                       fska_magic_occurrences=data.count(b'FSKA'),
+                       dance_candidate_strings=[s for s in strings if re.search('dance|cheer|happy|joy', s, re.I)])
+            if data[:4] == b'SARC':
+                row['dance_candidate_members'] = [name for name, value in sarc_members(data).items() if b'Dance' in value]
+            if samples and (path.endswith('.asb.zs') or path.endswith('.baev.zs') or path.endswith('.Skeleton.bfres.mc')):
+                target = output / 'samples' / path.removesuffix('.zs')
+                target.parent.mkdir(parents=True, exist_ok=True)
+                target.write_bytes(data)
+                row['sample'] = str(target.relative_to(output))
+            result['resources'].append(row)
+    (output / 'inventory.json').write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n')
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--romfs', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--samples', action='store_true')
+    args = parser.parse_args()
+    result = inventory(args.romfs, args.output, args.samples)
+    print(json.dumps({'resources': len(result['resources']), 'output': str(args.output)}))
+
+
+if __name__ == '__main__':
+    main()
