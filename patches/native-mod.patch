new file mode 100644
index 0000000000000000000000000000000000000000..77abbcefe6df038f168a93af695a96644092da3b
--- /dev/null
+++ b/games/totk/tests/test_probe_paths.py
@@ -0,0 +1,46 @@
+"""Standalone probes must keep generated content outside the source tree."""
+import importlib.util
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location('probe_paths', ROOT / 'scripts/probe_paths.py')
+paths = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(paths)
+
+
+class ProbePathTests(unittest.TestCase):
+    def test_external_paths_with_spaces(self):
+        with tempfile.TemporaryDirectory(prefix='totk host paths ') as tmp:
+            with patch.dict(os.environ, {'TOTK_TEST_WORK': tmp, 'TOTK_TEST_INPUT': tmp}):
+                binary = paths.probe_binary('account-probe')
+                report = paths.probe_report('nested/result.json')
+                self.assertTrue(binary.parent.is_dir())
+                self.assertTrue(report.parent.is_dir())
+                self.assertEqual(paths.probe_input(), Path(tmp).resolve())
+
+    def test_reject_source_outputs_and_inputs(self):
+        for variable, function in [('TOTK_TEST_WORK', paths.probe_work), ('TOTK_TEST_INPUT', paths.probe_input)]:
+            with patch.dict(os.environ, {variable: str(ROOT / 'build/new-test')}):
+                with self.assertRaises(ValueError):
+                    function()
+
+    def test_make_targets_accept_spaces(self):
+        with tempfile.TemporaryDirectory(prefix='totk make paths ') as tmp:
+            result = subprocess.run(['make', '-n', 'probe-thread', 'probe-input',
+                                     'probe-autoload', 'probe-movie', 'probe-texture-auto-layout',
+                                     'probe-depth16-clear', f'HOST_TEST_WORK={tmp}',
+                                     f'RENDER_PROBE_DIR={tmp}/rendering'], cwd=ROOT,
+                                    text=True, capture_output=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(result.stderr, '')
+            self.assertIn('runtime/virtual_input.c', result.stdout)
+            self.assertIn(f'"{tmp}/host-tests/input-probe"', result.stdout)
+
+
+if __name__ == '__main__':
+    unittest.main()
