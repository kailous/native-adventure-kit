diff --git a/games/totk/scripts/settings_menu_data.py b/games/totk/scripts/settings_menu_data.py
new file mode 100644
index 0000000000000000000000000000000000000000..39eb8d7824706de652807fc7a51159bea1e11a81
--- /dev/null
+++ b/games/totk/scripts/settings_menu_data.py
@@ -0,0 +1,392 @@
+"""Guarded TOTK 1.4.3 option-table and message additions; no save-file writes."""
+import struct, sys
+
+def find_sections(b):
+    pos, out = 0x20, []
+    count = struct.unpack_from('<H', b, 0x0e)[0]
+    while True:
+        tag = b[pos:pos+4]
+        if tag not in (b'LBL1', b'ATR1', b'TXT2', b'TSY1', b'PAT1'):
+            break
+        size = struct.unpack_from('<I', b, pos+4)[0]
+        out.append((pos, tag, size))
+        pos = (pos + 16 + size + 15) & ~15
+        if len(out) >= count:
+            break
+    return out
+
+def parse_lbl1(b):
+    p = next(p for p, t, s in find_sections(b) if t == b'LBL1')
+    size = struct.unpack_from('<I', b, p+4)[0]
+    data = p + 0x10
+    groups = struct.unpack_from('<I', b, data)[0]
+    table = []
+    for g in range(groups):
+        n, off = struct.unpack_from('<II', b, data + 4 + g*8)
+        go = data + off
+        labels = []
+        for _ in range(n):
+            ln = b[go]
+            name = b[go+1:go+1+ln].decode()
+            idx = struct.unpack_from('<I', b, go+1+ln)[0]
+            labels.append((name, idx))
+            go += 1 + ln + 4
+        table.append(labels)
+    return groups, table, size
+
+def parse_txt2(b):
+    p = next(p for p, t, s in find_sections(b) if t == b'TXT2')
+    size = struct.unpack_from('<I', b, p+4)[0]
+    data = p + 0x10
+    n = struct.unpack_from('<I', b, data)[0]
+    offs = struct.unpack_from('<%dI' % n, b, data+4)
+    raws = []
+    for i in range(n):
+        end = offs[i+1] if i+1 < n else size
+        raws.append(b[data+offs[i]:data+end])
+    return n, raws, size
+
+def utf16_text(raw):
+    text = raw.decode('utf-16-le')
+    return text.split('\0')[0]
+
+def label_hash(name):
+    h = 0
+    for c in name.encode('ascii'):
+        h = (h * 0x492 + c) & 0xffffffff
+    return h
+
+def rebuild(b, extra):
+    groups, table, _ = parse_lbl1(b)
+    n, raws, _ = parse_txt2(b)
+    # extra: [(label, text)]
+    new_strings = []
+    for label, text in extra:
+        idx = n + len(new_strings)
+        new_strings.append((label, text, idx))
+        table[label_hash(label) % groups].append((label, idx))
+    # TXT2
+    strbytes = list(raws)
+    for label, text, idx in new_strings:
+        strbytes.append(text.encode('utf-16-le') + b'\0\0')
+    count = len(strbytes)
+    header = 4 + count * 4
+    offs = []
+    pos = header
+    for s in strbytes:
+        offs.append(pos); pos += len(s)
+    payload = struct.pack('<I', count) + struct.pack('<%dI' % count, *offs) + b''.join(strbytes)
+    # LBL1
+    gdata = []
+    for labels in table:
+        blob = bytearray()
+        for name, idx in labels:
+            nb = name.encode('ascii')
+            blob += bytes([len(nb)]) + nb + struct.pack('<I', idx)
+        gdata.append(bytes(blob))
+    gtable = bytearray(struct.pack('<I', groups))
+    off = 4 + groups * 8
+    for labels, blob in zip(table, gdata):
+        gtable += struct.pack('<II', len(labels), off)
+        off += len(blob)
+    lbl1 = bytes(gtable) + b''.join(gdata)
+    # assemble
+    out = bytearray(b[:0x20])
+    pos = 0x20
+    secs = [(b'LBL1', lbl1), (b'TXT2', payload)]
+    for tag, data in secs:
+        sec = bytearray(tag + struct.pack('<I', len(data)) + b'\0'*8 + data)
+        out += sec
+        pos += len(sec)
+        pad = (-pos) & 15
+        out += b'\0' * pad
+        pos += pad
+    struct.pack_into('<I', out, 0x12, len(out))
+    return bytes(out)
+
+
+import struct, sys
+
+class Dict:
+    def __init__(self, pairs): self.pairs = pairs
+
+def cstr(b, off):
+    e = b.index(0, off); return b[off:e].decode()
+
+def parse_table(b):
+    assert b[:2] == b'YB' and struct.unpack_from('<H', b, 2)[0] == 7
+    kt, st, root = struct.unpack_from('<III', b, 4)
+    nk = struct.unpack_from('<I', b, kt)[0] >> 8
+    koffs = struct.unpack_from('<%dI' % nk, b, kt+4)
+    keys = [cstr(b, kt+o) for o in koffs]
+    ns = struct.unpack_from('<I', b, st)[0] >> 8
+    soffs = struct.unpack_from('<%dI' % ns, b, st+4)
+    strings = [cstr(b, st+o) for o in soffs]
+    def val(t, v):
+        if t == 0xA0: return strings[v]
+        if t == 0xD0: return v
+        if t == 0xC0:
+            h = struct.unpack_from('<I', b, v)[0]; n = h >> 8; et = h & 0xff
+            assert et == 0xC0, hex(et)
+            types = b[v+4:v+4+n]
+            vals = struct.unpack_from('<%dI' % n, b, v+4+((n+3)//4)*4)
+            return [val(types[i], vals[i]) for i in range(n)]
+        if t == 0xC1:
+            h = struct.unpack_from('<I', b, v)[0]; n = h >> 8
+            pairs = []
+            for i in range(n):
+                p = v+4+8*i; kw = struct.unpack_from('<I', b, p)[0]
+                pairs.append((keys[kw & 0xffffff], (kw >> 24) & 0xff, val((kw >> 24) & 0xff, struct.unpack_from('<I', b, p+4)[0])))
+            return Dict(pairs)
+        raise ValueError(hex(t))
+    h = struct.unpack_from('<I', b, root)[0]; n = h >> 8
+    assert h & 0xff == 0xC1
+    rootpairs = []
+    for i in range(n):
+        p = root+4+8*i; kw = struct.unpack_from('<I', b, p)[0]
+        rootpairs.append((keys[kw & 0xffffff], (kw >> 24) & 0xff, val((kw >> 24) & 0xff, struct.unpack_from('<I', b, p+4)[0])))
+    return Dict(rootpairs), strings, keys
+
+def build(root, strings, keys):
+    key_index = {k: i for i, k in enumerate(keys)}
+    str_index = {s: i for i, s in enumerate(strings)}
+    # string table
+    sh = struct.pack('<I', (len(strings) << 8) | 0xC2)
+    off = 4 + len(strings)*4 + 4
+    soff = []
+    for s in strings:
+        soff.append(off); off += len(s.encode()) + 1
+    st_data = sh + struct.pack('<%dI' % len(strings), *soff) + struct.pack('<I', off)
+    for s in strings:
+        st_data += s.encode() + b'\0'
+    st_data += b'\0' * ((-len(st_data)) & 7)
+    # key table
+    kh = struct.pack('<I', (len(keys) << 8) | 0xC2)
+    off = 4 + len(keys)*4 + 4
+    koff = []
+    for k in keys:
+        koff.append(off); off += len(k.encode()) + 1
+    kt_data = kh + struct.pack('<%dI' % len(keys), *koff) + struct.pack('<I', off)
+    for k in keys:
+        kt_data += k.encode() + b'\0'
+    kt_data += b'\0' * ((-len(kt_data)) & 7)
+    header = bytearray(16)
+    header[:2] = b'YB'; struct.pack_into('<H', header, 2, 7)
+    kt_off = 0x10
+    st_off = kt_off + len(kt_data)
+    root_off = st_off + len(st_data)
+    struct.pack_into('<III', header, 4, kt_off, st_off, root_off)
+    node_base = root_off
+    # nodes
+    nodes = bytearray()
+    def write(obj, type_hint=None):
+        if isinstance(obj, str):
+            return 0xA0, str_index[obj]
+        if isinstance(obj, int):
+            return 0xD0, obj
+        if isinstance(obj, Dict):
+            at = node_base + len(nodes)
+            nodes.extend(struct.pack('<I', (len(obj.pairs) << 8) | 0xC1))
+            entries = []
+            for k, t, v in obj.pairs:
+                assert k in key_index, k
+                pos = len(nodes); nodes.extend(b'\0\0\0\0\0\0\0\0'); entries.append((pos, k, t, v))
+            for pos, k, t, v in entries:
+                if t == 0xC1:
+                    ct, cv = write(v)
+                    assert ct == 0xC1
+                elif t == 0xC0:
+                    ct, cv = write(v)
+                    assert ct == 0xC0
+                elif t == 0xA0:
+                    cv = str_index[v]
+                elif t == 0xD0:
+                    cv = v
+                else:
+                    raise ValueError(hex(t))
+                struct.pack_into('<I', nodes, pos, key_index[k] | (t << 24))
+                struct.pack_into('<I', nodes, pos+4, cv)
+            return 0xC1, at
+        if isinstance(obj, list):
+            at = node_base + len(nodes)
+            n = len(obj)
+            nodes.extend(struct.pack('<I', (n << 8) | 0xC0))
+            etypes = bytearray()
+            for x in obj: etypes.append(0xA0 if isinstance(x, str) else 0xC1)
+            etypes.extend(b'\0' * ((-len(etypes)) & 3))
+            nodes.extend(etypes)
+            positions = []
+            for x in obj:
+                positions.append(len(nodes)); nodes.extend(b'\0\0\0\0')
+            for pos, x in zip(positions, obj):
+                t, v = write(x)
+                struct.pack_into('<I', nodes, pos, v)
+            return 0xC0, at
+        raise TypeError(type(obj))
+    write(root)
+    out = bytes(header) + kt_data + st_data + bytes(nodes)
+    return out
+
+
+def sarc_parts(data):
+    hs, fs, do = struct.unpack_from('<HxxII', data, 4)
+    assert data[:4] == b'SARC' and data[6:8] == b'\xff\xfe'
+    sfat = hs
+    count = struct.unpack_from('<H', data, sfat+6)[0]
+    sfnt = sfat + 12 + count*16
+    assert data[sfnt:sfnt+4] == b'SFNT'
+    return hs, fs, do, sfat, count, sfnt+8
+
+def member_name(data, sfnt, node):
+    attr = struct.unpack_from('<I', data, node+4)[0]
+    off = sfnt + (attr & 0xffffff)*4
+    return data[off:data.index(0, off)].decode()
+
+def members(data):
+    hs, fs, do, sfat, count, names = sarc_parts(data)
+    out = {}
+    for i in range(count):
+        node = sfat + 12 + i*16
+        name = member_name(data, names, node)
+        lo, hi = struct.unpack_from('<II', data, node+8)
+        out[name] = (do+lo, do+hi)
+    return out
+
+def append_replace(data, target, newbytes, align=0x10):
+    hs, fs, do, sfat, count, names = sarc_parts(data)
+    for i in range(count):
+        node = sfat + 12 + i*16
+        if member_name(data, names, node) != target:
+            continue
+        old_lo, old_hi = struct.unpack_from('<II', data, node+8)
+        out = bytearray(data)
+        if len(out) % align:
+            out += b'\0' * (align - len(out) % align)
+        start = len(out) - do
+        out += newbytes
+        struct.pack_into('<II', out, node+8, start, start+len(newbytes))
+        struct.pack_into('<I', out, 8, len(out))
+        return bytes(out), (old_lo, old_hi, start, start+len(newbytes))
+    raise KeyError(target)
+
+
+# Keep four contiguous groups, separated by the game's three existing Separator rows.
+# IDs and message labels remain unchanged; only row order changes.
+SETTINGS_GROUPS = (
+    ('controls', ('__amiibo__','NativeControllerLayout','IsChangeJumpButton','IsCameraUpDownReverse','IsCameraRightLeftReverse','CameraRotateSpeed','IsUseGyro','IsSpecialPowerRotateUpDownReverse','IsSpecialPowerRotateRightLeftReverse')),
+    ('picture', ('IsControlStickUpDownReverse','NativeRenderResolution','NativePictureMode','NativeAspect','NativeSmoothing','NativeInterpolation')),
+    ('interface', ('DisplayMode','IsLockMiniMapUpper','NativeShowFPS','NativeShowShaders','NativeShowLoad')),
+    ('language_other', ('VoiceLanguage','IsDisplayTextRuby','MessageWindowTransparency')),
+)
+
+def sort_settings_rows(rows):
+    separators=[]; options={}
+    for row in rows:
+        values={key:value for key,kind,value in row.pairs}
+        if values.get('ButtonType')=='Separator':
+            separators.append(row); continue
+        name=values.get('OptionType')
+        if name is None:
+            assert values.get('ChoiceType')==['UseAmiibo','UnuseAmiibo']
+            name='__amiibo__'
+        assert name not in options, name
+        options[name]=row
+    ordered=[name for _,names in SETTINGS_GROUPS for name in names]
+    assert len(separators)==len(SETTINGS_GROUPS)-1
+    assert len(ordered)==len(set(ordered)) and set(ordered)==set(options)
+    result=[]
+    for index,(_,names) in enumerate(SETTINGS_GROUPS):
+        if index:result.append(separators[index-1])
+        result.extend(options[name] for name in names)
+    assert len(result)==len(rows)
+    assert result[0] is rows[0], 'keep the original Amiibo action anchored first'
+    return result
+
+def add_fullscreen_row(data):
+    root, strings, keys = parse_table(data)
+    assert len(root.pairs) == 1 and root.pairs[0][0] == 'OptionSetArray'
+    rows = root.pairs[0][2]
+    assert len(rows) == 16
+    assert dict((k, v) for k, t, v in rows[12].pairs)['OptionType'] == 'DisplayMode'
+    assert 'IsControlStickUpDownReverse' not in strings
+    original = [r.pairs for r in rows]
+    strings.extend(['IsControlStickUpDownReverse','NativeRenderResolution','NativePictureMode','Native720p','Native1080p','Native1440p','Native2160p','NativeMetalFX','NativeRendering','NativeInterpolation','NativeShowFPS','NativeShowShaders','NativeShowLoad','NativeInterpOff','NativeInterp30','NativeInterpHalf','NativeInterpMax','NativeAspect','NativeSmoothing','NativeAspectGame','NativeAspectFit','NativeAspectWide','NativeControllerLayout','NativeLayoutCustom','NativeLayoutSwitch','NativeLayoutXbox'])
+    strings.sort()
+    rows.insert(13, Dict([('ButtonType', 0xA0, 'Toggle'), ('OptionType', 0xA0, 'IsControlStickUpDownReverse')]))
+    rows.insert(14, Dict([('ButtonType', 0xA0, 'Selection'), ('ChoiceType', 0xC0, ['Native720p','Native1080p','Native1440p','Native2160p']), ('OptionType', 0xA0, 'NativeRenderResolution')]))
+    rows.insert(15, Dict([('ButtonType', 0xA0, 'Selection'), ('ChoiceType', 0xC0, ['NativeMetalFX','NativeRendering']), ('OptionType', 0xA0, 'NativePictureMode')]))
+    rows.insert(16, Dict([('ButtonType', 0xA0, 'Selection'), ('ChoiceType', 0xC0, ['NativeInterpOff','NativeInterp30','NativeInterpHalf','NativeInterpMax']), ('OptionType', 0xA0, 'NativeInterpolation')]))
+    for offset, name in enumerate(['NativeShowFPS','NativeShowShaders','NativeShowLoad']):
+        rows.insert(17+offset, Dict([('ButtonType', 0xA0, 'Toggle'), ('OptionType', 0xA0, name)]))
+    rows.insert(20, Dict([('ButtonType',0xA0,'Selection'),('ChoiceType',0xC0,['NativeAspectGame','NativeAspectFit','NativeAspectWide']),('OptionType',0xA0,'NativeAspect')]))
+    rows.insert(21, Dict([('ButtonType',0xA0,'Toggle'),('OptionType',0xA0,'NativeSmoothing')]))
+    rows.insert(22, Dict([('ButtonType',0xA0,'Selection'),('ChoiceType',0xC0,['NativeLayoutCustom','NativeLayoutSwitch','NativeLayoutXbox']),('OptionType',0xA0,'NativeControllerLayout')]))
+    rows[:] = sort_settings_rows(rows)
+    out = build(root, strings, keys)
+    checked, _, _ = parse_table(out)
+    newrows = checked.pairs[0][2]
+    assert len(newrows) == 26
+    from collections import Counter
+    before=Counter(repr(pairs) for pairs in original)
+    after=Counter(repr(row.pairs) for row in newrows)
+    assert not (before-after), 'original option values, conditions or separators changed'
+    return out
+
+def add_fullscreen_labels(data, name, description, lang="EUen"):
+    assert data[:8] == b'MsgStdBn'
+    assert struct.unpack_from('<I', data, 0x12)[0] == len(data)
+    assert [t for p, t, n in find_sections(data)] == [b'LBL1', b'TXT2']
+    assert struct.unpack_from('<H', data, 0x0e)[0] == 2
+    _, oldgroups, _ = parse_lbl1(data)
+    labels = {label: index for group in oldgroups for label, index in group}
+    assert len(labels) == 56 and not {'1006', '0006'} & labels.keys()
+    localized = {
+        'CNzh': ('渲染分辨率','独立选择渲染分辨率，全屏时保持此设置。','画质模式','选择 MetalFX 超分或原生渲染。','原生渲染'),
+        'TWzh': ('算繪解析度','獨立選擇算繪解析度，全螢幕時維持此設定。','畫質模式','選擇 MetalFX 超解析度或原生算繪。','原生算繪'),
+        'JPja': ('描画解像度','全画面でも選択した描画解像度を維持します。','画質モード','MetalFX またはネイティブ描画を選びます。','ネイティブ'),
