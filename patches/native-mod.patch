+"""Asset-free title animation structure and version guard regressions."""
+from pathlib import Path
+import struct
+import sys
+import unittest
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'games/totk/scripts'))
+from title_menu_data import add_exit_animation,add_exit_sequence
+
+class TitleMenu(unittest.TestCase):
+    def test_wrong_sequence_is_rejected(self):
+        with self.assertRaisesRegex(AssertionError,'unrecognized'):
+            add_exit_sequence(b'other version')
+
+    def test_exit_follows_original_row_count(self):
+        objects=[]
+        for i in range(6):
+            entry=f'Pa_Button_{i:02d}'.encode().ljust(28,b'\0')+bytes([1,0,0,0])+struct.pack('<I',36)
+            track=b'FLVI'+bytes([1,0,0,0])+struct.pack('<I',12)
+            track+=struct.pack('<BBBBHHI',0,0,1,0,2,0,12)
+            track+=struct.pack('<fHHfHH',i,0,0,i+1,1,0)
+            objects.append(entry+track)
+        section=bytearray(b'pai1'+struct.pack('<I',500)+struct.pack('<fBBHI',6,0,0,6,20))
+        section+=struct.pack('<6I',*[44+76*i for i in range(6)])+b''.join(objects)
+        original=b'FLAN\xff\xfe'+struct.pack('<HIIHH',20,0x08000000,520,1,0)+section
+        result=add_exit_animation(original)
+        self.assertEqual(struct.unpack_from('<I',result,12)[0],len(result))
+        self.assertEqual(result[64:64+76*5],original[64:64+76*5])
+        pane=64+76*5
+        self.assertEqual(result[pane+28],2)
+        visible=struct.unpack_from('<I',result,pane+32)[0]+pane
+        self.assertEqual(struct.unpack_from('<fHH',result,visible+24),(0,1,0))
+        transform=struct.unpack_from('<I',result,pane+36)[0]+pane
+        self.assertEqual(result[transform:transform+4],b'FLPA')
+        self.assertEqual(result[transform+13],1)
+        start,y0,slope,end,y1,_=struct.unpack_from('<6f',result,transform+24)
+        self.assertEqual((start,end,y1),(0,6,-362.5))
+        for count in (2,4,5):self.assertEqual(y0+count*slope,-32.5-55*count)
+
+if __name__=='__main__':unittest.main()
