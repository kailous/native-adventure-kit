@@ -0,0 +1,66 @@
+/* Real phone protocol + existing fusion; synthetic data, no game/GPU. */
+#define PHONE_MOTION_PORT 0
+#include "../games/totk/runtime/motion_fusion.c"
+#include "../games/totk/runtime/phone_motion.h"
+#include <assert.h>
+#include <mach/mach_time.h>
+static uint64_t now_ns=1000000000ULL;
+static int realtime;
+uint64_t runtime_now_ns(void){
+ if(!realtime)return now_ns;
+ mach_timebase_info_data_t tb;mach_timebase_info(&tb);return (uint64_t)((__uint128_t)mach_absolute_time()*tb.numer/tb.denom);
+}
+void runtime_fail(const char *message){fprintf(stderr,"%s\n",message);abort();}
+int runtime_gyro_enabled(void){return 1;}
+void runtime_hid_feedback_stats(uint64_t *values,uint64_t *reads){*values=0;*reads=0;}
+static PMRequest request(uint8_t op,uint64_t session,uint64_t sequence){
+ PMRequest p={.magic={'T','P','M','1'},.version=1,.op=op,.session=session,.sequence=sequence,.sent_ns=now_ns,.acc={0,0,-1},.gyro={0,0,0}};return p;
+}
+static int accept_request(PMRequest *p){PMRequest decoded;return pm_accept(p,sizeof *p,now_ns,&decoded);}
+int main(int argc,char **argv){
+ (void)argv;
+ if(argc>1){
+  realtime=1;runtime_phone_motion_start();assert(pm_socket>=0);
+  struct sockaddr_in address={0};socklen_t length=sizeof address;assert(!getsockname(pm_socket,(struct sockaddr *)&address,&length));
+  printf("{\"port\":%d}\n",ntohs(address.sin_port));fflush(stdout);
+  for(unsigned i=0;i<600;i++){runtime_phone_motion_tick(runtime_now_ns());usleep(5000);}
+  close(pm_socket);return 0;
+ }
+ const double acc[3]={0,0,-1},controller[3]={0,.5,0},phone[3]={1,0,0},mouse[3]={0,0,2};
+ RuntimeMotionState state;
+ runtime_motion_live(1);runtime_motion_feed(acc,controller,now_ns);assert(runtime_motion_read(&state,1)==1);
+ assert(fabs(state.gyro[1]-.5/(2*M_PI))<1e-6);
+ PMRequest p=request(1,7,1);p.gyro[0]=1;assert(accept_request(&p)==0);assert(runtime_motion_phone_selected());
+ now_ns+=16666667;runtime_motion_feed_phone(acc,phone,now_ns);assert(runtime_motion_read(&state,1)==1);
+ assert(fabs(state.gyro[0]-1/(2*M_PI))<1e-6);uint64_t sample=state.sampling;
+ runtime_motion_feed(acc,controller,now_ns);assert(runtime_motion_read(&state,1)==1&&state.sampling==sample);
+ runtime_motion_mouse(1);assert(!runtime_motion_phone_selected());runtime_motion_feed_phone(acc,phone,now_ns);
+ assert(runtime_motion_read(&state,1)==0);now_ns+=16666667;runtime_motion_feed_mouse(acc,mouse,now_ns);
+ assert(runtime_motion_read(&state,1)==1&&fabs(state.gyro[2]-2/(2*M_PI))<1e-6);
+ runtime_motion_mouse(0);assert(runtime_motion_phone_selected());
+ p=request(1,8,1);assert(accept_request(&p)==5); /* second phone cannot steal an active session */
+ p=request(1,7,1);assert(accept_request(&p)==3); /* duplicate/out-of-order */
+ p=request(1,7,2);p.gyro[0]=NAN;assert(accept_request(&p)==2);p.gyro[0]=36;assert(accept_request(&p)==2);
+ p=request(1,7,2);p.acc[0]=9;assert(accept_request(&p)==2);
+ p=request(1,7,2);p.sent_ns=now_ns-PM_EXPIRY_NS-1;assert(accept_request(&p)==3);
+ p=request(1,7,2);p.sent_ns=now_ns+1;assert(accept_request(&p)==3);
+ p=request(1,7,2);p.reserved=1;assert(accept_request(&p)==2);
+ p=request(1,7,2);PMRequest decoded;assert(pm_accept(&p,sizeof p-1,now_ns,&decoded)==2);
+ p=request(3,7,2);assert(accept_request(&p)==0);runtime_motion_feed_phone(acc,phone,now_ns);assert(runtime_motion_read(&state,1)==1);
+ for(unsigned axis=0;axis<3;axis++)assert(isfinite(state.angle[axis]));
+ now_ns+=PM_EXPIRY_NS+1;assert(!pm_fresh(now_ns));runtime_motion_phone(0);assert(!runtime_motion_phone_selected());
+ runtime_motion_feed(acc,controller,now_ns);assert(runtime_motion_read(&state,1)==1&&fabs(state.gyro[1]-.5/(2*M_PI))<1e-6);
+ p=request(1,8,1);assert(accept_request(&p)==0);p=request(2,8,2);assert(accept_request(&p)==0&&!pm_state.sample&&!runtime_motion_phone_selected());
+ p=request(1,8,1);assert(accept_request(&p)==3); /* stopped packets cannot replay */
+ runtime_motion_mouse(1);
+ { double a[3]={0,0,-1},g[3]={M_PI/2,0,0},pitch=0; float held[9];
+   for(int i=0;i<30;i++){pitch+=.01*M_PI/2;a[1]=-sin(pitch);a[2]=-cos(pitch);now_ns+=12000000;runtime_motion_feed_mouse(a,g,now_ns);}
+   g[0]=0;now_ns+=10000000;runtime_motion_feed_mouse(a,g,now_ns);assert(runtime_motion_read(&state,1)==1);memcpy(held,state.dir,sizeof held);
+   for(int i=0;i<300;i++){now_ns+=10000000;runtime_motion_feed_mouse(a,g,now_ns);}
+   assert(runtime_motion_read(&state,1)==1);
+   for(int i=0;i<9;i++)assert(fabs(state.dir[i]-held[i])<1e-4);
+   for(int i=0;i<3;i++)assert(fabs(state.acc[i]+state.dir[i*3+2])<1e-4);
+ }
+ runtime_motion_mouse(0);
+ puts("{\"status\":\"pass\",\"priority\":\"mouse > phone > controller\",\"expiryMs\":200}");return 0;
+}
